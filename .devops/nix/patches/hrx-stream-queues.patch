diff --git a/libhrx/src/binding/hip/api.c b/libhrx/src/binding/hip/api.c
index e0e2c836b5..a0217a25b1 100644
--- a/libhrx/src/binding/hip/api.c
+++ b/libhrx/src/binding/hip/api.c
@@ -12465,6 +12465,58 @@ HIPAPI hipError_t hipMemsetD32Async(hipDeviceptr_t dstDevice, int i, size_t N,
 //
 // See also: hipStreamCreateWithFlags, hipStreamCreateWithPriority,
 //           hipStreamDestroy, hipStreamSynchronize.
+// Spreads normal-priority user streams round-robin over a bounded pool of
+// hardware queues: the context queue plus up to three acquired ones
+// (HRX_STREAM_QUEUE_POOL overrides the total, 1-16). Independent streams can
+// then execute concurrently (hrx-system#2968). A queue per stream instead
+// keeps gfx1151 100% busy at idle once more than a handful are mapped.
+#include <pthread.h>
+#define HRX_STREAM_QUEUE_POOL_MAX 16
+static pthread_mutex_t hrx_stream_queue_pool_mutex = PTHREAD_MUTEX_INITIALIZER;
+static iree_hal_streaming_context_t* hrx_stream_queue_pool_context = NULL;
+static iree_hal_queue_t* hrx_stream_queue_pool[HRX_STREAM_QUEUE_POOL_MAX];
+static int hrx_stream_queue_pool_next = 0;
+
+static iree_status_t iree_hip_stream_create_on_pooled_queue(
+    iree_hal_streaming_context_t* context, unsigned int flags,
+    hipStream_t* stream) {
+  int size = 4;
+  const char* pool_env = getenv("HRX_STREAM_QUEUE_POOL");
+  if (pool_env && pool_env[0]) size = atoi(pool_env);
+  if (size < 1) size = 1;
+  if (size > HRX_STREAM_QUEUE_POOL_MAX) size = HRX_STREAM_QUEUE_POOL_MAX;
+  iree_hal_queue_t* queue = context->queue;
+  iree_status_t status = iree_ok_status();
+  pthread_mutex_lock(&hrx_stream_queue_pool_mutex);
+  if (hrx_stream_queue_pool_context != context) {
+    memset(hrx_stream_queue_pool, 0, sizeof(hrx_stream_queue_pool));
+    hrx_stream_queue_pool_context = context;
+    hrx_stream_queue_pool_next = 0;
+  }
+  const int slot = hrx_stream_queue_pool_next++ % size;
+  if (slot != 0) {
+    if (!hrx_stream_queue_pool[slot]) {
+      iree_hal_queue_params_t queue_params;
+      iree_hal_queue_params_initialize(&queue_params);
+      queue_params.placement = iree_hal_queue_placement(context->queue);
+      queue_params.priority = iree_hal_queue_priority(context->queue);
+      queue_params.features = iree_hal_queue_features(context->queue);
+      queue_params.execution_resources =
+          iree_hal_queue_execution_resources(context->queue);
+      status = iree_hal_queue_acquire(iree_hal_queue_family(context->queue),
+                                      &queue_params,
+                                      &hrx_stream_queue_pool[slot]);
+    }
+    if (iree_status_is_ok(status)) queue = hrx_stream_queue_pool[slot];
+  }
+  pthread_mutex_unlock(&hrx_stream_queue_pool_mutex);
+  if (iree_status_is_ok(status)) {
+    status = iree_hip_stream_create(context, queue, flags, /*priority=*/0,
+                                    iree_hal_semaphore_list_empty(), stream);
+  }
+  return status;
+}
+
 HIPAPI hipError_t hipStreamCreate(hipStream_t* stream) {
   HIP_API_BEGIN();
   HIP_DEBUG_LOG("[HIP_API] hipStreamCreate(stream=%p)\n", (void*)stream);
@@ -12482,9 +12534,8 @@ HIPAPI hipError_t hipStreamCreate(hipStream_t* stream) {
     HIP_RETURN_ERROR(init_result);
   }
 
-  iree_status_t status = iree_hip_stream_create(
-      context, context->queue, hipStreamDefault,
-      /*priority=*/0, iree_hal_semaphore_list_empty(), stream);
+  iree_status_t status = iree_hip_stream_create_on_pooled_queue(
+      context, hipStreamDefault, stream);
 
   hipError_t result = iree_status_to_hip_result(status);
   IREE_TRACE_ZONE_END(z0);
@@ -12551,9 +12602,8 @@ HIPAPI hipError_t hipStreamCreateWithFlags(hipStream_t* stream,
     HIP_RETURN_ERROR(init_result);
   }
 
-  iree_status_t status = iree_hip_stream_create(
-      context, context->queue, flags,
-      /*priority=*/0, iree_hal_semaphore_list_empty(), stream);
+  iree_status_t status =
+      iree_hip_stream_create_on_pooled_queue(context, flags, stream);
 
   hipError_t result = iree_status_to_hip_result(status);
   IREE_TRACE_ZONE_END(z0);
