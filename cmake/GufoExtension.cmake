include_guard(GLOBAL)
include(CMakeParseArguments)
include(${CMAKE_CURRENT_LIST_DIR}/GufoExtensionVersion.cmake)

# Production validation is pure CMake 3.21. Hosted checks additionally apply
# the complete JSON schema (including packaging/docs/CI-only metadata).
# Scan JSON escapes before string(JSON): CMake strings cannot represent NUL.
# Consume escaped backslashes in pairs so literal "\\u0000" stays ordinary text.
function(_gufo_reject_nul json)
  string(LENGTH "${json}" length)
  set(i 0)
  while(i LESS length)
    string(SUBSTRING "${json}" ${i} 1 character)
    if(character STREQUAL "\\")
      math(EXPR next "${i}+1")
      math(EXPR remaining "${length}-${next}")
      if(remaining GREATER_EQUAL 5)
        string(SUBSTRING "${json}" ${next} 5 escape)
        if(escape STREQUAL "u0000")
          message(FATAL_ERROR "extension metadata: U+0000 is not supported")
        endif()
      endif()
      math(EXPR i "${i}+2")
    else()
      math(EXPR i "${i}+1")
    endif()
  endwhile()
endfunction()

function(_gufo_json out json expected)
  string(JSON value ERROR_VARIABLE error TYPE "${json}" ${ARGN})
  if(error OR NOT value STREQUAL expected)
    string(JOIN "." field ${ARGN})
    message(FATAL_ERROR "extension metadata: ${field} must be ${expected} (${error})")
  endif()
  string(JSON value GET "${json}" ${ARGN})
  set(${out} "${value}" PARENT_SCOPE)
endfunction()
function(_gufo_optional out json field fallback)
  string(JSON type ERROR_VARIABLE error TYPE "${json}" "${field}")
  if(error)
    set(${out} "${fallback}" PARENT_SCOPE)
  else()
    string(JSON value GET "${json}" "${field}")
    set(${out} "${value}" PARENT_SCOPE)
  endif()
endfunction()
function(_gufo_strings out json)
  _gufo_json(array "${json}" ARRAY ${ARGN})
  string(JSON length LENGTH "${array}")
  set(values)
  if(length GREATER 0)
    math(EXPR last "${length}-1")
    foreach(i RANGE ${last})
      _gufo_json(value "${array}" STRING ${i})
      # Lists, generated C++ and symbol/property names must be inert data.
      if(value MATCHES "[;\n\r\\\"]" OR value STREQUAL "")
        message(FATAL_ERROR "extension metadata: invalid string ${value}")
      endif()
      if(value IN_LIST values)
        message(FATAL_ERROR "extension metadata: duplicate value ${value}")
      endif()
      list(APPEND values "${value}")
    endforeach()
  endif()
  set(${out} "${values}" PARENT_SCOPE)
endfunction()
function(_gufo_identifier value pattern description)
  if(NOT "${value}" MATCHES "${pattern}")
    message(FATAL_ERROR "extension metadata: invalid ${description}: ${value}")
  endif()
endfunction()
function(_gufo_entry_symbol symbol)
  set(keywords alignas alignof and and_eq asm atomic_cancel atomic_commit atomic_noexcept auto bitand bitor bool break case catch char char8_t char16_t char32_t class compl concept const consteval constexpr constinit const_cast continue co_await co_return co_yield decltype default delete do double dynamic_cast else enum explicit export extern false float for friend goto if inline int long mutable namespace new noexcept not not_eq nullptr operator or or_eq private protected public reflexpr register reinterpret_cast requires return short signed sizeof static static_assert static_cast struct switch synchronized template this thread_local throw true try typedef typeid typename union unsigned using virtual void volatile wchar_t while xor xor_eq)
  if(symbol IN_LIST keywords)
    message(FATAL_ERROR "extension metadata: reserved C++ entry symbol ${symbol}")
  endif()
  get_property(owner GLOBAL PROPERTY "GUFO_EXT_SYMBOL_${symbol}")
  if(owner)
    message(FATAL_ERROR "extension metadata: duplicate registration symbol ${symbol}")
  endif()
  set_property(GLOBAL PROPERTY "GUFO_EXT_SYMBOL_${symbol}" TRUE)
endfunction()
function(_gufo_target_enabled out requires role)
  set(enabled TRUE)
  foreach(condition IN LISTS requires)
    if(condition STREQUAL hip)
      if(NOT ENGINE_ENABLE_HIP)
        set(enabled FALSE)
      endif()
    elseif(condition STREQUAL testing)
      if(NOT BUILD_TESTING)
        set(enabled FALSE)
      endif()
    elseif(condition STREQUAL linux)
      if(NOT CMAKE_SYSTEM_NAME STREQUAL Linux)
        set(enabled FALSE)
      endif()
    elseif(condition STREQUAL windows)
      if(NOT CMAKE_SYSTEM_NAME STREQUAL Windows)
        set(enabled FALSE)
      endif()
    else()
      message(FATAL_ERROR "extension metadata: unknown target condition ${condition}")
    endif()
  endforeach()
  if(linux IN_LIST requires AND windows IN_LIST requires)
    message(FATAL_ERROR "extension metadata: unsatisfiable target conditions linux/windows")
  endif()
  if(role STREQUAL test AND NOT BUILD_TESTING)
    set(enabled FALSE)
  endif()
  set(${out} "${enabled}" PARENT_SCOPE)
endfunction()

# Register one explicitly selected manifest. Discovery/lock policy is separate.
function(gufo_extension)
  cmake_parse_arguments(ARG "" "MANIFEST" "" ${ARGN})
  if("${ARG_MANIFEST}" STREQUAL "" OR NOT "${ARG_UNPARSED_ARGUMENTS}" STREQUAL "")
    message(FATAL_ERROR "gufo_extension requires MANIFEST")
  endif()
  get_filename_component(manifest "${ARG_MANIFEST}" ABSOLUTE)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest}")
  file(READ "${manifest}" json)
  _gufo_reject_nul("${json}")
  _gufo_json(schema "${json}" NUMBER schema)
  if(NOT schema EQUAL 1)
    message(FATAL_ERROR "extension metadata: unsupported schema ${schema}")
  endif()
  _gufo_json(name "${json}" STRING name)
  _gufo_identifier("${name}" "^[a-z][a-z0-9_]*$" "extension name")
  get_property(names GLOBAL PROPERTY GUFO_EXTENSION_NAMES)
  if(name IN_LIST names)
    message(FATAL_ERROR "extension metadata: duplicate extension name ${name}")
  endif()
  _gufo_json(api "${json}" STRING api_version)
  if(NOT api MATCHES "^>= ([0-9]+)\\.([0-9]+)\\.([0-9]+)$")
    message(FATAL_ERROR "extension metadata: api_version must be >= MAJOR.MINOR.REVISION")
  endif()
  set(requested_major "${CMAKE_MATCH_1}")
  set(requested_minor "${CMAKE_MATCH_2}")
  set(requested_revision "${CMAKE_MATCH_3}")
  string(REPLACE "." ";" runtime_version "${GUFO_EXTENSION_API_VERSION}")
  list(GET runtime_version 0 runtime_major)
  list(GET runtime_version 1 runtime_minor)
  list(GET runtime_version 2 runtime_revision)
  if(NOT GUFO_EXTENSION_METADATA_ONLY AND
     (NOT requested_major STREQUAL runtime_major OR NOT requested_minor STREQUAL runtime_minor OR requested_revision GREATER runtime_revision))
    message(FATAL_ERROR "extension metadata: incompatible API version/revision ${api}; runtime ${GUFO_EXTENSION_API_VERSION}")
  endif()
  _gufo_json(version "${json}" STRING version)
  _gufo_identifier("${version}" "^[0-9]+\\.[0-9]+\\.[0-9]+([+-][A-Za-z0-9.-]+)?$" "extension version")
  _gufo_strings(depends "${json}" depends)
  foreach(dependency IN LISTS depends)
    _gufo_identifier("${dependency}" "^[a-z][a-z0-9_]*$" "dependency")
  endforeach()
  _gufo_strings(platforms "${json}" platforms)
  if("${platforms}" STREQUAL "")
    message(FATAL_ERROR "extension metadata: platforms cannot be empty")
  endif()
  foreach(platform IN LISTS platforms)
    if(NOT platform MATCHES "^(linux|windows)$")
      message(FATAL_ERROR "extension metadata: unsupported platform ${platform}")
    endif()
  endforeach()
  _gufo_optional(kind "${json}" kind extension)
  if(NOT kind MATCHES "^(extension|library)$")
    message(FATAL_ERROR "extension metadata: unknown kind ${kind}")
  endif()
  _gufo_json(targets "${json}" OBJECT targets)
  string(JSON count LENGTH "${targets}")
  if(count EQUAL 0)
    message(FATAL_ERROR "extension metadata: targets cannot be empty")
  endif()
  math(EXPR last "${count}-1")
  set(target_names)
  foreach(i RANGE ${last})
    string(JSON target MEMBER "${targets}" ${i})
    _gufo_identifier("${target}" "^[a-z][a-z0-9_]*$" "target name")
    get_property(owner GLOBAL PROPERTY "GUFO_EXT_TARGET_${target}_OWNER" SET)
    if(owner)
      get_property(owner GLOBAL PROPERTY "GUFO_EXT_TARGET_${target}_OWNER")
      message(FATAL_ERROR "extension metadata: duplicate target declaration ${target} (${owner}, ${name})")
    endif()
    _gufo_strings(requires "${targets}" "${target}" requires)
    string(JSON definition GET "${targets}" "${target}")
    _gufo_optional(role "${definition}" role library)
    if(NOT role MATCHES "^(library|test)$")
      message(FATAL_ERROR "extension metadata: invalid target role ${role}")
    endif()
    _gufo_target_enabled(enabled "${requires}" "${role}")
    # Conditions must be satisfiable on at least one declared platform.
    if((linux IN_LIST requires AND NOT linux IN_LIST platforms) OR
       (windows IN_LIST requires AND NOT windows IN_LIST platforms))
      message(FATAL_ERROR "extension metadata: unsatisfiable target/platform conditions for ${target}")
    endif()
    string(TOLOWER "${CMAKE_SYSTEM_NAME}" system)
    if(NOT system IN_LIST platforms)
      set(enabled FALSE)
    endif()
    foreach(field OWNER ENABLED REQUIRES ROLE)
      if(field STREQUAL OWNER)
        set(value "${name}")
      elseif(field STREQUAL ENABLED)
        set(value "${enabled}")
      elseif(field STREQUAL REQUIRES)
        set(value "${requires}")
      else()
        set(value "${role}")
      endif()
      set_property(GLOBAL PROPERTY "GUFO_EXT_TARGET_${target}_${field}" "${value}")
    endforeach()
    list(APPEND target_names "${target}")
  endforeach()
  if(kind STREQUAL extension)
    _gufo_json(entry "${json}" STRING entry)
    _gufo_identifier("${entry}" "^[A-Za-z_][A-Za-z0-9_]*$" "entry symbol")
    _gufo_entry_symbol("${entry}")
    _gufo_json(registration_target "${json}" STRING registration_target)
    if(NOT registration_target IN_LIST target_names)
      message(FATAL_ERROR "extension metadata: missing registration target ${registration_target}")
    endif()
    get_property(requires GLOBAL PROPERTY "GUFO_EXT_TARGET_${registration_target}_REQUIRES")
    get_property(role GLOBAL PROPERTY "GUFO_EXT_TARGET_${registration_target}_ROLE")
    if(NOT "${requires}" STREQUAL "" OR NOT role STREQUAL library)
      message(FATAL_ERROR "extension metadata: registration target must be an unconditional library")
    endif()
    _gufo_json(providers "${json}" ARRAY providers)
    string(JSON count LENGTH "${providers}")
    if(count EQUAL 0)
      message(FATAL_ERROR "extension metadata: providers cannot be empty")
    endif()
    math(EXPR last "${count}-1")
    set(provider_ids)
    set(provider_identifiers)
    foreach(i RANGE ${last})
      foreach(field id capability target entry)
        _gufo_json(${field} "${providers}" STRING ${i} ${field})
      endforeach()
      _gufo_identifier("${id}" "^[a-z][a-z0-9_-]*$" "provider ID")
      _gufo_identifier("${entry}" "^[A-Za-z_][A-Za-z0-9_]*$" "provider entry")
      _gufo_entry_symbol("${entry}")
      if(NOT capability MATCHES "^(text_generation|embeddings|speech_recognition|speech_synthesis|image_generation|video_generation|decision)$")
        message(FATAL_ERROR "extension metadata: unknown capability ${capability}")
      endif()
      get_property(owner GLOBAL PROPERTY "GUFO_EXT_PROVIDER_${id}" SET)
      if(owner)
        message(FATAL_ERROR "extension metadata: duplicate provider ID ${id}")
      endif()
      set_property(GLOBAL PROPERTY "GUFO_EXT_PROVIDER_${id}" "${name}")
      if(NOT target IN_LIST target_names)
        message(FATAL_ERROR "extension metadata: missing provider target ${target}")
      endif()
      get_property(role GLOBAL PROPERTY "GUFO_EXT_TARGET_${target}_ROLE")
      if(NOT role STREQUAL library)
        message(FATAL_ERROR "extension metadata: provider target must be a library")
      endif()
      _gufo_strings(keys "${providers}" ${i} keys)
      if("${keys}" STREQUAL "")
        message(FATAL_ERROR "extension metadata: provider keys cannot be empty")
      endif()
      foreach(key IN LISTS keys)
        if(NOT key MATCHES "^(gguf|safetensors|manifest|diffusers):.+$")
          message(FATAL_ERROR "extension metadata: unsupported artifact key ${key}")
        endif()
      endforeach()
      foreach(optional model_ids speculative)
        string(JSON ignored ERROR_VARIABLE error TYPE "${providers}" ${i} ${optional})
        if(NOT error)
          _gufo_strings(ignored "${providers}" ${i} ${optional})
        endif()
      endforeach()
      string(REPLACE "-" "_" identifier "${id}")
      if(identifier IN_LIST provider_identifiers)
        message(FATAL_ERROR "extension metadata: colliding generated provider identifier ${id}")
      endif()
      list(APPEND provider_identifiers "${identifier}")
      list(APPEND provider_ids "${id}")
    endforeach()
  else()
    foreach(field entry registration_target providers options)
      string(JSON ignored ERROR_VARIABLE error TYPE "${json}" ${field})
      if(NOT error AND NOT (field STREQUAL providers AND ignored STREQUAL ARRAY))
        message(FATAL_ERROR "extension metadata: library cannot declare ${field}")
      endif()
      if(NOT error AND field STREQUAL providers)
        string(JSON length LENGTH "${json}" providers)
        if(length GREATER 0)
          message(FATAL_ERROR "extension metadata: library cannot declare providers")
        endif()
      endif()
    endforeach()
  endif()
  file(STRINGS "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../include/gufo/ext/core_options.def" core_lines REGEX "^GUFO_CORE_OPTION")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../include/gufo/ext/core_options.def")
  string(JSON options_type ERROR_VARIABLE error TYPE "${json}" options)
  if(NOT error)
    _gufo_json(options "${json}" ARRAY options)
    string(JSON count LENGTH "${options}")
    if(count GREATER 0)
      math(EXPR last "${count}-1")
      set(local_options)
      foreach(i RANGE ${last})
        _gufo_json(option "${options}" STRING ${i} name)
        _gufo_identifier("${option}" "^--[a-z][a-z0-9-]*$" "option name")
        if("GUFO_CORE_OPTION(\"${option}\")" IN_LIST core_lines)
          message(FATAL_ERROR "extension metadata: core-owned option ${option}")
        endif()
        _gufo_json(type "${options}" STRING ${i} type)
        if(NOT type MATCHES "^(boolean|integer|number|string|path)$")
          message(FATAL_ERROR "extension metadata: invalid option type ${type}")
        endif()
        _gufo_strings(commands "${options}" ${i} commands)
        if("${commands}" STREQUAL "")
          message(FATAL_ERROR "extension metadata: option commands cannot be empty")
        endif()
        foreach(command IN LISTS commands)
          string(SHA256 key "${command}:${option}")
          get_property(previous GLOBAL PROPERTY "GUFO_EXT_OPTION_${key}")
          if(NOT "${previous}" STREQUAL "" AND NOT previous STREQUAL type)
            message(FATAL_ERROR "extension metadata: conflicting option types for ${option} in ${command}")
          endif()
          if(key IN_LIST local_options)
            message(FATAL_ERROR "extension metadata: duplicate option declaration ${option} in ${command}")
          endif()
          list(APPEND local_options "${key}")
          set_property(GLOBAL PROPERTY "GUFO_EXT_OPTION_${key}" "${type}")
        endforeach()
        string(JSON ignored ERROR_VARIABLE error TYPE "${options}" ${i} providers)
        if(NOT error)
          _gufo_strings(selected "${options}" ${i} providers)
          if("${selected}" STREQUAL "")
            message(FATAL_ERROR "extension metadata: option providers cannot be empty")
          endif()
          foreach(id IN LISTS selected)
            if(NOT id IN_LIST provider_ids)
              message(FATAL_ERROR "extension metadata: option references missing provider ${id}")
            endif()
          endforeach()
        endif()
      endforeach()
    endif()
  endif()
  # Serving metadata is additive; validate references before Nix consumes it.
  if(NOT kind STREQUAL library)
    string(JSON provider_count LENGTH "${json}" providers)
    math(EXPR provider_last "${provider_count}-1")
    foreach(i RANGE 0 ${provider_last})
      string(JSON serving_type ERROR_VARIABLE error TYPE "${json}" providers ${i} serving)
      if(error)
        continue()
      endif()
      _gufo_json(serving "${json}" OBJECT providers ${i} serving)
      string(JSON voice_type ERROR_VARIABLE error TYPE "${serving}" voices)
      if(NOT error)
        _gufo_json(voices "${serving}" BOOLEAN voices)
        _gufo_json(capability "${json}" STRING providers ${i} capability)
        if(voices AND NOT capability STREQUAL speech_synthesis)
          message(FATAL_ERROR "extension metadata: serving voices requires speech_synthesis")
        endif()
      endif()
      string(JSON hip_type ERROR_VARIABLE error TYPE "${serving}" hip)
      if(NOT error AND NOT hip_type STREQUAL BOOLEAN)
        message(FATAL_ERROR "extension metadata: serving hip must be a boolean")
      endif()
      # One queue below the device's eight-queue budget: a cap of N holds N + 1.
      string(JSON queue_type ERROR_VARIABLE error TYPE "${serving}" hardware_queues)
      if(NOT error)
        string(JSON queues GET "${serving}" hardware_queues)
        if(NOT queue_type STREQUAL NUMBER OR NOT queues MATCHES "^[1-7]$")
          message(FATAL_ERROR "extension metadata: serving hardware_queues must be an integer from 1 to 7")
        endif()
        _gufo_json(capability "${json}" STRING providers ${i} capability)
        if(NOT capability MATCHES "^speech_(synthesis|recognition)$")
          message(FATAL_ERROR "extension metadata: serving hardware_queues requires speech_synthesis or speech_recognition")
        endif()
      endif()
      string(JSON draft_type ERROR_VARIABLE error TYPE "${serving}" draft_options)
      if(error)
        continue()
      endif()
      _gufo_json(drafts "${serving}" OBJECT draft_options)
      _gufo_strings(modes "${json}" providers ${i} speculative)
      _gufo_json(provider_id "${json}" STRING providers ${i} id)
      string(JSON draft_count LENGTH "${drafts}")
      if(draft_count GREATER 0)
        math(EXPR draft_last "${draft_count}-1")
        foreach(j RANGE 0 ${draft_last})
          string(JSON mode MEMBER "${drafts}" ${j})
          if(NOT mode IN_LIST modes)
            message(FATAL_ERROR "extension metadata: serving draft mode is not advertised: ${mode}")
          endif()
          _gufo_json(flag "${drafts}" STRING ${mode})
          set(found FALSE)
          string(JSON option_count ERROR_VARIABLE error LENGTH "${json}" options)
          if(NOT error AND option_count GREATER 0)
            math(EXPR option_last "${option_count}-1")
            foreach(k RANGE 0 ${option_last})
              _gufo_json(option_name "${json}" STRING options ${k} name)
              _gufo_json(option_type "${json}" STRING options ${k} type)
              _gufo_strings(option_commands "${json}" options ${k} commands)
              string(JSON selected_type ERROR_VARIABLE error TYPE "${json}" options ${k} providers)
              if(error)
                set(option_providers "${provider_id}")
              else()
                _gufo_strings(option_providers "${json}" options ${k} providers)
              endif()
              if(option_name STREQUAL flag AND option_type STREQUAL path
                  AND provider_id IN_LIST option_providers
                  AND ("serve" IN_LIST option_commands OR "serve llm" IN_LIST option_commands))
                set(found TRUE)
              endif()
            endforeach()
          endif()
          if(NOT found)
            message(FATAL_ERROR "extension metadata: serving draft option must declare a provider-owned serve path: ${flag}")
          endif()
        endforeach()
      endif()
    endforeach()
  endif()
  get_filename_component(root "${manifest}" DIRECTORY)
  # Downloadable weights: `gufo model` validates the entries and trusts only
  # the generated lock beside the manifest (tools/models/lock.py).
  set(models_json "")
  string(JSON models_type ERROR_VARIABLE error TYPE "${json}" models)
  if(NOT error)
    if(NOT models_type STREQUAL ARRAY)
      message(FATAL_ERROR "extension metadata: models must be ARRAY")
    endif()
    if(kind STREQUAL library)
      message(FATAL_ERROR "extension metadata: library cannot declare models")
    endif()
    string(JSON models GET "${json}" models)
    set(lock "${root}/models.lock.json")
    if(EXISTS "${lock}")
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${lock}")
      file(READ "${lock}" lock_json)
      _gufo_reject_nul("${lock_json}")
      string(JSON lock_type ERROR_VARIABLE error TYPE "${lock_json}" models)
      if(error OR NOT lock_type STREQUAL OBJECT)
        message(FATAL_ERROR "extension metadata: ${lock} must hold a models object")
      endif()
    else()
      set(lock_json "null")
    endif()
    string(JSON models_json SET "{}" name "\"${name}\"")
    string(JSON models_json SET "${models_json}" version "\"${version}\"")
    string(JSON models_json SET "${models_json}" models "${models}")
    string(JSON models_json SET "${models_json}" lock "${lock_json}")
  endif()
  set_property(GLOBAL PROPERTY "GUFO_EXT_${name}_MODELS" "${models_json}")
  set_property(GLOBAL PROPERTY "GUFO_EXT_${name}_METADATA_ONLY" "${GUFO_EXTENSION_METADATA_ONLY}")
  set_property(GLOBAL APPEND PROPERTY GUFO_EXTENSION_NAMES "${name}")
  set_property(GLOBAL PROPERTY "GUFO_EXT_${name}_JSON" "${json}")
  set_property(GLOBAL PROPERTY "GUFO_EXT_${name}_ROOT" "${root}")
  set_property(GLOBAL PROPERTY "GUFO_EXT_${name}_DEPENDS" "${depends}")
  set_property(GLOBAL PROPERTY "GUFO_EXT_${name}_TARGETS" "${target_names}")
endfunction()

function(_gufo_visit name)
  get_property(metadata_only GLOBAL PROPERTY "GUFO_EXT_${name}_METADATA_ONLY")
  if(metadata_only)
    get_property(state GLOBAL PROPERTY "GUFO_EXT_${name}_VISIT")
    if(NOT state STREQUAL done)
      set_property(GLOBAL PROPERTY "GUFO_EXT_${name}_VISIT" done)
      set_property(GLOBAL APPEND PROPERTY GUFO_EXTENSION_ORDER "${name}")
    endif()
    return()
  endif()
  get_property(state GLOBAL PROPERTY "GUFO_EXT_${name}_VISIT")
  get_property(stack GLOBAL PROPERTY GUFO_EXTENSION_VISIT_STACK)
  if(state STREQUAL visiting)
    # Name the whole cycle, from its first member back to itself.
    list(FIND stack "${name}" start)
    list(SUBLIST stack ${start} -1 cycle)
    list(APPEND cycle "${name}")
    list(JOIN cycle " -> " path)
    message(FATAL_ERROR "extension metadata: cyclic dependency ${path}")
  elseif(state STREQUAL done)
    return()
  endif()
  set_property(GLOBAL PROPERTY "GUFO_EXT_${name}_VISIT" visiting)
  set_property(GLOBAL APPEND PROPERTY GUFO_EXTENSION_VISIT_STACK "${name}")
  get_property(names GLOBAL PROPERTY GUFO_EXTENSION_NAMES)
  get_property(depends GLOBAL PROPERTY "GUFO_EXT_${name}_DEPENDS")
  list(SORT depends)
  get_property(sdk GLOBAL PROPERTY GUFO_HOST_EXTENSIONS SET)
  get_property(hosts GLOBAL PROPERTY GUFO_HOST_EXTENSIONS)
  foreach(dependency IN LISTS depends)
    get_property(parent_json GLOBAL PROPERTY "GUFO_EXT_${name}_JSON")
    _gufo_strings(parent_platforms "${parent_json}" platforms)
    set(host FALSE)
    if(NOT dependency IN_LIST names AND dependency IN_LIST hosts)
      # Built into the gufo executable this SDK belongs to.
      set(host TRUE)
      get_property(dependency_platforms GLOBAL PROPERTY "GUFO_HOST_EXT_${dependency}_PLATFORMS")
    elseif(NOT dependency IN_LIST names AND sdk AND WIN32)
      message(FATAL_ERROR "extension metadata: ${name} depends on ${dependency}; Windows modules "
        "cannot have depends yet; build ${name} into gufo with GUFO_EXTENSION_DIRS instead")
    elseif(NOT dependency IN_LIST names AND sdk)
      message(FATAL_ERROR "extension metadata: missing dependency ${dependency} required by ${name}; "
        "the gufo this SDK belongs to does not build it in, and no extension of that name is in "
        "GUFO_EXTENSION_DIRS")
    elseif(NOT dependency IN_LIST names)
      message(FATAL_ERROR "extension metadata: missing dependency ${dependency} required by ${name}; "
        "no extension of that name is in src/models, src/families or GUFO_EXTENSION_DIRS")
    else()
      get_property(dependency_json GLOBAL PROPERTY "GUFO_EXT_${dependency}_JSON")
      _gufo_strings(dependency_platforms "${dependency_json}" platforms)
    endif()
    foreach(platform IN LISTS parent_platforms)
      if(NOT platform IN_LIST dependency_platforms)
        message(FATAL_ERROR "extension metadata: unsatisfiable dependency platforms: ${name} needs ${dependency} on ${platform}")
      endif()
    endforeach()
    if(NOT host)
      _gufo_visit("${dependency}")
    endif()
  endforeach()
  get_property(stack GLOBAL PROPERTY GUFO_EXTENSION_VISIT_STACK)
  list(POP_BACK stack)
  set_property(GLOBAL PROPERTY GUFO_EXTENSION_VISIT_STACK "${stack}")
  set_property(GLOBAL PROPERTY "GUFO_EXT_${name}_VISIT" done)
  set_property(GLOBAL APPEND PROPERTY GUFO_EXTENSION_ORDER "${name}")
endfunction()
# Orders GUFO_EXTENSION_ORDER dependency-first: every extension follows the
# extensions it depends on, ties broken by name. Discovery adds selected
# extensions in this order, in-tree and external alike.
function(gufo_extensions_validate)
  get_property(names GLOBAL PROPERTY GUFO_EXTENSION_NAMES)
  set_property(GLOBAL PROPERTY GUFO_EXTENSION_ORDER "")
  set_property(GLOBAL PROPERTY GUFO_EXTENSION_VISIT_STACK "")
  foreach(name IN LISTS names)
    set_property(GLOBAL PROPERTY "GUFO_EXT_${name}_VISIT" "")
  endforeach()
  list(SORT names)
  foreach(name IN LISTS names)
    _gufo_visit("${name}")
  endforeach()
endfunction()

# Build manifests call this once for each declared target. Disabled targets do
# not exist and cannot leak factory references through generated registration.
function(gufo_extension_target)
  cmake_parse_arguments(ARG "" "NAME" "SOURCES;LINK_LIBRARIES" ${ARGN})
  get_property(owner GLOBAL PROPERTY "GUFO_EXT_TARGET_${ARG_NAME}_OWNER" SET)
  if(NOT owner OR NOT "${ARG_UNPARSED_ARGUMENTS}" STREQUAL "")
    message(FATAL_ERROR "gufo_extension_target: undeclared target ${ARG_NAME}")
  endif()
  get_property(created GLOBAL PROPERTY "GUFO_EXT_TARGET_${ARG_NAME}_CREATED")
  if(created)
    message(FATAL_ERROR "gufo_extension_target: duplicate target definition ${ARG_NAME}")
  endif()
  set_property(GLOBAL PROPERTY "GUFO_EXT_TARGET_${ARG_NAME}_CREATED" TRUE)
  get_property(enabled GLOBAL PROPERTY "GUFO_EXT_TARGET_${ARG_NAME}_ENABLED")
  if(NOT enabled)
    return()
  endif()
  get_property(role GLOBAL PROPERTY "GUFO_EXT_TARGET_${ARG_NAME}_ROLE")
  get_property(owner GLOBAL PROPERTY "GUFO_EXT_TARGET_${ARG_NAME}_OWNER")
  # A loadable module resolves the host services from the gufo executable, so
  # its libraries take only the usage requirements of the link contracts.
  # Tests remain executables and still link every implementation they list.
  # The early link checks see the links as written, before any rewriting.
  _gufo_extension_check_links(${ARG_NAME} "${owner}" ${ARG_LINK_LIBRARIES})
  set(as_module FALSE)
  if(owner IN_LIST GUFO_EXTENSION_MODULES AND NOT role STREQUAL test)
    set(as_module TRUE)
    set(links)
    foreach(dependency IN LISTS ARG_LINK_LIBRARIES)
      set(exporter "")
      set(export "")
      if(dependency MATCHES "^gufo::([a-z][a-z0-9_]*)$")
        set(export "${CMAKE_MATCH_1}")
        get_property(exporter GLOBAL PROPERTY "GUFO_EXT_EXPORT_${export}_OWNER")
        if("${exporter}" STREQUAL owner)
          set(exporter "")
        endif()
      endif()
      get_property(dependency_owner GLOBAL PROPERTY "GUFO_EXT_TARGET_${dependency}_OWNER")
      if(dependency MATCHES "^(gufo_ext_runtime|gufo_ext_core|gufo_ext_cache|gufo_ext_hip)$")
        list(APPEND links "$<COMPILE_ONLY:${dependency}>")
      elseif(dependency MATCHES "^(gufo::qwen_family|gufo_qwen_family)$" OR NOT "${exporter}" STREQUAL "")
        # The gufo executable keeps and exports the family's and every
        # built-in in-tree export's objects (gufo_extension_host); a copy in
        # the module would duplicate them. Windows does not export them yet.
        if(WIN32)
          message(FATAL_ERROR "extension target ${ARG_NAME} links ${dependency}, which loadable "
            "extension modules do not support on Windows yet; build ${owner} into gufo with "
            "GUFO_EXTENSION_DIRS instead")
        endif()
        if(NOT "${exporter}" STREQUAL "")
          _gufo_module_host_extensions(hosts)
          if(NOT exporter IN_LIST hosts)
            message(FATAL_ERROR "extension target ${ARG_NAME} links ${dependency} of extension ${exporter}, "
              "which this gufo does not build in; a module may link only the exports of in-tree "
              "extensions built into gufo")
          endif()
        endif()
        if("${exporter}" STREQUAL "")
          list(APPEND links "$<COMPILE_ONLY:${dependency}>")
        else()
          _gufo_module_export_target(standin "${export}" "${owner}")
          list(APPEND links "${standin}")
        endif()
      elseif(NOT "${dependency_owner}" STREQUAL "" AND NOT dependency_owner STREQUAL owner)
        message(FATAL_ERROR "extension target ${ARG_NAME} links ${dependency}, a target of extension "
          "${dependency_owner}; a module links only its gufo:: exports, which the gufo executable provides")
      else()
        list(APPEND links "${dependency}")
      endif()
    endforeach()
    set(ARG_LINK_LIBRARIES "${links}")
  endif()
  if(DEFINED GUFO_EXTENSION_BUILD_ROOT)
    set(sources)
    foreach(source IN LISTS ARG_SOURCES)
      get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${GUFO_EXTENSION_BUILD_ROOT}")
      list(APPEND sources "${source}")
    endforeach()
    set(ARG_SOURCES "${sources}")
  endif()
  if(role STREQUAL test)
    add_executable(${ARG_NAME} ${ARG_SOURCES})
  else()
    add_library(${ARG_NAME} STATIC ${ARG_SOURCES})
  endif()
  if(as_module)
    set_target_properties(${ARG_NAME} PROPERTIES POSITION_INDEPENDENT_CODE ON)
  endif()
  get_property(is_external GLOBAL PROPERTY "GUFO_EXT_${owner}_IS_EXTERNAL")
  # A manifest module is global once any selected extension declares it; an
  # extension that links it must declare it too, or it builds only beside one.
  get_property(package_modules GLOBAL PROPERTY GUFO_EXT_PKG_CONFIG_MODULES)
  get_property(declared_modules GLOBAL PROPERTY "GUFO_EXT_${owner}_PKG_CONFIG")
  foreach(dependency IN LISTS ARG_LINK_LIBRARIES)
    if(dependency MATCHES "^PkgConfig::(.+)$" AND CMAKE_MATCH_1 IN_LIST package_modules
       AND NOT CMAKE_MATCH_1 IN_LIST declared_modules)
      message(FATAL_ERROR "extension target ${ARG_NAME} links ${dependency}, which extension ${owner} does not declare in packages")
    endif()
  endforeach()
  if(is_external)
    target_include_directories(${ARG_NAME} BEFORE PRIVATE "${GUFO_EXTENSION_BUILD_ROOT}")
    target_include_directories(${ARG_NAME} SYSTEM PRIVATE "${PROJECT_SOURCE_DIR}/include")
  endif()
  target_link_libraries(${ARG_NAME} PRIVATE ${ARG_LINK_LIBRARIES})
  target_compile_features(${ARG_NAME} PUBLIC cxx_std_20)
  # Directory test assertions must not silently change production libraries.
  get_target_property(inherited ${ARG_NAME} COMPILE_OPTIONS)
  if(inherited)
    list(REMOVE_ITEM inherited -UNDEBUG /UNDEBUG)
    set_property(TARGET ${ARG_NAME} PROPERTY COMPILE_OPTIONS "${inherited}")
  endif()
  if(CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
    if(NOT DEFINED GUFO_ENABLE_WARNINGS OR GUFO_ENABLE_WARNINGS)
      target_compile_options(${ARG_NAME} PRIVATE /W4)
    endif()
    if(role STREQUAL test)
      target_compile_options(${ARG_NAME} PRIVATE /UNDEBUG)
    endif()
  elseif(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    if(NOT DEFINED GUFO_ENABLE_WARNINGS OR GUFO_ENABLE_WARNINGS)
      target_compile_options(${ARG_NAME} PRIVATE -Wall -Wextra -Wpedantic)
    endif()
    if(role STREQUAL test)
      target_compile_options(${ARG_NAME} PRIVATE -UNDEBUG)
    endif()
  endif()
  # Match the host's configured sanitizers without relying on creation order.
  if(GUFO_ENABLE_SANITIZERS AND CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    target_compile_options(${ARG_NAME} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
    target_link_options(${ARG_NAME} PUBLIC -fsanitize=address,undefined)
  endif()
endfunction()

# The extension whose discovery wrapper contains `directory`, or "" outside
# every wrapper (Gufo itself, tests, an executable). It reads only the
# read-only SOURCE_DIR/PARENT_DIRECTORY directory properties, so build code
# cannot pass itself off as another extension by setting variables.
function(_gufo_directory_owner out directory)
  set(owner "")
  while(NOT "${directory}" STREQUAL "")
    get_property(owner GLOBAL PROPERTY "GUFO_EXT_WRAPPER_OWNER_${directory}")
    if(NOT "${owner}" STREQUAL "")
      break()
    endif()
    get_property(directory DIRECTORY "${directory}" PROPERTY PARENT_DIRECTORY)
  endwhile()
  set(${out} "${owner}" PARENT_SCOPE)
endfunction()

# The extension that defines `target` (aliases resolved), or "".
function(_gufo_target_owner out target)
  set(owner "")
  if(TARGET "${target}")
    get_target_property(aliased "${target}" ALIASED_TARGET)
    if(aliased)
      set(target "${aliased}")
    endif()
    get_target_property(directory "${target}" SOURCE_DIR)
    if(directory)
      _gufo_directory_owner(owner "${directory}")
    endif()
  endif()
  set(${out} "${owner}" PARENT_SCOPE)
endfunction()

# The extension whose gufo:: namespace holds `name`: the longest extension
# name that equals it or prefixes it followed by '_'; "" for none.
function(_gufo_namespace_owner out name)
  get_property(names GLOBAL PROPERTY GUFO_EXTENSION_NAMES)
  set(owner "")
  foreach(candidate IN LISTS names)
    string(LENGTH "${candidate}" length)
    string(LENGTH "${owner}" longest)
    if((name STREQUAL candidate OR name MATCHES "^${candidate}_") AND length GREATER longest)
      set(owner "${candidate}")
    endif()
  endforeach()
  set(${out} "${owner}" PARENT_SCOPE)
endfunction()

# Every extension `name` depends on, directly or transitively.
function(_gufo_depends_closure out name)
  get_property(queue GLOBAL PROPERTY "GUFO_EXT_${name}_DEPENDS")
  set(closure)
  while(queue)
    list(POP_FRONT queue dependency)
    if(NOT dependency IN_LIST closure)
      list(APPEND closure "${dependency}")
      get_property(next GLOBAL PROPERTY "GUFO_EXT_${dependency}_DEPENDS")
      list(APPEND queue ${next})
    endif()
  endwhile()
  set(${out} "${closure}" PARENT_SCOPE)
endfunction()

# Early, clearer errors for the links gufo_extension_target is given. The
# complete, order-independent check of every extension target's links runs
# after all extensions are built (_gufo_check_extension_links).
function(_gufo_extension_check_links target owner)
  get_property(depends GLOBAL PROPERTY "GUFO_EXT_${owner}_DEPENDS")
  get_property(selection_set GLOBAL PROPERTY GUFO_SELECTED_EXTENSIONS SET)
  get_property(selected GLOBAL PROPERTY GUFO_SELECTED_EXTENSIONS)
  foreach(dependency IN LISTS ARGN)
    if(dependency MATCHES "^gufo::([a-z][a-z0-9_]*)$")
      set(export "${CMAKE_MATCH_1}")
      get_property(exported GLOBAL PROPERTY "GUFO_EXT_EXPORT_${export}_OWNER" SET)
      if(NOT exported)
        continue()
      endif()
      get_property(exporter GLOBAL PROPERTY "GUFO_EXT_EXPORT_${export}_OWNER")
      if(NOT exporter IN_LIST depends AND NOT exporter STREQUAL owner)
        message(FATAL_ERROR "extension target ${target} links ${dependency}, exported by extension ${exporter}; "
          "add \"${exporter}\" to depends in the extension.json of ${owner}")
      endif()
      get_property(available GLOBAL PROPERTY "GUFO_EXT_EXPORT_${export}_ENABLED")
      if(NOT available)
        get_property(exported_target GLOBAL PROPERTY "GUFO_EXT_EXPORT_${export}_TARGET")
        message(FATAL_ERROR "extension target ${target} requires unavailable dependency ${dependency} "
          "(${exported_target} of ${exporter} is disabled by its requires)")
      endif()
      continue()
    endif()
    get_property(declared GLOBAL PROPERTY "GUFO_EXT_TARGET_${dependency}_OWNER" SET)
    if(declared)
      get_property(available GLOBAL PROPERTY "GUFO_EXT_TARGET_${dependency}_ENABLED")
      get_property(dependency_owner GLOBAL PROPERTY "GUFO_EXT_TARGET_${dependency}_OWNER")
      if(NOT available OR (selection_set AND NOT dependency_owner IN_LIST selected))
        message(FATAL_ERROR "extension target ${target} requires unavailable dependency ${dependency} (${dependency_owner})")
      endif()
      if(NOT dependency_owner STREQUAL owner AND NOT dependency_owner IN_LIST depends)
        message(FATAL_ERROR "extension target ${target} links ${dependency}, a target of extension ${dependency_owner}; "
          "add \"${dependency_owner}\" to depends in the extension.json of ${owner} and link its gufo:: export")
      endif()
    endif()
  endforeach()
endfunction()

# Export one of the calling extension's manifest targets as gufo::<NAME>, the
# alias that extensions listing it in `depends` link. NAME lies in the
# extension's namespace (see _gufo_namespace_owner). A target disabled by its
# `requires` exports nothing: dependents that need it are disabled by the
# same condition.
function(gufo_extension_export)
  cmake_parse_arguments(ARG "" "TARGET;NAME" "" ${ARGN})
  if("${ARG_TARGET}" STREQUAL "" OR "${ARG_NAME}" STREQUAL "" OR NOT "${ARG_UNPARSED_ARGUMENTS}" STREQUAL "")
    message(FATAL_ERROR "gufo_extension_export requires TARGET and NAME")
  endif()
  get_property(current DIRECTORY PROPERTY SOURCE_DIR)
  _gufo_directory_owner(caller "${current}")
  if(caller STREQUAL "")
    message(FATAL_ERROR "gufo_extension_export: call it from an extension.cmake that extension discovery runs")
  endif()
  get_property(declared GLOBAL PROPERTY "GUFO_EXT_TARGET_${ARG_TARGET}_OWNER" SET)
  if(NOT declared)
    message(FATAL_ERROR "gufo_extension_export: ${ARG_TARGET} is not a target in any extension manifest")
  endif()
  get_property(owner GLOBAL PROPERTY "GUFO_EXT_TARGET_${ARG_TARGET}_OWNER")
  if(NOT owner STREQUAL caller)
    message(FATAL_ERROR "gufo_extension_export: ${ARG_TARGET} belongs to extension ${owner}; "
      "only its extension.cmake can export it, not ${caller}'s")
  endif()
  get_property(role GLOBAL PROPERTY "GUFO_EXT_TARGET_${ARG_TARGET}_ROLE")
  if(role STREQUAL test)
    message(FATAL_ERROR "gufo_extension_export: ${ARG_TARGET} is a test target")
  endif()
  _gufo_namespace_owner(namespace "${ARG_NAME}")
  if(NOT ARG_NAME MATCHES "^[a-z][a-z0-9_]*$" OR NOT namespace STREQUAL owner)
    if(namespace STREQUAL "" OR namespace STREQUAL owner)
      message(FATAL_ERROR "gufo_extension_export: NAME ${ARG_NAME} must be ${owner} or start with ${owner}_")
    endif()
    message(FATAL_ERROR "gufo_extension_export: NAME ${ARG_NAME} is in the namespace of extension ${namespace}, not ${owner}")
  endif()
  get_property(duplicate GLOBAL PROPERTY "GUFO_EXT_EXPORT_${ARG_NAME}_OWNER" SET)
  if(duplicate)
    message(FATAL_ERROR "gufo_extension_export: duplicate export gufo::${ARG_NAME}")
  endif()
  get_property(enabled GLOBAL PROPERTY "GUFO_EXT_TARGET_${ARG_TARGET}_ENABLED")
  get_property(created GLOBAL PROPERTY "GUFO_EXT_TARGET_${ARG_TARGET}_CREATED")
  if(enabled AND NOT created)
    message(FATAL_ERROR "gufo_extension_export: call gufo_extension_target(NAME ${ARG_TARGET}) first")
  endif()
  set_property(GLOBAL PROPERTY "GUFO_EXT_EXPORT_${ARG_NAME}_OWNER" "${owner}")
  set_property(GLOBAL PROPERTY "GUFO_EXT_EXPORT_${ARG_NAME}_TARGET" "${ARG_TARGET}")
  set_property(GLOBAL PROPERTY "GUFO_EXT_EXPORT_${ARG_NAME}_ENABLED" "${enabled}")
  set_property(GLOBAL APPEND PROPERTY "GUFO_EXT_${owner}_EXPORTS" "${ARG_NAME}")
  if(enabled)
    add_library(gufo::${ARG_NAME} ALIAS ${ARG_TARGET})
    set_property(GLOBAL PROPERTY "GUFO_EXT_EXPORTED_${ARG_TARGET}" "${owner}")
  endif()
endfunction()

function(gufo_extension_hip_sources target)
  cmake_parse_arguments(ARG "" "" "SOURCES;OPTIONS;DEFINITIONS" ${ARGN})
  if(NOT TARGET ${target})
    return()
  endif()
  get_property(requires GLOBAL PROPERTY "GUFO_EXT_TARGET_${target}_REQUIRES")
  if(NOT hip IN_LIST requires OR NOT ENGINE_ENABLE_HIP)
    message(FATAL_ERROR "gufo_extension_hip_sources requires a HIP target")
  endif()
  if(DEFINED GUFO_EXTENSION_BUILD_ROOT)
    set(sources)
    foreach(source IN LISTS ARG_SOURCES)
      get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${GUFO_EXTENSION_BUILD_ROOT}")
      list(APPEND sources "${source}")
    endforeach()
    set(ARG_SOURCES "${sources}")
  endif()
  target_sources(${target} PRIVATE ${ARG_SOURCES})
  set_source_files_properties(${ARG_SOURCES} PROPERTIES LANGUAGE HIP)
  foreach(source IN LISTS ARG_SOURCES)
    set_property(SOURCE "${source}" APPEND PROPERTY COMPILE_OPTIONS ${ARG_OPTIONS})
    set_property(SOURCE "${source}" APPEND PROPERTY COMPILE_DEFINITIONS ${ARG_DEFINITIONS})
  endforeach()
endfunction()

function(_gufo_write_if_different path content)
  if(EXISTS "${path}")
    file(READ "${path}" previous)
    if(previous STREQUAL content)
      return()
    endif()
  endif()
  # Unlike file(CONFIGURE), metadata containing @NAME@ stays literal data.
  file(WRITE "${path}" "${content}")
endfunction()

function(_gufo_cpp_strings out)
  set(result "{")
  foreach(value IN LISTS ARGN)
    string(APPEND result "\"${value}\",")
  endforeach()
  string(APPEND result "}")
  set(${out} "${result}" PARENT_SCOPE)
endfunction()
function(_gufo_provider_constant out json index enabled reason)
  string(JSON provider GET "${json}" providers ${index})
  _gufo_json(id "${provider}" STRING id)
  _gufo_json(capability "${provider}" STRING capability)
  set(capability_text_generation kTextGeneration)
  set(capability_embeddings kEmbeddings)
  set(capability_speech_recognition kSpeechRecognition)
  set(capability_speech_synthesis kSpeechSynthesis)
  set(capability_image_generation kImageGeneration)
  set(capability_video_generation kVideoGeneration)
  set(capability_decision kDecision)
  foreach(field keys model_ids speculative)
    _gufo_optional(array "${provider}" ${field} "[]")
    _gufo_strings(values "${array}")
    _gufo_cpp_strings(${field} ${values})
  endforeach()
  set(option_values "{")
  _gufo_optional(options "${json}" options "[]")
  string(JSON count LENGTH "${options}")
  if(count GREATER 0)
    math(EXPR last "${count}-1")
    foreach(i RANGE ${last})
      string(JSON option GET "${options}" ${i})
      _gufo_optional(selected "${option}" providers "[]")
      _gufo_strings(ids "${selected}")
      if(NOT "${ids}" STREQUAL "" AND NOT id IN_LIST ids)
        continue()
      endif()
      _gufo_json(name "${option}" STRING name)
      _gufo_json(type "${option}" STRING type)
      _gufo_strings(commands "${option}" commands)
      _gufo_cpp_strings(commands_cpp ${commands})
      _gufo_optional(help "${option}" help "")
      # Help is free text; escape for generated C++ rather than interpreting it.
      string(REPLACE "\\" "\\\\" help "${help}")
      string(REPLACE "\"" "\\\"" help "${help}")
      string(REPLACE "\n" "\\n" help "${help}")
      string(REPLACE "\r" "\\r" help "${help}")
      set(type_boolean kBoolean)
      set(type_integer kInteger)
      set(type_number kNumber)
      set(type_string kString)
      set(type_path kPath)
      string(APPEND option_values "{\"${name}\", OptionType::${type_${type}}, ${commands_cpp}, \"${help}\"},")
    endforeach()
  endif()
  string(APPEND option_values "}")
  if(enabled)
    set(available true)
  else()
    set(available false)
  endif()
  # A queue preference only changes the default; serve still clamps it.
  set(hardware_queues 0)
  string(JSON queue_type ERROR_VARIABLE error TYPE "${provider}" serving hardware_queues)
  if(NOT error)
    _gufo_json(hardware_queues "${provider}" NUMBER serving hardware_queues)
  endif()
  set(uses_hip true)
  string(JSON hip_type ERROR_VARIABLE error TYPE "${provider}" serving hip)
  if(NOT error)
    _gufo_json(uses_hip "${provider}" BOOLEAN serving hip)
    if(uses_hip)
      set(uses_hip true)
    else()
      set(uses_hip false)
    endif()
  endif()
  set(${out} "{.id=\"${id}\", .capability=Capability::${capability_${capability}}, .keys=${keys}, .model_ids=${model_ids}, .speculative=${speculative}, .options=${option_values}, .available=${available}, .unavailable_reason=\"${reason}\", .extension=\"\", .hardware_queues=${hardware_queues}, .uses_hip=${uses_hip}}" PARENT_SCOPE)
endfunction()

# Record the source revision of an external extension: the commit of its Git
# work tree and whether that tree has uncommitted changes, else the revision
# declared for its directory (a trailing "-dirty" marks uncommitted changes),
# else "unknown". Configure reruns when the work tree's HEAD or index changes.
function(_gufo_extension_source_revision name root declared)
  set(revision "unknown")
  set(dirty false)
  find_package(Git QUIET)
  if(Git_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${root}" ls-files --error-unmatch extension.json
      RESULT_VARIABLE untracked OUTPUT_QUIET ERROR_QUIET)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${root}" rev-parse --verify HEAD
      RESULT_VARIABLE no_commit OUTPUT_VARIABLE commit ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(untracked EQUAL 0 AND no_commit EQUAL 0 AND commit MATCHES "^[0-9a-f]+$")
      set(revision "${commit}")
      execute_process(COMMAND "${GIT_EXECUTABLE}" --no-optional-locks -C "${root}" status --porcelain
        RESULT_VARIABLE failed OUTPUT_VARIABLE changes ERROR_QUIET)
      if(NOT failed EQUAL 0 OR NOT "${changes}" STREQUAL "")
        set(dirty true)
      endif()
      set(tracked HEAD index packed-refs logs/HEAD)
      execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${root}" symbolic-ref -q HEAD
        RESULT_VARIABLE detached OUTPUT_VARIABLE branch ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
      if(detached EQUAL 0)
        list(APPEND tracked "${branch}")
      endif()
      foreach(file IN LISTS tracked)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${root}" rev-parse --git-path "${file}"
          RESULT_VARIABLE failed OUTPUT_VARIABLE path ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
        get_filename_component(path "${path}" ABSOLUTE BASE_DIR "${root}")
        # A missing dependency would rerun configure on every build.
        if(failed EQUAL 0 AND EXISTS "${path}" AND NOT IS_DIRECTORY "${path}")
          set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
        endif()
      endforeach()
    endif()
  endif()
  if(revision STREQUAL "unknown" AND NOT "${declared}" STREQUAL "")
    if(declared MATCHES "^(.+)-dirty$")
      set(revision "${CMAKE_MATCH_1}")
      set(dirty true)
    else()
      set(revision "${declared}")
    endif()
  endif()
  set_property(GLOBAL PROPERTY "GUFO_EXT_${name}_REVISION" "${revision}")
  set_property(GLOBAL PROPERTY "GUFO_EXT_${name}_DIRTY" "${dirty}")
endfunction()

# The C++ initializer of an extension's ExtensionInfo. Only an external
# extension records a revision.
function(_gufo_extension_info_cpp out name version source_cpp)
  set(info "{\"${name}\", \"${version}\", ${source_cpp}")
  get_property(revision GLOBAL PROPERTY "GUFO_EXT_${name}_REVISION")
  if(NOT "${revision}" STREQUAL "")
    get_property(dirty GLOBAL PROPERTY "GUFO_EXT_${name}_DIRTY")
    # A declared revision is free text, such as a tag name.
    string(REPLACE "\\" "\\\\" revision "${revision}")
    string(REPLACE "\"" "\\\"" revision "${revision}")
    string(APPEND info ", \"${revision}\", ${dirty}")
  endif()
  set(${out} "${info}}" PARENT_SCOPE)
endfunction()

# Append one extension's registration to generated declarations and body, and
# link its enabled targets into the registering target. A non-empty source
# expression replaces the recorded source directory, for runtime-loaded modules.
function(_gufo_extension_registration out_declarations out_body target name directory source_expression)
  set(declarations "${${out_declarations}}")
  set(body "${${out_body}}")
  get_property(json GLOBAL PROPERTY "GUFO_EXT_${name}_JSON")
  get_property(root GLOBAL PROPERTY "GUFO_EXT_${name}_ROOT")
  get_property(targets GLOBAL PROPERTY "GUFO_EXT_${name}_TARGETS")
  foreach(library IN LISTS targets)
    get_property(enabled GLOBAL PROPERTY "GUFO_EXT_TARGET_${library}_ENABLED")
    get_property(created GLOBAL PROPERTY "GUFO_EXT_TARGET_${library}_CREATED")
    if(NOT created)
      message(FATAL_ERROR "registry: declared target ${library} was not defined by gufo_extension_target")
    endif()
    if(enabled AND NOT TARGET ${library})
      message(FATAL_ERROR "registry: missing enabled target ${library}")
    endif()
  endforeach()
  _gufo_optional(kind "${json}" kind extension)
  if(kind STREQUAL library)
    _gufo_json(version "${json}" STRING version)
    file(RELATIVE_PATH source "${PROJECT_SOURCE_DIR}" "${root}")
    _gufo_extension_info_cpp(info "${name}" "${version}" "\"${source}\"")
    string(APPEND body "  registry.BeginExtension(${info});\n")
    set(${out_declarations} "${declarations}" PARENT_SCOPE)
    set(${out_body} "${body}" PARENT_SCOPE)
    return()
  endif()
  _gufo_json(entry "${json}" STRING entry)
  _gufo_json(registration_target "${json}" STRING registration_target)
  _gufo_json(version "${json}" STRING version)
  get_property(enabled GLOBAL PROPERTY "GUFO_EXT_TARGET_${registration_target}_ENABLED")
  if(NOT enabled)
    message(FATAL_ERROR "registry: extension ${name} is not supported on this platform")
  endif()
  file(RELATIVE_PATH source "${PROJECT_SOURCE_DIR}" "${root}")
  string(REPLACE "\\" "/" source "${source}")
  string(REPLACE "\"" "\\\"" source "${source}")
  if(NOT "${source_expression}" STREQUAL "")
    set(info "{\"${name}\", \"${version}\", ${source_expression}}")
  else()
    _gufo_extension_info_cpp(info "${name}" "${version}" "\"${source}\"")
  endif()
  string(APPEND declarations "#include <gufo/ext/generated/${name}_constants.hpp>\nvoid ${entry}(gufo::ext::Registry&);\n")
  string(APPEND body "  registry.BeginExtension(${info});\n  ::${entry}(registry);\n")
  target_link_libraries(${target} PRIVATE ${registration_target})
  set(constants "// Generated. Do not edit.\n#pragma once\n#include <gufo/ext/registry.hpp>\nnamespace gufo::ext::generated::extension_${name} {\n")
  string(JSON count LENGTH "${json}" providers)
  math(EXPR last "${count}-1")
  foreach(i RANGE ${last})
    _gufo_json(provider_target "${json}" STRING providers ${i} target)
    _gufo_json(provider_entry "${json}" STRING providers ${i} entry)
    _gufo_json(id "${json}" STRING providers ${i} id)
    string(REPLACE "-" "_" identifier "${id}")
    get_property(enabled GLOBAL PROPERTY "GUFO_EXT_TARGET_${provider_target}_ENABLED")
    get_property(requires GLOBAL PROPERTY "GUFO_EXT_TARGET_${provider_target}_REQUIRES")
    if(enabled)
      set(reason "")
    else()
      string(JOIN ", " conditions ${requires})
      set(reason "requires ${conditions}")
    endif()
    _gufo_provider_constant(value "${json}" ${i} "${enabled}" "${reason}")
    string(APPEND constants "inline const ProviderInfo kProvider_${identifier} = ${value};\n")
    if(enabled)
      string(APPEND declarations "void ${provider_entry}(gufo::ext::Registry&);\n")
      string(APPEND body "  ::${provider_entry}(registry);\n")
      target_link_libraries(${target} PRIVATE ${provider_target})
    else()
      string(APPEND body "  registry.AddProvider(gufo::ext::generated::extension_${name}::kProvider_${identifier});\n")
    endif()
    target_include_directories(${registration_target} PRIVATE "${directory}")
    if(enabled)
      target_include_directories(${provider_target} PRIVATE "${directory}")
    endif()
  endforeach()
  string(APPEND constants "}\n")
  _gufo_write_if_different("${directory}/gufo/ext/generated/${name}_constants.hpp" "${constants}")
  set(${out_declarations} "${declarations}" PARENT_SCOPE)
  set(${out_body} "${body}" PARENT_SCOPE)
endfunction()

# Generate a registry per executable. No process-global constructors or implicit
# whole-archive links are used. The provider entry lives with its actual factory;
# an unavailable provider produces metadata only and no declaration/reference.
function(gufo_target_extensions target)
  cmake_parse_arguments(ARG "LOAD_MODULES" "" "EXTENSIONS" ${ARGN})
  if(NOT TARGET ${target} OR NOT "${ARG_UNPARSED_ARGUMENTS}" STREQUAL "")
    message(FATAL_ERROR "gufo_target_extensions requires an existing target")
  endif()
  gufo_extensions_validate()
  get_property(names GLOBAL PROPERTY GUFO_EXTENSION_NAMES)
  get_property(order GLOBAL PROPERTY GUFO_EXTENSION_ORDER)
  foreach(name IN LISTS ARG_EXTENSIONS)
    if(NOT name IN_LIST names)
      message(FATAL_ERROR "registry: unknown extension ${name}")
    endif()
    get_property(depends GLOBAL PROPERTY "GUFO_EXT_${name}_DEPENDS")
    foreach(dependency IN LISTS depends)
      if(NOT dependency IN_LIST ARG_EXTENSIONS)
        message(FATAL_ERROR "registry: missing selected dependency ${dependency} for ${name}")
      endif()
    endforeach()
  endforeach()
  set(directory "${CMAKE_CURRENT_BINARY_DIR}/extensions/${target}")
  file(MAKE_DIRECTORY "${directory}/gufo/ext/generated")
  set(declarations "// Generated. Do not edit.\n#include <gufo/ext/registry.hpp>\n")
  set(body "void gufo::ext::RegisterBuiltExtensions(Registry& registry) {\n  (void)registry;\n")
  foreach(name IN LISTS order)
    if(NOT name IN_LIST ARG_EXTENSIONS)
      continue()
    endif()
    if(ARG_LOAD_MODULES)
      # An installed module may replace this built-in extension.
      set(extension_body "")
      _gufo_extension_registration(declarations extension_body ${target} ${name} "${directory}" "")
      string(APPEND body "  if (!gufo::ext::ExtensionModuleShadows(\"${name}\")) {\n${extension_body}  }\n")
    else()
      _gufo_extension_registration(declarations body ${target} ${name} "${directory}" "")
    endif()
  endforeach()
  get_property(mode GLOBAL PROPERTY GUFO_EXTENSION_SELECTION_MODE)
  if("${mode}" STREQUAL "")
    set(mode explicit)
  endif()
  get_property(excluded GLOBAL PROPERTY GUFO_EXCLUDED_EXTENSIONS)
  foreach(name IN LISTS excluded)
    get_property(json GLOBAL PROPERTY "GUFO_EXT_${name}_JSON")
    get_property(root GLOBAL PROPERTY "GUFO_EXT_${name}_ROOT")
    get_property(reason GLOBAL PROPERTY "GUFO_EXT_${name}_EXCLUDED_REASON")
    _gufo_json(version "${json}" STRING version)
    file(RELATIVE_PATH source "${PROJECT_SOURCE_DIR}" "${root}")
    foreach(field keys model_ids options)
      _gufo_extension_values(values "${json}" "${field}")
      _gufo_cpp_strings(${field} ${values})
    endforeach()
    _gufo_extension_info_cpp(info "${name}" "${version}" "\"${source}\"")
    string(APPEND body "  registry.AddExcluded({${info}, ${keys}, ${model_ids}, ${options}, \"${reason}\"});\n")
  endforeach()
  if(ARG_LOAD_MODULES)
    # The executable defines the loader; it registers modules after built-ins.
    string(APPEND declarations "namespace gufo::ext {\nbool ExtensionModuleShadows(std::string_view name);\nvoid RegisterExtensionModules(Registry& registry);\n}\n")
    string(APPEND body "  gufo::ext::RegisterExtensionModules(registry);\n")
  endif()
  string(APPEND body "}\nstd::string_view gufo::ext::ExtensionSelectionMode() { return \"${mode}\"; }\n")
  if(ARG_LOAD_MODULES)
    # The downloadable weights of the built-in extensions, for `gufo model`.
    set(catalog "[]")
    set(index 0)
    foreach(name IN LISTS order)
      get_property(models GLOBAL PROPERTY "GUFO_EXT_${name}_MODELS")
      if(name IN_LIST ARG_EXTENSIONS AND NOT "${models}" STREQUAL "")
        string(JSON catalog SET "${catalog}" ${index} "${models}")
        math(EXPR index "${index}+1")
      endif()
    endforeach()
    set(delimiter "gufo_models")
    string(FIND "${catalog}" ")${delimiter}\"" collision)
    if(NOT collision EQUAL -1)
      message(FATAL_ERROR "extension metadata: models contain the raw string delimiter")
    endif()
    # MSVC limits one string literal to 16 KiB, so the catalog is split.
    string(LENGTH "${catalog}" length)
    set(pieces "")
    set(offset 0)
    while(offset LESS length)
      string(SUBSTRING "${catalog}" ${offset} 8192 piece)
      string(APPEND pieces "      R\"${delimiter}(${piece})${delimiter}\",\n")
      math(EXPR offset "${offset}+8192")
    endwhile()
    string(APPEND declarations "#include <string>\n#include <string_view>\n")
    string(APPEND body "namespace gufo::cli {\nstd::string_view BuiltinModelCatalog();\n}\n")
    string(APPEND body "std::string_view gufo::cli::BuiltinModelCatalog() {\n  static const std::string catalog = [] {\n    std::string text;\n    for (const char* piece : {\n${pieces}      \"\"})\n      text += piece;\n    return text;\n  }();\n  return catalog;\n}\n")
  endif()
  _gufo_write_if_different("${directory}/extension_registry.cpp" "${declarations}\n${body}")
  target_sources(${target} PRIVATE "${directory}/extension_registry.cpp")
  target_include_directories(${target} PRIVATE "${directory}")
  target_link_libraries(${target} PRIVATE gufo_ext_runtime)
endfunction()

# The extensions built into the gufo executable that a loadable module may list
# in `depends`: the selected in-tree extensions it links, or, in the SDK, the
# ones its host-extensions.cmake records (gufo_host_extension). None on
# Windows, where gufo.exe does not export their code to modules yet.
function(_gufo_module_host_extensions out)
  get_property(recorded GLOBAL PROPERTY GUFO_HOST_EXTENSIONS SET)
  set(names)
  if(recorded)
    get_property(names GLOBAL PROPERTY GUFO_HOST_EXTENSIONS)
  elseif(NOT WIN32)
    get_property(selected GLOBAL PROPERTY GUFO_SELECTED_EXTENSIONS)
    foreach(name IN LISTS selected)
      get_property(external GLOBAL PROPERTY "GUFO_EXT_${name}_IS_EXTERNAL")
      if(NOT external AND NOT name IN_LIST GUFO_EXTENSION_MODULES)
        list(APPEND names "${name}")
      endif()
    endforeach()
  endif()
  set(${out} "${names}" PARENT_SCOPE)
endfunction()

# One usage-requirement value of an export with its build-tree wrapper
# removed; "" for one that never applies to the build. Any other generator
# expression fails: the record could not reproduce what in-tree dependents see.
function(_gufo_host_export_value out export property value)
  while(value MATCHES "^\\$<BUILD_INTERFACE:(.*)>$")
    set(value "${CMAKE_MATCH_1}")
  endwhile()
  if(value MATCHES "^\\$<INSTALL_INTERFACE:.*>$")
    set(value "")
  elseif(value MATCHES "\\$<")
    message(FATAL_ERROR "gufo::${export} has ${property} '${value}', a generator expression a "
      "loadable module could not reproduce; use a plain value or $<BUILD_INTERFACE:...>")
  endif()
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

# The usage requirements a module compiles and links with when it links
# gufo::<export>, as the keyword arguments of _gufo_export_standin. Paths in
# Gufo's source and build trees are left out: the surface headers reach the
# module through gufo_ext_runtime, as they do in the SDK. Fails on any usage
# requirement it cannot record, so a module never compiles differently from
# the extension's in-tree dependents.
function(_gufo_host_export_body out export)
  get_property(target GLOBAL PROPERTY "GUFO_EXT_EXPORT_${export}_TARGET")
  foreach(property INTERFACE_SOURCES INTERFACE_PRECOMPILE_HEADERS INTERFACE_LINK_DIRECTORIES
      INTERFACE_LINK_DEPENDS INTERFACE_CXX_MODULE_SETS INTERFACE_AUTOUIC_OPTIONS)
    get_target_property(values ${target} ${property})
    if(values)
      message(FATAL_ERROR "gufo::${export} (${target}) sets ${property}, which loadable modules "
        "cannot reproduce")
    endif()
  endforeach()
  set(public_contracts gufo_ext_runtime gufo_ext_core gufo_ext_cache gufo_ext_hip
    gufo_qwen_family gufo::qwen_family)
  set(body "")
  foreach(property INTERFACE_INCLUDE_DIRECTORIES INTERFACE_SYSTEM_INCLUDE_DIRECTORIES
      INTERFACE_COMPILE_DEFINITIONS INTERFACE_COMPILE_OPTIONS INTERFACE_COMPILE_FEATURES
      INTERFACE_LINK_OPTIONS INTERFACE_LINK_LIBRARIES)
    get_target_property(values ${target} ${property})
    set(kept)
    foreach(value IN LISTS values)
      # Link-only edges carry no compile requirement, and the module takes
      # their code from the executable; markers carry no link item.
      if(property STREQUAL INTERFACE_LINK_LIBRARIES AND value MATCHES "^(\\$<LINK_ONLY:|::@)")
        continue()
      endif()
      _gufo_host_export_value(value "${export}" "${property}" "${value}")
      if(value STREQUAL "" OR value MATCHES "-NOTFOUND$")
        continue()
      endif()
      if(property MATCHES "INCLUDE_DIRECTORIES$")
        cmake_path(IS_PREFIX PROJECT_SOURCE_DIR "${value}" NORMALIZE in_source)
        cmake_path(IS_PREFIX PROJECT_BINARY_DIR "${value}" NORMALIZE in_build)
        if(in_source OR in_build)
          continue()
        endif()
      elseif(property STREQUAL INTERFACE_LINK_LIBRARIES)
        if(value IN_LIST public_contracts)
          # The module links its own view of the public contracts.
          continue()
        endif()
        set(imported FALSE)
        if(TARGET "${value}")
          get_target_property(imported "${value}" IMPORTED)
        endif()
        if(NOT imported)
          message(FATAL_ERROR "gufo::${export} (${target}) passes ${value} to its dependents; a "
            "loadable module can take only imported targets and Gufo's public link contracts")
        endif()
      endif()
      list(APPEND kept "${value}")
    endforeach()
    if(kept)
      string(REGEX REPLACE "^INTERFACE_" "" keyword "${property}")
      string(APPEND body " ${keyword}")
      foreach(value IN LISTS kept)
        string(APPEND body " [==[${value}]==]")
      endforeach()
    endif()
  endforeach()
  set(${out} "${body}" PARENT_SCOPE)
endfunction()

# The INTERFACE target `target` with recorded export usage requirements: what
# a module links for an export, its code coming from the gufo executable.
function(_gufo_export_standin target)
  cmake_parse_arguments(ARG "" "" "INCLUDE_DIRECTORIES;SYSTEM_INCLUDE_DIRECTORIES;COMPILE_DEFINITIONS;COMPILE_OPTIONS;COMPILE_FEATURES;LINK_OPTIONS;LINK_LIBRARIES" ${ARGN})
  if(NOT "${ARG_UNPARSED_ARGUMENTS}" STREQUAL "")
    message(FATAL_ERROR "_gufo_export_standin: unexpected arguments ${ARG_UNPARSED_ARGUMENTS}")
  endif()
  add_library(${target} INTERFACE)
  target_include_directories(${target} INTERFACE ${ARG_INCLUDE_DIRECTORIES})
  if(ARG_SYSTEM_INCLUDE_DIRECTORIES)
    target_include_directories(${target} SYSTEM INTERFACE ${ARG_SYSTEM_INCLUDE_DIRECTORIES})
  endif()
  target_compile_definitions(${target} INTERFACE ${ARG_COMPILE_DEFINITIONS})
  target_compile_options(${target} INTERFACE ${ARG_COMPILE_OPTIONS})
  target_compile_features(${target} INTERFACE ${ARG_COMPILE_FEATURES})
  target_link_options(${target} INTERFACE ${ARG_LINK_OPTIONS})
  foreach(library IN LISTS ARG_LINK_LIBRARIES)
    target_link_libraries(${target} INTERFACE "$<COMPILE_ONLY:${library}>")
  endforeach()
endfunction()

# What a module target owned by `owner` links for gufo::<export>: the SDK's
# stand-in, or in a source tree the same stand-in built from the export, so a
# module sees exactly what `gufo extension install` gives it.
function(_gufo_module_export_target out export owner)
  get_property(sdk GLOBAL PROPERTY GUFO_HOST_EXTENSIONS SET)
  if(sdk)
    set(${out} "gufo::${export}" PARENT_SCOPE)
    return()
  endif()
  set(target "gufo_module_export_${owner}_${export}")
  if(NOT TARGET ${target})
    _gufo_host_export_body(body "${export}")
    cmake_language(EVAL CODE "_gufo_export_standin(${target}${body})")
  endif()
  set(${out} "${target}" PARENT_SCOPE)
endfunction()

# The enabled exports of extension `name`, sorted.
function(_gufo_enabled_exports out name)
  get_property(exports GLOBAL PROPERTY "GUFO_EXT_${name}_EXPORTS")
  set(enabled_exports)
  foreach(export IN LISTS exports)
    get_property(enabled GLOBAL PROPERTY "GUFO_EXT_EXPORT_${export}_ENABLED")
    if(enabled)
      list(APPEND enabled_exports "${export}")
    endif()
  endforeach()
  list(SORT enabled_exports)
  set(${out} "${enabled_exports}" PARENT_SCOPE)
endfunction()

# The identity of host extension `name` that its dependent modules are built
# against: its version and a digest of its exports' recorded usage
# requirements and of the identities of the host extensions it depends on;
# "" when it exports nothing. Its headers are in the surface digest already.
function(_gufo_host_extension_identity out name)
  get_property(recorded GLOBAL PROPERTY "GUFO_HOST_EXT_${name}_IDENTITY" SET)
  if(recorded)
    get_property(identity GLOBAL PROPERTY "GUFO_HOST_EXT_${name}_IDENTITY")
    set(${out} "${identity}" PARENT_SCOPE)
    return()
  endif()
  _gufo_enabled_exports(exports "${name}")
  set(identity "")
  if(exports)
    get_property(json GLOBAL PROPERTY "GUFO_EXT_${name}_JSON")
    _gufo_json(version "${json}" STRING version)
    set(material "version=${version}\n")
    get_property(depends GLOBAL PROPERTY "GUFO_EXT_${name}_DEPENDS")
    list(SORT depends)
    foreach(dependency IN LISTS depends)
      _gufo_host_extension_identity(dependency_identity "${dependency}")
      string(APPEND material "depends=${dependency}:${dependency_identity}\n")
    endforeach()
    foreach(export IN LISTS exports)
      _gufo_host_export_body(body "${export}")
      string(APPEND material "export=${export}${body}\n")
    endforeach()
    string(SHA256 digest "${material}")
    set(identity "${version}:${digest}")
  endif()
  set_property(GLOBAL PROPERTY "GUFO_HOST_EXT_${name}_IDENTITY" "${identity}")
  set(${out} "${identity}" PARENT_SCOPE)
endfunction()

# The host extensions as `name=identity` pairs joined by commas, for the gufo
# executable: what it checks a module's `depends` and identity against.
function(gufo_extension_host_identities out)
  _gufo_module_host_extensions(hosts)
  list(SORT hosts)
  set(pairs)
  foreach(name IN LISTS hosts)
    _gufo_host_extension_identity(identity "${name}")
    list(APPEND pairs "${name}=${identity}")
  endforeach()
  list(JOIN pairs "," text)
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

# The SDK's record of an extension built into its gufo executable (see
# host-extensions.cmake): modules may list it in `depends`. A module that
# replaces it (--replace-builtin) is built instead of depending on it.
function(gufo_host_extension)
  cmake_parse_arguments(ARG "" "NAME;IDENTITY" "PLATFORMS;DEPENDS" ${ARGN})
  if(ARG_NAME IN_LIST GUFO_EXTENSION_MODULES)
    return()
  endif()
  set_property(GLOBAL APPEND PROPERTY GUFO_HOST_EXTENSIONS "${ARG_NAME}")
  set_property(GLOBAL PROPERTY "GUFO_HOST_EXT_${ARG_NAME}_PLATFORMS" "${ARG_PLATFORMS}")
  set_property(GLOBAL PROPERTY "GUFO_HOST_EXT_${ARG_NAME}_DEPENDS" "${ARG_DEPENDS}")
  set_property(GLOBAL PROPERTY "GUFO_HOST_EXT_${ARG_NAME}_IDENTITY" "${ARG_IDENTITY}")
endfunction()

# The SDK's stand-in for the export gufo::<NAME> of a host extension.
function(gufo_host_export)
  cmake_parse_arguments(ARG "" "NAME;EXTENSION" "" ${ARGN})
  if(ARG_EXTENSION IN_LIST GUFO_EXTENSION_MODULES)
    return()
  endif()
  set(target "gufo_host_export_${ARG_NAME}")
  _gufo_export_standin(${target} ${ARG_UNPARSED_ARGUMENTS})
  add_library(gufo::${ARG_NAME} ALIAS ${target})
  set_property(GLOBAL PROPERTY "GUFO_EXT_EXPORT_${ARG_NAME}_OWNER" "${ARG_EXTENSION}")
  set_property(GLOBAL PROPERTY "GUFO_EXT_EXPORT_${ARG_NAME}_TARGET" "${target}")
  set_property(GLOBAL PROPERTY "GUFO_EXT_EXPORT_${ARG_NAME}_ENABLED" TRUE)
endfunction()

# The host-extensions.cmake text for the SDK of this build.
function(_gufo_host_extensions_record out)
  _gufo_module_host_extensions(hosts)
  list(SORT hosts)
  set(text "# Generated. The extensions built into the gufo executable this SDK belongs to.\n")
  string(APPEND text "set_property(GLOBAL PROPERTY GUFO_HOST_EXTENSIONS \"\")\n")
  foreach(name IN LISTS hosts)
    get_property(json GLOBAL PROPERTY "GUFO_EXT_${name}_JSON")
    _gufo_strings(platforms "${json}" platforms)
    get_property(depends GLOBAL PROPERTY "GUFO_EXT_${name}_DEPENDS")
    _gufo_host_extension_identity(identity "${name}")
    string(APPEND text "gufo_host_extension(NAME ${name} IDENTITY \"${identity}\" PLATFORMS ${platforms}")
    if(depends)
      string(APPEND text " DEPENDS ${depends}")
    endif()
    string(APPEND text ")\n")
    _gufo_enabled_exports(exports "${name}")
    foreach(export IN LISTS exports)
      _gufo_host_export_body(body "${export}")
      string(APPEND text "gufo_host_export(NAME ${export} EXTENSION ${name}${body})\n")
    endforeach()
  endforeach()
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

# The identity module `name` is built for: the host's build identity, plus,
# for each host extension it depends on that exports anything, that
# extension's identity. A standalone module has the host's identity, so a
# change to a host extension invalidates only the modules that depend on it.
# src/cli/extension/store.cpp computes the same value.
function(_gufo_module_build_id out name)
  gufo_extension_build_id(id)
  get_property(depends GLOBAL PROPERTY "GUFO_EXT_${name}_DEPENDS")
  list(SORT depends)
  set(lines "")
  foreach(dependency IN LISTS depends)
    _gufo_host_extension_identity(identity "${dependency}")
    if(NOT identity STREQUAL "")
      string(APPEND lines "host_extension=${dependency}:${identity}\n")
    endif()
  endforeach()
  if(NOT lines STREQUAL "")
    string(SHA256 id "${id}\n${lines}")
  endif()
  file(WRITE "${CMAKE_BINARY_DIR}/extension-modules/gufo-ext-${name}-build-id.txt" "${id}\n${lines}")
  set(${out} "${id}" PARENT_SCOPE)
endfunction()

# Identity of everything a loadable module shares with its host: the audited
# source surface, the API version, toolchain, ROCm and global compile flags.
# A module that depends on host extensions adds theirs (_gufo_module_build_id).
# A module loads only into an executable with the same identity.
function(gufo_extension_build_id out)
  get_property(id GLOBAL PROPERTY GUFO_EXTENSION_BUILD_ID)
  if(NOT id)
    include(${CMAKE_CURRENT_FUNCTION_LIST_DIR}/GufoExtensionVersion.cmake)
    set(material "api=${GUFO_EXTENSION_API_VERSION}\n")
    file(STRINGS "${PROJECT_SOURCE_DIR}/include/gufo/ext/SURFACE" headers REGEX "^[^#].+")
    # The SDK keeps the private surface headers under its public include.
    if(NOT DEFINED GUFO_SURFACE_SOURCE_ROOT)
      set(GUFO_SURFACE_SOURCE_ROOT "${PROJECT_SOURCE_DIR}")
    endif()
    foreach(header IN LISTS headers)
      if(header MATCHES "^include/")
        file(SHA256 "${PROJECT_SOURCE_DIR}/${header}" digest)
      else()
        file(SHA256 "${GUFO_SURFACE_SOURCE_ROOT}/${header}" digest)
      endif()
      string(APPEND material "${header}=${digest}\n")
    endforeach()
    string(TOUPPER "${CMAKE_BUILD_TYPE}" config)
    set(variables CMAKE_SYSTEM_NAME CMAKE_SYSTEM_PROCESSOR CMAKE_BUILD_TYPE
      CMAKE_CXX_COMPILER CMAKE_CXX_COMPILER_ID CMAKE_CXX_COMPILER_VERSION
      CMAKE_CXX_FLAGS CMAKE_CXX_FLAGS_${config} ENGINE_ENABLE_HIP
      GUFO_ENABLE_SANITIZERS)
    if(ENGINE_ENABLE_HIP)
      list(APPEND variables CMAKE_HIP_COMPILER CMAKE_HIP_COMPILER_VERSION
        CMAKE_HIP_FLAGS CMAKE_HIP_FLAGS_${config} CMAKE_HIP_ARCHITECTURES
        hip_VERSION)
    endif()
    foreach(variable IN LISTS variables)
      string(APPEND material "${variable}=${${variable}}\n")
    endforeach()
    string(SHA256 id "${material}")
    file(WRITE "${CMAKE_BINARY_DIR}/extension-build-id.txt" "${id}\n${material}")
    set_property(GLOBAL PROPERTY GUFO_EXTENSION_BUILD_ID "${id}")
  endif()
  set(${out} "${id}" PARENT_SCOPE)
endfunction()

# Build each listed extension as a loadable module. The module exports a build
# identity, its manifest and a registration entry; the host services resolve
# from the loading gufo executable, never from a copy inside the module.
function(gufo_extension_modules)
  cmake_parse_arguments(ARG "" "" "EXTENSIONS" ${ARGN})
  if(NOT "${ARG_UNPARSED_ARGUMENTS}" STREQUAL "")
    message(FATAL_ERROR "gufo_extension_modules: unexpected arguments ${ARG_UNPARSED_ARGUMENTS}")
  endif()
  # On Windows a module imports the host services from the executable's
  # import library: the `gufo` target in a source tree, the SDK's copy there.
  if(ARG_EXTENSIONS AND WIN32 AND NOT GUFO_EXTENSION_MODULE_HOST)
    message(FATAL_ERROR "gufo_extension_modules: set GUFO_EXTENSION_MODULE_HOST to the host import library target")
  endif()
  gufo_extensions_validate()
  get_property(selected GLOBAL PROPERTY GUFO_SELECTED_EXTENSIONS)
  gufo_extension_build_id(build_id)
  foreach(name IN LISTS ARG_EXTENSIONS)
    if(NOT name IN_LIST selected)
      message(FATAL_ERROR "GUFO_EXTENSION_MODULES: ${name} is not a selected extension")
    endif()
    get_property(json GLOBAL PROPERTY "GUFO_EXT_${name}_JSON")
    get_property(depends GLOBAL PROPERTY "GUFO_EXT_${name}_DEPENDS")
    _gufo_optional(kind "${json}" kind extension)
    if(kind STREQUAL library)
      message(FATAL_ERROR "GUFO_EXTENSION_MODULES: ${name} is a library; a module must be an extension")
    endif()
    # A module's dependencies are the gufo executable's own extensions: their
    # code and exports resolve from it, like the public services.
    _gufo_module_host_extensions(hosts)
    foreach(dependency IN LISTS depends)
      if(WIN32)
        message(FATAL_ERROR "GUFO_EXTENSION_MODULES: ${name} depends on ${dependency}; Windows modules "
          "cannot have depends yet; build ${name} into gufo with GUFO_EXTENSION_DIRS instead")
      endif()
      if(NOT dependency IN_LIST hosts)
        if(hosts)
          string(REPLACE ";" ", " available "${hosts}")
        else()
          set(available "none")
        endif()
        message(FATAL_ERROR "GUFO_EXTENSION_MODULES: ${name} depends on ${dependency}, which this gufo "
          "does not build in; a module may depend only on in-tree extensions built into gufo "
          "(${available})")
      endif()
    endforeach()
    set(target "gufo_ext_module_${name}")
    add_library(${target} MODULE)
    set(directory "${CMAKE_CURRENT_BINARY_DIR}/extensions/${target}")
    file(MAKE_DIRECTORY "${directory}/gufo/ext/generated")
    set(declarations "// Generated. Do not edit.\n#include <gufo/ext/registry.hpp>\n")
    set(body "")
    _gufo_extension_registration(declarations body ${target} ${name} "${directory}" "source")
    set(delimiter "gufo_manifest")
    string(FIND "${json}" ")${delimiter}\"" collision)
    if(NOT collision EQUAL -1)
      message(FATAL_ERROR "GUFO_EXTENSION_MODULES: ${name} manifest contains the raw string delimiter")
    endif()
    if(WIN32)
      set(exported "extern \"C\" __declspec(dllexport)")
    else()
      set(exported "extern \"C\" __attribute__((visibility(\"default\")))")
    endif()
    _gufo_module_build_id(module_build_id "${name}")
    string(APPEND declarations "\n${exported} const char* gufo_ext_module_build_id_v1() {\n  return \"${module_build_id}\";\n}\n")
    string(APPEND declarations "${exported} const char* gufo_ext_module_manifest_v1() {\n  return R\"${delimiter}(${json})${delimiter}\";\n}\n")
    string(APPEND declarations "${exported} void gufo_ext_module_register_v1(gufo::ext::Registry* host, const char* source) {\n  gufo::ext::Registry& registry = *host;\n${body}}\n")
    _gufo_write_if_different("${directory}/module.cpp" "${declarations}")
    target_sources(${target} PRIVATE "${directory}/module.cpp")
    target_include_directories(${target} PRIVATE "${directory}")
    target_link_libraries(${target} PRIVATE $<COMPILE_ONLY:gufo_ext_runtime>)
    if(WIN32)
      target_link_libraries(${target} PRIVATE ${GUFO_EXTENSION_MODULE_HOST})
    endif()
    target_compile_features(${target} PRIVATE cxx_std_20)
    set_target_properties(${target} PROPERTIES
      PREFIX ""
      OUTPUT_NAME "gufo-ext-${name}"
      LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/extension-modules")
  endforeach()
endfunction()
