include_guard(GLOBAL)
include(CMakeParseArguments)
set(GUFO_EXTENSION_API_VERSION "0.1.5")

# Production validation is pure CMake 3.21. Hosted checks additionally apply
# the complete JSON schema (including packaging/docs/CI-only metadata).
# Scan JSON escapes before string(JSON): CMake strings cannot represent NUL.
# Consume escaped backslashes in pairs so literal "\\u0000" stays ordinary text.
function(_gufo_reject_nul json)
  string(LENGTH "${json}" length)
  set(i 0)
  while(i LESS length)
    string(SUBSTRING "${json}" ${i} 1 character)
    if(character STREQUAL "\\")
      math(EXPR next "${i}+1")
      math(EXPR remaining "${length}-${next}")
      if(remaining GREATER_EQUAL 5)
        string(SUBSTRING "${json}" ${next} 5 escape)
        if(escape STREQUAL "u0000")
          message(FATAL_ERROR "extension metadata: U+0000 is not supported")
        endif()
      endif()
      math(EXPR i "${i}+2")
    else()
      math(EXPR i "${i}+1")
    endif()
  endwhile()
endfunction()

function(_gufo_json out json expected)
  string(JSON value ERROR_VARIABLE error TYPE "${json}" ${ARGN})
  if(error OR NOT value STREQUAL expected)
    string(JOIN "." field ${ARGN})
    message(FATAL_ERROR "extension metadata: ${field} must be ${expected} (${error})")
  endif()
  string(JSON value GET "${json}" ${ARGN})
  set(${out} "${value}" PARENT_SCOPE)
endfunction()
function(_gufo_optional out json field fallback)
  string(JSON type ERROR_VARIABLE error TYPE "${json}" "${field}")
  if(error)
    set(${out} "${fallback}" PARENT_SCOPE)
  else()
    string(JSON value GET "${json}" "${field}")
    set(${out} "${value}" PARENT_SCOPE)
  endif()
endfunction()
function(_gufo_strings out json)
  _gufo_json(array "${json}" ARRAY ${ARGN})
  string(JSON length LENGTH "${array}")
  set(values)
  if(length GREATER 0)
    math(EXPR last "${length}-1")
    foreach(i RANGE ${last})
      _gufo_json(value "${array}" STRING ${i})
      # Lists, generated C++ and symbol/property names must be inert data.
      if(value MATCHES "[;\n\r\\\"]" OR value STREQUAL "")
        message(FATAL_ERROR "extension metadata: invalid string ${value}")
      endif()
      if(value IN_LIST values)
        message(FATAL_ERROR "extension metadata: duplicate value ${value}")
      endif()
      list(APPEND values "${value}")
    endforeach()
  endif()
  set(${out} "${values}" PARENT_SCOPE)
endfunction()
function(_gufo_identifier value pattern description)
  if(NOT "${value}" MATCHES "${pattern}")
    message(FATAL_ERROR "extension metadata: invalid ${description}: ${value}")
  endif()
endfunction()
function(_gufo_entry_symbol symbol)
  set(keywords alignas alignof and and_eq asm atomic_cancel atomic_commit atomic_noexcept auto bitand bitor bool break case catch char char8_t char16_t char32_t class compl concept const consteval constexpr constinit const_cast continue co_await co_return co_yield decltype default delete do double dynamic_cast else enum explicit export extern false float for friend goto if inline int long mutable namespace new noexcept not not_eq nullptr operator or or_eq private protected public reflexpr register reinterpret_cast requires return short signed sizeof static static_assert static_cast struct switch synchronized template this thread_local throw true try typedef typeid typename union unsigned using virtual void volatile wchar_t while xor xor_eq)
  if(symbol IN_LIST keywords)
    message(FATAL_ERROR "extension metadata: reserved C++ entry symbol ${symbol}")
  endif()
  get_property(owner GLOBAL PROPERTY "GUFO_EXT_SYMBOL_${symbol}")
  if(owner)
    message(FATAL_ERROR "extension metadata: duplicate registration symbol ${symbol}")
  endif()
  set_property(GLOBAL PROPERTY "GUFO_EXT_SYMBOL_${symbol}" TRUE)
endfunction()
function(_gufo_target_enabled out requires role)
  set(enabled TRUE)
  foreach(condition IN LISTS requires)
    if(condition STREQUAL hip)
      if(NOT ENGINE_ENABLE_HIP)
        set(enabled FALSE)
      endif()
    elseif(condition STREQUAL testing)
      if(NOT BUILD_TESTING)
        set(enabled FALSE)
      endif()
    elseif(condition STREQUAL linux)
      if(NOT CMAKE_SYSTEM_NAME STREQUAL Linux)
        set(enabled FALSE)
      endif()
    elseif(condition STREQUAL windows)
      if(NOT CMAKE_SYSTEM_NAME STREQUAL Windows)
        set(enabled FALSE)
      endif()
    else()
      message(FATAL_ERROR "extension metadata: unknown target condition ${condition}")
    endif()
  endforeach()
  if(linux IN_LIST requires AND windows IN_LIST requires)
    message(FATAL_ERROR "extension metadata: unsatisfiable target conditions linux/windows")
  endif()
  if(role STREQUAL test AND NOT BUILD_TESTING)
    set(enabled FALSE)
  endif()
  set(${out} "${enabled}" PARENT_SCOPE)
endfunction()

# Register one explicitly selected manifest. Discovery/lock policy is separate.
function(gufo_extension)
  cmake_parse_arguments(ARG "" "MANIFEST" "" ${ARGN})
  if("${ARG_MANIFEST}" STREQUAL "" OR NOT "${ARG_UNPARSED_ARGUMENTS}" STREQUAL "")
    message(FATAL_ERROR "gufo_extension requires MANIFEST")
  endif()
  get_filename_component(manifest "${ARG_MANIFEST}" ABSOLUTE)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest}")
  file(READ "${manifest}" json)
  _gufo_reject_nul("${json}")
  _gufo_json(schema "${json}" NUMBER schema)
  if(NOT schema EQUAL 1)
    message(FATAL_ERROR "extension metadata: unsupported schema ${schema}")
  endif()
  _gufo_json(name "${json}" STRING name)
  _gufo_identifier("${name}" "^[a-z][a-z0-9_]*$" "extension name")
  get_property(names GLOBAL PROPERTY GUFO_EXTENSION_NAMES)
  if(name IN_LIST names)
    message(FATAL_ERROR "extension metadata: duplicate extension name ${name}")
  endif()
  _gufo_json(api "${json}" STRING api_version)
  if(NOT api MATCHES "^>= ([0-9]+)\\.([0-9]+)\\.([0-9]+)$")
    message(FATAL_ERROR "extension metadata: api_version must be >= MAJOR.MINOR.REVISION")
  endif()
  set(requested_major "${CMAKE_MATCH_1}")
  set(requested_minor "${CMAKE_MATCH_2}")
  set(requested_revision "${CMAKE_MATCH_3}")
  string(REPLACE "." ";" runtime_version "${GUFO_EXTENSION_API_VERSION}")
  list(GET runtime_version 0 runtime_major)
  list(GET runtime_version 1 runtime_minor)
  list(GET runtime_version 2 runtime_revision)
  if(NOT GUFO_EXTENSION_METADATA_ONLY AND
     (NOT requested_major STREQUAL runtime_major OR NOT requested_minor STREQUAL runtime_minor OR requested_revision GREATER runtime_revision))
    message(FATAL_ERROR "extension metadata: incompatible API version/revision ${api}; runtime ${GUFO_EXTENSION_API_VERSION}")
  endif()
  _gufo_json(version "${json}" STRING version)
  _gufo_identifier("${version}" "^[0-9]+\\.[0-9]+\\.[0-9]+([+-][A-Za-z0-9.-]+)?$" "extension version")
  _gufo_strings(depends "${json}" depends)
  foreach(dependency IN LISTS depends)
    _gufo_identifier("${dependency}" "^[a-z][a-z0-9_]*$" "dependency")
  endforeach()
  _gufo_strings(platforms "${json}" platforms)
  if("${platforms}" STREQUAL "")
    message(FATAL_ERROR "extension metadata: platforms cannot be empty")
  endif()
  foreach(platform IN LISTS platforms)
    if(NOT platform MATCHES "^(linux|windows)$")
      message(FATAL_ERROR "extension metadata: unsupported platform ${platform}")
    endif()
  endforeach()
  _gufo_optional(kind "${json}" kind extension)
  if(NOT kind MATCHES "^(extension|library)$")
    message(FATAL_ERROR "extension metadata: unknown kind ${kind}")
  endif()
  _gufo_json(targets "${json}" OBJECT targets)
  string(JSON count LENGTH "${targets}")
  if(count EQUAL 0)
    message(FATAL_ERROR "extension metadata: targets cannot be empty")
  endif()
  math(EXPR last "${count}-1")
  set(target_names)
  foreach(i RANGE ${last})
    string(JSON target MEMBER "${targets}" ${i})
    _gufo_identifier("${target}" "^[a-z][a-z0-9_]*$" "target name")
    get_property(owner GLOBAL PROPERTY "GUFO_EXT_TARGET_${target}_OWNER" SET)
    if(owner)
      get_property(owner GLOBAL PROPERTY "GUFO_EXT_TARGET_${target}_OWNER")
      message(FATAL_ERROR "extension metadata: duplicate target declaration ${target} (${owner}, ${name})")
    endif()
    _gufo_strings(requires "${targets}" "${target}" requires)
    string(JSON definition GET "${targets}" "${target}")
    _gufo_optional(role "${definition}" role library)
    if(NOT role MATCHES "^(library|test)$")
      message(FATAL_ERROR "extension metadata: invalid target role ${role}")
    endif()
    _gufo_target_enabled(enabled "${requires}" "${role}")
    # Conditions must be satisfiable on at least one declared platform.
    if((linux IN_LIST requires AND NOT linux IN_LIST platforms) OR
       (windows IN_LIST requires AND NOT windows IN_LIST platforms))
      message(FATAL_ERROR "extension metadata: unsatisfiable target/platform conditions for ${target}")
    endif()
    string(TOLOWER "${CMAKE_SYSTEM_NAME}" system)
    if(NOT system IN_LIST platforms)
      set(enabled FALSE)
    endif()
    foreach(field OWNER ENABLED REQUIRES ROLE)
      if(field STREQUAL OWNER)
        set(value "${name}")
      elseif(field STREQUAL ENABLED)
        set(value "${enabled}")
      elseif(field STREQUAL REQUIRES)
        set(value "${requires}")
      else()
        set(value "${role}")
      endif()
      set_property(GLOBAL PROPERTY "GUFO_EXT_TARGET_${target}_${field}" "${value}")
    endforeach()
    list(APPEND target_names "${target}")
  endforeach()
  if(kind STREQUAL extension)
    _gufo_json(entry "${json}" STRING entry)
    _gufo_identifier("${entry}" "^[A-Za-z_][A-Za-z0-9_]*$" "entry symbol")
    _gufo_entry_symbol("${entry}")
    _gufo_json(registration_target "${json}" STRING registration_target)
    if(NOT registration_target IN_LIST target_names)
      message(FATAL_ERROR "extension metadata: missing registration target ${registration_target}")
    endif()
    get_property(requires GLOBAL PROPERTY "GUFO_EXT_TARGET_${registration_target}_REQUIRES")
    get_property(role GLOBAL PROPERTY "GUFO_EXT_TARGET_${registration_target}_ROLE")
    if(NOT "${requires}" STREQUAL "" OR NOT role STREQUAL library)
      message(FATAL_ERROR "extension metadata: registration target must be an unconditional library")
    endif()
    _gufo_json(providers "${json}" ARRAY providers)
    string(JSON count LENGTH "${providers}")
    if(count EQUAL 0)
      message(FATAL_ERROR "extension metadata: providers cannot be empty")
    endif()
    math(EXPR last "${count}-1")
    set(provider_ids)
    set(provider_identifiers)
    foreach(i RANGE ${last})
      foreach(field id capability target entry)
        _gufo_json(${field} "${providers}" STRING ${i} ${field})
      endforeach()
      _gufo_identifier("${id}" "^[a-z][a-z0-9_-]*$" "provider ID")
      _gufo_identifier("${entry}" "^[A-Za-z_][A-Za-z0-9_]*$" "provider entry")
      _gufo_entry_symbol("${entry}")
      if(NOT capability MATCHES "^(text_generation|embeddings|speech_recognition|speech_synthesis|image_generation|video_generation)$")
        message(FATAL_ERROR "extension metadata: unknown capability ${capability}")
      endif()
      get_property(owner GLOBAL PROPERTY "GUFO_EXT_PROVIDER_${id}" SET)
      if(owner)
        message(FATAL_ERROR "extension metadata: duplicate provider ID ${id}")
      endif()
      set_property(GLOBAL PROPERTY "GUFO_EXT_PROVIDER_${id}" "${name}")
      if(NOT target IN_LIST target_names)
        message(FATAL_ERROR "extension metadata: missing provider target ${target}")
      endif()
      get_property(role GLOBAL PROPERTY "GUFO_EXT_TARGET_${target}_ROLE")
      if(NOT role STREQUAL library)
        message(FATAL_ERROR "extension metadata: provider target must be a library")
      endif()
      _gufo_strings(keys "${providers}" ${i} keys)
      if("${keys}" STREQUAL "")
        message(FATAL_ERROR "extension metadata: provider keys cannot be empty")
      endif()
      foreach(key IN LISTS keys)
        if(NOT key MATCHES "^(gguf|safetensors|manifest|diffusers):.+$")
          message(FATAL_ERROR "extension metadata: unsupported artifact key ${key}")
        endif()
      endforeach()
      foreach(optional model_ids speculative)
        string(JSON ignored ERROR_VARIABLE error TYPE "${providers}" ${i} ${optional})
        if(NOT error)
          _gufo_strings(ignored "${providers}" ${i} ${optional})
        endif()
      endforeach()
      string(REPLACE "-" "_" identifier "${id}")
      if(identifier IN_LIST provider_identifiers)
        message(FATAL_ERROR "extension metadata: colliding generated provider identifier ${id}")
      endif()
      list(APPEND provider_identifiers "${identifier}")
      list(APPEND provider_ids "${id}")
    endforeach()
  else()
    foreach(field entry registration_target providers options)
      string(JSON ignored ERROR_VARIABLE error TYPE "${json}" ${field})
      if(NOT error AND NOT (field STREQUAL providers AND ignored STREQUAL ARRAY))
        message(FATAL_ERROR "extension metadata: library cannot declare ${field}")
      endif()
      if(NOT error AND field STREQUAL providers)
        string(JSON length LENGTH "${json}" providers)
        if(length GREATER 0)
          message(FATAL_ERROR "extension metadata: library cannot declare providers")
        endif()
      endif()
    endforeach()
  endif()
  file(STRINGS "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../include/gufo/ext/core_options.def" core_lines REGEX "^GUFO_CORE_OPTION")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../include/gufo/ext/core_options.def")
  string(JSON options_type ERROR_VARIABLE error TYPE "${json}" options)
  if(NOT error)
    _gufo_json(options "${json}" ARRAY options)
    string(JSON count LENGTH "${options}")
    if(count GREATER 0)
      math(EXPR last "${count}-1")
      set(local_options)
      foreach(i RANGE ${last})
        _gufo_json(option "${options}" STRING ${i} name)
        _gufo_identifier("${option}" "^--[a-z][a-z0-9-]*$" "option name")
        if("GUFO_CORE_OPTION(\"${option}\")" IN_LIST core_lines)
          message(FATAL_ERROR "extension metadata: core-owned option ${option}")
        endif()
        _gufo_json(type "${options}" STRING ${i} type)
        if(NOT type MATCHES "^(boolean|integer|number|string|path)$")
          message(FATAL_ERROR "extension metadata: invalid option type ${type}")
        endif()
        _gufo_strings(commands "${options}" ${i} commands)
        if("${commands}" STREQUAL "")
          message(FATAL_ERROR "extension metadata: option commands cannot be empty")
        endif()
        foreach(command IN LISTS commands)
          string(SHA256 key "${command}:${option}")
          get_property(previous GLOBAL PROPERTY "GUFO_EXT_OPTION_${key}")
          if(NOT "${previous}" STREQUAL "" AND NOT previous STREQUAL type)
            message(FATAL_ERROR "extension metadata: conflicting option types for ${option} in ${command}")
          endif()
          if(key IN_LIST local_options)
            message(FATAL_ERROR "extension metadata: duplicate option declaration ${option} in ${command}")
          endif()
          list(APPEND local_options "${key}")
          set_property(GLOBAL PROPERTY "GUFO_EXT_OPTION_${key}" "${type}")
        endforeach()
        string(JSON ignored ERROR_VARIABLE error TYPE "${options}" ${i} providers)
        if(NOT error)
          _gufo_strings(selected "${options}" ${i} providers)
          if("${selected}" STREQUAL "")
            message(FATAL_ERROR "extension metadata: option providers cannot be empty")
          endif()
          foreach(id IN LISTS selected)
            if(NOT id IN_LIST provider_ids)
              message(FATAL_ERROR "extension metadata: option references missing provider ${id}")
            endif()
          endforeach()
        endif()
      endforeach()
    endif()
  endif()
  get_filename_component(root "${manifest}" DIRECTORY)
  set_property(GLOBAL PROPERTY "GUFO_EXT_${name}_METADATA_ONLY" "${GUFO_EXTENSION_METADATA_ONLY}")
  set_property(GLOBAL APPEND PROPERTY GUFO_EXTENSION_NAMES "${name}")
  set_property(GLOBAL PROPERTY "GUFO_EXT_${name}_JSON" "${json}")
  set_property(GLOBAL PROPERTY "GUFO_EXT_${name}_ROOT" "${root}")
  set_property(GLOBAL PROPERTY "GUFO_EXT_${name}_DEPENDS" "${depends}")
  set_property(GLOBAL PROPERTY "GUFO_EXT_${name}_TARGETS" "${target_names}")
endfunction()

function(_gufo_visit name)
  get_property(metadata_only GLOBAL PROPERTY "GUFO_EXT_${name}_METADATA_ONLY")
  if(metadata_only)
    get_property(state GLOBAL PROPERTY "GUFO_EXT_${name}_VISIT")
    if(NOT state STREQUAL done)
      set_property(GLOBAL PROPERTY "GUFO_EXT_${name}_VISIT" done)
      set_property(GLOBAL APPEND PROPERTY GUFO_EXTENSION_ORDER "${name}")
    endif()
    return()
  endif()
  get_property(state GLOBAL PROPERTY "GUFO_EXT_${name}_VISIT")
  if(state STREQUAL visiting)
    message(FATAL_ERROR "extension metadata: cyclic dependency at ${name}")
  elseif(state STREQUAL done)
    return()
  endif()
  set_property(GLOBAL PROPERTY "GUFO_EXT_${name}_VISIT" visiting)
  get_property(names GLOBAL PROPERTY GUFO_EXTENSION_NAMES)
  get_property(depends GLOBAL PROPERTY "GUFO_EXT_${name}_DEPENDS")
  list(SORT depends)
  foreach(dependency IN LISTS depends)
    if(NOT dependency IN_LIST names)
      message(FATAL_ERROR "extension metadata: missing dependency ${dependency} required by ${name}")
    endif()
    get_property(parent_json GLOBAL PROPERTY "GUFO_EXT_${name}_JSON")
    get_property(dependency_json GLOBAL PROPERTY "GUFO_EXT_${dependency}_JSON")
    _gufo_strings(parent_platforms "${parent_json}" platforms)
    _gufo_strings(dependency_platforms "${dependency_json}" platforms)
    foreach(platform IN LISTS parent_platforms)
      if(NOT platform IN_LIST dependency_platforms)
        message(FATAL_ERROR "extension metadata: unsatisfiable dependency platforms: ${name} needs ${dependency} on ${platform}")
      endif()
    endforeach()
    _gufo_visit("${dependency}")
  endforeach()
  set_property(GLOBAL PROPERTY "GUFO_EXT_${name}_VISIT" done)
  set_property(GLOBAL APPEND PROPERTY GUFO_EXTENSION_ORDER "${name}")
endfunction()
function(gufo_extensions_validate)
  get_property(names GLOBAL PROPERTY GUFO_EXTENSION_NAMES)
  set_property(GLOBAL PROPERTY GUFO_EXTENSION_ORDER "")
  foreach(name IN LISTS names)
    set_property(GLOBAL PROPERTY "GUFO_EXT_${name}_VISIT" "")
  endforeach()
  list(SORT names)
  foreach(name IN LISTS names)
    _gufo_visit("${name}")
  endforeach()
endfunction()

# Build manifests call this once for each declared target. Disabled targets do
# not exist and cannot leak factory references through generated registration.
function(gufo_extension_target)
  cmake_parse_arguments(ARG "" "NAME" "SOURCES;LINK_LIBRARIES" ${ARGN})
  get_property(owner GLOBAL PROPERTY "GUFO_EXT_TARGET_${ARG_NAME}_OWNER" SET)
  if(NOT owner OR NOT "${ARG_UNPARSED_ARGUMENTS}" STREQUAL "")
    message(FATAL_ERROR "gufo_extension_target: undeclared target ${ARG_NAME}")
  endif()
  get_property(created GLOBAL PROPERTY "GUFO_EXT_TARGET_${ARG_NAME}_CREATED")
  if(created)
    message(FATAL_ERROR "gufo_extension_target: duplicate target definition ${ARG_NAME}")
  endif()
  set_property(GLOBAL PROPERTY "GUFO_EXT_TARGET_${ARG_NAME}_CREATED" TRUE)
  get_property(enabled GLOBAL PROPERTY "GUFO_EXT_TARGET_${ARG_NAME}_ENABLED")
  if(NOT enabled)
    return()
  endif()
  get_property(role GLOBAL PROPERTY "GUFO_EXT_TARGET_${ARG_NAME}_ROLE")
  if(DEFINED GUFO_EXTENSION_BUILD_ROOT)
    set(sources)
    foreach(source IN LISTS ARG_SOURCES)
      get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${GUFO_EXTENSION_BUILD_ROOT}")
      list(APPEND sources "${source}")
    endforeach()
    set(ARG_SOURCES "${sources}")
  endif()
  if(role STREQUAL test)
    add_executable(${ARG_NAME} ${ARG_SOURCES})
  else()
    add_library(${ARG_NAME} STATIC ${ARG_SOURCES})
  endif()
  foreach(dependency IN LISTS ARG_LINK_LIBRARIES)
    get_property(declared GLOBAL PROPERTY "GUFO_EXT_TARGET_${dependency}_OWNER" SET)
    if(declared)
      get_property(available GLOBAL PROPERTY "GUFO_EXT_TARGET_${dependency}_ENABLED")
      get_property(owner GLOBAL PROPERTY "GUFO_EXT_TARGET_${dependency}_OWNER")
      get_property(selection_set GLOBAL PROPERTY GUFO_SELECTED_EXTENSIONS SET)
      get_property(selected GLOBAL PROPERTY GUFO_SELECTED_EXTENSIONS)
      if(NOT available OR (selection_set AND NOT owner IN_LIST selected))
        message(FATAL_ERROR "extension target ${ARG_NAME} requires unavailable dependency ${dependency} (${owner})")
      endif()
    endif()
  endforeach()
  target_link_libraries(${ARG_NAME} PRIVATE ${ARG_LINK_LIBRARIES})
  target_compile_features(${ARG_NAME} PUBLIC cxx_std_20)
  # Directory test assertions must not silently change production libraries.
  get_target_property(inherited ${ARG_NAME} COMPILE_OPTIONS)
  if(inherited)
    list(REMOVE_ITEM inherited -UNDEBUG /UNDEBUG)
    set_property(TARGET ${ARG_NAME} PROPERTY COMPILE_OPTIONS "${inherited}")
  endif()
  if(CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
    if(NOT DEFINED GUFO_ENABLE_WARNINGS OR GUFO_ENABLE_WARNINGS)
      target_compile_options(${ARG_NAME} PRIVATE /W4)
    endif()
    if(role STREQUAL test)
      target_compile_options(${ARG_NAME} PRIVATE /UNDEBUG)
    endif()
  elseif(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    if(NOT DEFINED GUFO_ENABLE_WARNINGS OR GUFO_ENABLE_WARNINGS)
      target_compile_options(${ARG_NAME} PRIVATE -Wall -Wextra -Wpedantic)
    endif()
    if(role STREQUAL test)
      target_compile_options(${ARG_NAME} PRIVATE -UNDEBUG)
    endif()
  endif()
  # Match the host's configured sanitizers without relying on creation order.
  if(GUFO_ENABLE_SANITIZERS AND CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    target_compile_options(${ARG_NAME} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
    target_link_options(${ARG_NAME} PUBLIC -fsanitize=address,undefined)
  endif()
endfunction()

function(gufo_extension_hip_sources target)
  cmake_parse_arguments(ARG "" "" "SOURCES;OPTIONS;DEFINITIONS" ${ARGN})
  if(NOT TARGET ${target})
    return()
  endif()
  get_property(requires GLOBAL PROPERTY "GUFO_EXT_TARGET_${target}_REQUIRES")
  if(NOT hip IN_LIST requires OR NOT ENGINE_ENABLE_HIP)
    message(FATAL_ERROR "gufo_extension_hip_sources requires a HIP target")
  endif()
  if(DEFINED GUFO_EXTENSION_BUILD_ROOT)
    set(sources)
    foreach(source IN LISTS ARG_SOURCES)
      get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${GUFO_EXTENSION_BUILD_ROOT}")
      list(APPEND sources "${source}")
    endforeach()
    set(ARG_SOURCES "${sources}")
  endif()
  target_sources(${target} PRIVATE ${ARG_SOURCES})
  set_source_files_properties(${ARG_SOURCES} PROPERTIES LANGUAGE HIP)
  foreach(source IN LISTS ARG_SOURCES)
    set_property(SOURCE "${source}" APPEND PROPERTY COMPILE_OPTIONS ${ARG_OPTIONS})
    set_property(SOURCE "${source}" APPEND PROPERTY COMPILE_DEFINITIONS ${ARG_DEFINITIONS})
  endforeach()
endfunction()

function(_gufo_write_if_different path content)
  if(EXISTS "${path}")
    file(READ "${path}" previous)
    if(previous STREQUAL content)
      return()
    endif()
  endif()
  # Unlike file(CONFIGURE), metadata containing @NAME@ stays literal data.
  file(WRITE "${path}" "${content}")
endfunction()

function(_gufo_cpp_strings out)
  set(result "{")
  foreach(value IN LISTS ARGN)
    string(APPEND result "\"${value}\",")
  endforeach()
  string(APPEND result "}")
  set(${out} "${result}" PARENT_SCOPE)
endfunction()
function(_gufo_provider_constant out json index enabled reason)
  string(JSON provider GET "${json}" providers ${index})
  _gufo_json(id "${provider}" STRING id)
  _gufo_json(capability "${provider}" STRING capability)
  set(capability_text_generation kTextGeneration)
  set(capability_embeddings kEmbeddings)
  set(capability_speech_recognition kSpeechRecognition)
  set(capability_speech_synthesis kSpeechSynthesis)
  set(capability_image_generation kImageGeneration)
  set(capability_video_generation kVideoGeneration)
  foreach(field keys model_ids speculative)
    _gufo_optional(array "${provider}" ${field} "[]")
    _gufo_strings(values "${array}")
    _gufo_cpp_strings(${field} ${values})
  endforeach()
  set(option_values "{")
  _gufo_optional(options "${json}" options "[]")
  string(JSON count LENGTH "${options}")
  if(count GREATER 0)
    math(EXPR last "${count}-1")
    foreach(i RANGE ${last})
      string(JSON option GET "${options}" ${i})
      _gufo_optional(selected "${option}" providers "[]")
      _gufo_strings(ids "${selected}")
      if(NOT "${ids}" STREQUAL "" AND NOT id IN_LIST ids)
        continue()
      endif()
      _gufo_json(name "${option}" STRING name)
      _gufo_json(type "${option}" STRING type)
      _gufo_strings(commands "${option}" commands)
      _gufo_cpp_strings(commands_cpp ${commands})
      _gufo_optional(help "${option}" help "")
      # Help is free text; escape for generated C++ rather than interpreting it.
      string(REPLACE "\\" "\\\\" help "${help}")
      string(REPLACE "\"" "\\\"" help "${help}")
      string(REPLACE "\n" "\\n" help "${help}")
      string(REPLACE "\r" "\\r" help "${help}")
      set(type_boolean kBoolean)
      set(type_integer kInteger)
      set(type_number kNumber)
      set(type_string kString)
      set(type_path kPath)
      string(APPEND option_values "{\"${name}\", OptionType::${type_${type}}, ${commands_cpp}, \"${help}\"},")
    endforeach()
  endif()
  string(APPEND option_values "}")
  if(enabled)
    set(available true)
  else()
    set(available false)
  endif()
  set(${out} "{.id=\"${id}\", .capability=Capability::${capability_${capability}}, .keys=${keys}, .model_ids=${model_ids}, .speculative=${speculative}, .options=${option_values}, .available=${available}, .unavailable_reason=\"${reason}\", .extension=\"\"}" PARENT_SCOPE)
endfunction()

# Generate a registry per executable. No process-global constructors or implicit
# whole-archive links are used. The provider entry lives with its actual factory;
# an unavailable provider produces metadata only and no declaration/reference.
function(gufo_target_extensions target)
  cmake_parse_arguments(ARG "" "" "EXTENSIONS" ${ARGN})
  if(NOT TARGET ${target} OR NOT "${ARG_UNPARSED_ARGUMENTS}" STREQUAL "")
    message(FATAL_ERROR "gufo_target_extensions requires an existing target")
  endif()
  gufo_extensions_validate()
  get_property(names GLOBAL PROPERTY GUFO_EXTENSION_NAMES)
  get_property(order GLOBAL PROPERTY GUFO_EXTENSION_ORDER)
  foreach(name IN LISTS ARG_EXTENSIONS)
    if(NOT name IN_LIST names)
      message(FATAL_ERROR "registry: unknown extension ${name}")
    endif()
    get_property(depends GLOBAL PROPERTY "GUFO_EXT_${name}_DEPENDS")
    foreach(dependency IN LISTS depends)
      if(NOT dependency IN_LIST ARG_EXTENSIONS)
        message(FATAL_ERROR "registry: missing selected dependency ${dependency} for ${name}")
      endif()
    endforeach()
  endforeach()
  set(directory "${CMAKE_CURRENT_BINARY_DIR}/extensions/${target}")
  file(MAKE_DIRECTORY "${directory}/gufo/ext/generated")
  set(declarations "// Generated. Do not edit.\n#include <gufo/ext/registry.hpp>\n")
  set(body "void gufo::ext::RegisterBuiltExtensions(Registry& registry) {\n  (void)registry;\n")
  foreach(name IN LISTS order)
    if(NOT name IN_LIST ARG_EXTENSIONS)
      continue()
    endif()
    get_property(json GLOBAL PROPERTY "GUFO_EXT_${name}_JSON")
    get_property(root GLOBAL PROPERTY "GUFO_EXT_${name}_ROOT")
    get_property(targets GLOBAL PROPERTY "GUFO_EXT_${name}_TARGETS")
    foreach(library IN LISTS targets)
      get_property(enabled GLOBAL PROPERTY "GUFO_EXT_TARGET_${library}_ENABLED")
      get_property(created GLOBAL PROPERTY "GUFO_EXT_TARGET_${library}_CREATED")
      if(NOT created)
        message(FATAL_ERROR "registry: declared target ${library} was not defined by gufo_extension_target")
      endif()
      if(enabled AND NOT TARGET ${library})
        message(FATAL_ERROR "registry: missing enabled target ${library}")
      endif()
    endforeach()
    _gufo_optional(kind "${json}" kind extension)
    if(kind STREQUAL library)
      _gufo_json(version "${json}" STRING version)
      file(RELATIVE_PATH source "${PROJECT_SOURCE_DIR}" "${root}")
      string(APPEND body "  registry.BeginExtension({\"${name}\", \"${version}\", \"${source}\"});\n")
      continue()
    endif()
    _gufo_json(entry "${json}" STRING entry)
    _gufo_json(registration_target "${json}" STRING registration_target)
    _gufo_json(version "${json}" STRING version)
    get_property(enabled GLOBAL PROPERTY "GUFO_EXT_TARGET_${registration_target}_ENABLED")
    if(NOT enabled)
      message(FATAL_ERROR "registry: extension ${name} is not supported on this platform")
    endif()
    file(RELATIVE_PATH source "${PROJECT_SOURCE_DIR}" "${root}")
    string(REPLACE "\\" "/" source "${source}")
    string(REPLACE "\"" "\\\"" source "${source}")
    string(APPEND declarations "#include <gufo/ext/generated/${name}_constants.hpp>\nvoid ${entry}(gufo::ext::Registry&);\n")
    string(APPEND body "  registry.BeginExtension({\"${name}\", \"${version}\", \"${source}\"});\n  ::${entry}(registry);\n")
    target_link_libraries(${target} PRIVATE ${registration_target})
    set(constants "// Generated. Do not edit.\n#pragma once\n#include <gufo/ext/registry.hpp>\nnamespace gufo::ext::generated::extension_${name} {\n")
    string(JSON count LENGTH "${json}" providers)
    math(EXPR last "${count}-1")
    foreach(i RANGE ${last})
      _gufo_json(provider_target "${json}" STRING providers ${i} target)
      _gufo_json(provider_entry "${json}" STRING providers ${i} entry)
      _gufo_json(id "${json}" STRING providers ${i} id)
      string(REPLACE "-" "_" identifier "${id}")
      get_property(enabled GLOBAL PROPERTY "GUFO_EXT_TARGET_${provider_target}_ENABLED")
      get_property(requires GLOBAL PROPERTY "GUFO_EXT_TARGET_${provider_target}_REQUIRES")
      if(enabled)
        set(reason "")
      else()
        string(JOIN ", " conditions ${requires})
        set(reason "requires ${conditions}")
      endif()
      _gufo_provider_constant(value "${json}" ${i} "${enabled}" "${reason}")
      string(APPEND constants "inline const ProviderInfo kProvider_${identifier} = ${value};\n")
      if(enabled)
        string(APPEND declarations "void ${provider_entry}(gufo::ext::Registry&);\n")
        string(APPEND body "  ::${provider_entry}(registry);\n")
        target_link_libraries(${target} PRIVATE ${provider_target})
      else()
        string(APPEND body "  registry.AddProvider(gufo::ext::generated::extension_${name}::kProvider_${identifier});\n")
      endif()
      target_include_directories(${registration_target} PRIVATE "${directory}")
      if(enabled)
        target_include_directories(${provider_target} PRIVATE "${directory}")
      endif()
    endforeach()
    string(APPEND constants "}\n")
    _gufo_write_if_different("${directory}/gufo/ext/generated/${name}_constants.hpp" "${constants}")
  endforeach()
  get_property(mode GLOBAL PROPERTY GUFO_EXTENSION_SELECTION_MODE)
  if("${mode}" STREQUAL "")
    set(mode explicit)
  endif()
  get_property(excluded GLOBAL PROPERTY GUFO_EXCLUDED_EXTENSIONS)
  foreach(name IN LISTS excluded)
    get_property(json GLOBAL PROPERTY "GUFO_EXT_${name}_JSON")
    get_property(root GLOBAL PROPERTY "GUFO_EXT_${name}_ROOT")
    get_property(reason GLOBAL PROPERTY "GUFO_EXT_${name}_EXCLUDED_REASON")
    _gufo_json(version "${json}" STRING version)
    file(RELATIVE_PATH source "${PROJECT_SOURCE_DIR}" "${root}")
    foreach(field keys model_ids options)
      _gufo_extension_values(values "${json}" "${field}")
      _gufo_cpp_strings(${field} ${values})
    endforeach()
    string(APPEND body "  registry.AddExcluded({{\"${name}\", \"${version}\", \"${source}\"}, ${keys}, ${model_ids}, ${options}, \"${reason}\"});\n")
  endforeach()
  string(APPEND body "}\nstd::string_view gufo::ext::ExtensionSelectionMode() { return \"${mode}\"; }\n")
  _gufo_write_if_different("${directory}/extension_registry.cpp" "${declarations}\n${body}")
  target_sources(${target} PRIVATE "${directory}/extension_registry.cpp")
  target_include_directories(${target} PRIVATE "${directory}")
  target_link_libraries(${target} PRIVATE gufo_ext_runtime)
endfunction()
