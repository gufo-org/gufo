# cmake -DNM=<llvm-nm> -DOUTPUT=<file.def> -DARCHIVES=<a.lib|b.lib> -P <this>
# Writes the exports of Gufo's own symbols (MSVC names containing `@gufo@@`).
string(REPLACE "|" ";" archives "${ARCHIVES}")
set(functions)
set(data)
foreach(archive IN LISTS archives)
  execute_process(COMMAND "${NM}" --defined-only --extern-only --format=posix
      --no-sort "${archive}"
    OUTPUT_VARIABLE symbols RESULT_VARIABLE result ERROR_VARIABLE error)
  if(result)
    message(FATAL_ERROR "llvm-nm ${archive} failed: ${error}")
  endif()
  string(REPLACE ";" "\;" symbols "${symbols}")
  string(REGEX MATCHALL "[^\n]*@gufo@@[^\n]*" lines "${symbols}")
  foreach(line IN LISTS lines)
    if(line MATCHES "^([^ ]+) ([A-Za-z]) ")
      set(name "${CMAKE_MATCH_1}")
      set(type "${CMAKE_MATCH_2}")
      if(type MATCHES "^[TW]$")
        list(APPEND functions "${name}")
      elseif(type MATCHES "^[DBRV]$")
        list(APPEND data "${name}")
      endif()
    endif()
  endforeach()
endforeach()
list(REMOVE_DUPLICATES functions)
list(REMOVE_DUPLICATES data)
list(REMOVE_ITEM functions ${data})
list(LENGTH functions function_count)
list(LENGTH data data_count)
math(EXPR total "${function_count}+${data_count}")
if(total GREATER 65535)
  message(FATAL_ERROR "${total} Gufo symbols exceed the Windows limit of 65535 exports")
endif()
set(text "EXPORTS\n")
foreach(name IN LISTS functions)
  string(APPEND text "  ${name}\n")
endforeach()
foreach(name IN LISTS data)
  string(APPEND text "  ${name} DATA\n")
endforeach()
file(WRITE "${OUTPUT}" "${text}")
message(STATUS "Exported ${function_count} functions and ${data_count} data symbols")
