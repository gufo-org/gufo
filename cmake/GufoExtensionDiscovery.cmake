include_guard(GLOBAL)
include(${CMAKE_CURRENT_LIST_DIR}/GufoExtension.cmake)

# Both selectors are exact sets, including family dependencies. '*' is the
# default discovery mode; an explicit empty list deliberately selects none.
set(GUFO_EXTENSIONS "*" CACHE STRING "Exact extension list, or * for all supported discovered extensions")
option(GUFO_EXTENSIONS_FROM_LOCK "Select official extensions.lock instead of discovery" OFF)
set(GUFO_EXTENSION_DIRS "" CACHE STRING "Semicolon-separated list of external extension root directories")
set(GUFO_EXTENSION_MODULES "" CACHE STRING "Selected extensions built as loadable modules instead of linked into gufo")

function(_gufo_extension_lock out path)
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "extension lock: missing ${path}")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
  file(READ "${path}" json)
  _gufo_reject_nul("${json}")
  _gufo_json(schema "${json}" NUMBER schema)
  if(NOT schema EQUAL 1)
    message(FATAL_ERROR "extension lock: unsupported schema ${schema}")
  endif()
  _gufo_strings(names "${json}" extensions)
  string(JSON count LENGTH "${json}")
  if(NOT count EQUAL 2)
    message(FATAL_ERROR "extension lock: only schema and extensions are supported")
  endif()
  foreach(name IN LISTS names)
    _gufo_identifier("${name}" "^[a-z][a-z0-9_]*$" "locked extension name")
  endforeach()
  set(${out} "${names}" PARENT_SCOPE)
endfunction()

function(gufo_discover_extensions)
  # Deliberately before dependency discovery in the root; platform-only has
  # returned before reaching this function.
  file(GLOB manifests CONFIGURE_DEPENDS
    "${PROJECT_SOURCE_DIR}/src/models/*/extension.json"
    "${PROJECT_SOURCE_DIR}/src/families/*/*/extension.json")
  if(GUFO_EXTENSION_DIRS)
    foreach(ext_dir IN LISTS GUFO_EXTENSION_DIRS)
      if(NOT IS_ABSOLUTE "${ext_dir}")
        get_filename_component(ext_dir "${ext_dir}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}")
      endif()
      if(EXISTS "${ext_dir}/extension.json")
        list(APPEND manifests "${ext_dir}/extension.json")
        set_property(GLOBAL PROPERTY "GUFO_EXT_EXTERNAL_DIR_${ext_dir}" TRUE)
      else()
        file(GLOB sub_manifests CONFIGURE_DEPENDS "${ext_dir}/*/extension.json")
        foreach(sub_m IN LISTS sub_manifests)
          cmake_path(GET sub_m PARENT_PATH sub_root)
          set_property(GLOBAL PROPERTY "GUFO_EXT_EXTERNAL_DIR_${sub_root}" TRUE)
          list(APPEND manifests "${sub_m}")
        endforeach()
      endif()
    endforeach()
  endif()
  list(REMOVE_DUPLICATES manifests)
  list(SORT manifests)
  _gufo_extension_lock(locked "${PROJECT_SOURCE_DIR}/extensions.lock")
  if(GUFO_EXTENSIONS_FROM_LOCK AND NOT GUFO_EXTENSIONS STREQUAL "*")
    message(FATAL_ERROR "GUFO_EXTENSIONS_FROM_LOCK conflicts with explicit GUFO_EXTENSIONS")
  endif()
  foreach(manifest IN LISTS manifests)
    file(READ "${manifest}" identity)
    _gufo_reject_nul("${identity}")
    _gufo_json(name "${identity}" STRING name)
    _gufo_strings(platforms "${identity}" platforms)
    string(TOLOWER "${CMAKE_SYSTEM_NAME}" system)
    cmake_path(GET manifest PARENT_PATH root)
    get_property(is_ext_dir GLOBAL PROPERTY "GUFO_EXT_EXTERNAL_DIR_${root}")
    if(is_ext_dir OR NOT "${root}" MATCHES "^${PROJECT_SOURCE_DIR}/")
      set_property(GLOBAL PROPERTY "GUFO_EXT_${name}_IS_EXTERNAL" TRUE)
    endif()
    set(has_cmake FALSE)
    if(EXISTS "${root}/extension.cmake")
      set(has_cmake TRUE)
    endif()
    set_property(GLOBAL PROPERTY "GUFO_EXT_${name}_HAS_CMAKE" "${has_cmake}")
    set(GUFO_EXTENSION_METADATA_ONLY FALSE)
    if((GUFO_EXTENSIONS_FROM_LOCK AND NOT name IN_LIST locked) OR
       (NOT GUFO_EXTENSIONS_FROM_LOCK AND NOT GUFO_EXTENSIONS STREQUAL "*" AND NOT name IN_LIST GUFO_EXTENSIONS) OR
       (NOT system IN_LIST platforms) OR
       (NOT has_cmake))
      set(GUFO_EXTENSION_METADATA_ONLY TRUE)
    endif()
    gufo_extension(MANIFEST "${manifest}")
  endforeach()
  gufo_extensions_validate()
  get_property(names GLOBAL PROPERTY GUFO_EXTENSION_ORDER)
  # The lock read once above is reused: it is the same file and the same
  # configure, so a second read would only duplicate CMAKE_CONFIGURE_DEPENDS.
  foreach(name IN LISTS locked)
    if(NOT name IN_LIST names)
      message(FATAL_ERROR "extension lock: unknown extension ${name}")
    endif()
    get_property(depends GLOBAL PROPERTY "GUFO_EXT_${name}_DEPENDS")
    foreach(dependency IN LISTS depends)
      if(NOT dependency IN_LIST locked)
        message(FATAL_ERROR "extension lock: missing dependency ${dependency} required by ${name}")
      endif()
    endforeach()
  endforeach()
  if(GUFO_EXTENSIONS_FROM_LOCK)
    set(selected "${locked}")
    set(mode lock)
  elseif(GUFO_EXTENSIONS STREQUAL "*")
    set(selected)
    foreach(name IN LISTS names)
      get_property(has_cmake GLOBAL PROPERTY "GUFO_EXT_${name}_HAS_CMAKE")
      if(has_cmake)
        list(APPEND selected "${name}")
      endif()
    endforeach()
    set(mode discovery)
  else()
    set(selected "${GUFO_EXTENSIONS}")
    set(mode explicit)
  endif()
  set(unique "${selected}")
  list(REMOVE_DUPLICATES unique)
  if(NOT "${unique}" STREQUAL "${selected}")
    message(FATAL_ERROR "GUFO_EXTENSIONS contains duplicate names")
  endif()
  foreach(name IN LISTS selected)
    if(name STREQUAL "")
      # A stray ';' is a malformed selector, not a name that was not found.
      # An explicitly empty GUFO_EXTENSIONS is legal and never reaches here.
      message(FATAL_ERROR "GUFO_EXTENSIONS contains an empty entry (stray ';'): ${selected}")
    endif()
    if(NOT name IN_LIST names)
      message(FATAL_ERROR "GUFO_EXTENSIONS: unknown extension ${name}; discovered: ${names}")
    endif()
  endforeach()
  string(TOLOWER "${CMAKE_SYSTEM_NAME}" system)
  set(excluded)
  foreach(name IN LISTS names)
    get_property(json GLOBAL PROPERTY "GUFO_EXT_${name}_JSON")
    _gufo_strings(platforms "${json}" platforms)
    get_property(has_cmake GLOBAL PROPERTY "GUFO_EXT_${name}_HAS_CMAKE")
    if(NOT system IN_LIST platforms)
      if(name IN_LIST selected AND NOT mode STREQUAL discovery)
        message(FATAL_ERROR "extension ${name} is unavailable on ${system}")
      endif()
      list(REMOVE_ITEM selected "${name}")
      set(reason "unsupported platform ${system}")
    elseif(NOT has_cmake)
      set(reason "metadata only")
    else()
      set(reason "not selected in ${mode} mode")
    endif()
    if(NOT name IN_LIST selected)
      list(APPEND excluded "${name}")
      set_property(GLOBAL PROPERTY "GUFO_EXT_${name}_EXCLUDED_REASON" "${reason}")
    endif()
  endforeach()
  foreach(name IN LISTS selected)
    get_property(depends GLOBAL PROPERTY "GUFO_EXT_${name}_DEPENDS")
    foreach(dependency IN LISTS depends)
      if(NOT dependency IN_LIST selected)
        message(FATAL_ERROR "GUFO_EXTENSIONS: missing selected dependency ${dependency} required by ${name}")
      endif()
    endforeach()
  endforeach()
  # Unshipped metadata may not change the shipped key/option/model-ID space.
  # This safety check is independent of the configured selection. It is not
  # evidence of release/default HIP behavior or timing equivalence.
  foreach(name IN LISTS names)
    if(name IN_LIST locked)
      set(tier shipped)
    else()
      set(tier unshipped)
      message(STATUS "gufo: unshipped discovered extension ${name}")
    endif()
    get_property(json GLOBAL PROPERTY "GUFO_EXT_${name}_JSON")
    foreach(field keys model_ids)
      _gufo_extension_values(values "${json}" "${field}")
      foreach(value IN LISTS values)
        string(SHA256 key "${field}:${value}")
        if(tier STREQUAL shipped)
          set(other unshipped)
        else()
          set(other shipped)
        endif()
        # Report before recording, and keep the first recorded owner per tier, so
        # the diagnostic names the extension that actually holds the value. Two
        # extensions in the same tier may share an artifact key: overlapping keys
        # are resolved by probes later. Provider IDs and entry symbols may not
        # collide (GufoExtension.cmake); that fails elsewhere, not here. Options
        # are absent because any extensions may share one name with one type,
        # such as a draft model path; GufoExtension.cmake and
        # Registry::AddProvider reject disagreeing types.
        get_property(other_owner GLOBAL PROPERTY "GUFO_DISCOVERY_${key}_${other}")
        if(other_owner)
          message(FATAL_ERROR "gufo: shipped/unshipped ${field} collision '${value}' (${other_owner}, ${name})")
        endif()
        get_property(holder GLOBAL PROPERTY "GUFO_DISCOVERY_${key}_${tier}")
        if(NOT holder)
          set_property(GLOBAL PROPERTY "GUFO_DISCOVERY_${key}_${tier}" "${name}")
        endif()
      endforeach()
    endforeach()
  endforeach()
  set(ordered_selected)
  foreach(name IN LISTS names)
    if(name IN_LIST selected)
      list(APPEND ordered_selected "${name}")
    endif()
  endforeach()
  set(selected "${ordered_selected}")
  list(SORT excluded)
  set_property(GLOBAL PROPERTY GUFO_SELECTED_EXTENSIONS "${selected}")
  set_property(GLOBAL PROPERTY GUFO_EXCLUDED_EXTENSIONS "${excluded}")
  set_property(GLOBAL PROPERTY GUFO_EXTENSION_SELECTION_MODE "${mode}")
  message(STATUS "gufo: extension mode=${mode}; included=[${selected}]; excluded=[${excluded}]")
endfunction()

function(_gufo_extension_values out json field)
  set(values)
  if(field STREQUAL options)
    _gufo_optional(options "${json}" options "[]")
    string(JSON count LENGTH "${options}")
    if(count GREATER 0)
      math(EXPR last "${count}-1")
      foreach(i RANGE ${last})
        _gufo_json(value "${options}" STRING ${i} name)
        list(APPEND values "${value}")
      endforeach()
    endif()
  else()
    _gufo_optional(providers "${json}" providers "[]")
    string(JSON count LENGTH "${providers}")
    if(count GREATER 0)
      math(EXPR last "${count}-1")
      foreach(i RANGE ${last})
        string(JSON provider GET "${providers}" ${i})
        _gufo_optional(array "${provider}" "${field}" "[]")
        _gufo_strings(items "${array}")
        list(APPEND values ${items})
      endforeach()
    endif()
  endif()
  list(REMOVE_DUPLICATES values)
  list(SORT values)
  set(${out} "${values}" PARENT_SCOPE)
endfunction()

# CMake cannot evaluate arbitrary generator expressions during configuration.
# Inspect build/link wrappers recursively; fail closed on everything else.
function(_gufo_external_items out tgt)
  set(items)
  foreach(item IN LISTS ARGN)
    if(item MATCHES "^\\$<(BUILD_INTERFACE|LINK_ONLY|COMPILE_ONLY):(.*)>$")
      _gufo_external_items(nested "${tgt}" "${CMAKE_MATCH_2}")
      list(APPEND items ${nested})
    elseif(item MATCHES "^\\$<\\$<(CONFIG|COMPILE_LANGUAGE|COMPILE_LANG_AND_ID|PLATFORM_ID|CXX_COMPILER_ID):[^<>]+>:(.*)>$")
      # Validate the payload in every configuration/language, independently
      # of which branch the current generator will select.
      _gufo_external_items(nested "${tgt}" "${CMAKE_MATCH_2}")
      list(APPEND items ${nested})
    elseif(item MATCHES "^\\$<INSTALL_INTERFACE:.*>$")
      continue()
    elseif(item MATCHES "\\$<")
      message(FATAL_ERROR "external extension target ${tgt} has unvalidated generator expression '${item}'")
    else()
      list(APPEND items "${item}")
    endif()
  endforeach()
  set(${out} "${items}" PARENT_SCOPE)
endfunction()

function(_gufo_external_path tgt path base)
  if(NOT path)
    return()
  endif()
  cmake_path(ABSOLUTE_PATH path BASE_DIRECTORY "${base}" NORMALIZE)
  # Resolve aliases through symlinks as well as lexical ../ components.
  if(EXISTS "${path}")
    file(REAL_PATH "${path}" path)
  endif()
  set(roots "${PROJECT_SOURCE_DIR}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
  foreach(root IN LISTS roots)
    file(REAL_PATH "${root}" root)
    set(private_root "${root}/src")
    cmake_path(IS_PREFIX private_root "${path}" NORMALIZE is_private)
    if(path STREQUAL root OR is_private)
      message(FATAL_ERROR "external extension target ${tgt} violates include allowlist: includes prohibited path '${path}'")
    endif()
  endforeach()
endfunction()

function(_gufo_external_options tgt base)
  _gufo_external_items(options "${tgt}" ${ARGN})
  set(expect_path FALSE)
  foreach(option IN LISTS options)
    if(option MATCHES "^SHELL:(.*)$")
      separate_arguments(parts NATIVE_COMMAND "${CMAKE_MATCH_1}")
      _gufo_external_options("${tgt}" "${base}" ${parts})
    elseif(option MATCHES "^/clang:(.*)$")
      _gufo_external_options("${tgt}" "${base}" "${CMAKE_MATCH_1}")
    elseif(expect_path)
      _gufo_external_path("${tgt}" "${option}" "${base}")
      set(expect_path FALSE)
    elseif(option MATCHES "^(-I|/I|-isystem|-iquote|-idirafter|/external:I|/imsvc)(.*)$")
      set(path "${CMAKE_MATCH_2}")
      if(path STREQUAL "")
        set(expect_path TRUE)
      else()
        _gufo_external_path("${tgt}" "${path}" "${base}")
      endif()
    elseif(option MATCHES "^(@|--options-file|--compiler-options|-Wp,|-Xclang|-Xpreprocessor)")
      message(FATAL_ERROR "external extension target ${tgt} has unvalidated compile option '${option}'")
    endif()
  endforeach()
  if(expect_path)
    message(FATAL_ERROR "external extension target ${tgt} has an unvalidated include option without a path")
  endif()
endfunction()

function(_gufo_external_property tgt current property kind)
  get_target_property(values "${current}" "${property}")
  set(base "${CMAKE_BINARY_DIR}")
  if(values)
    if(kind STREQUAL "paths")
      _gufo_external_items(paths "${tgt}" "${values}")
      foreach(path IN LISTS paths)
        _gufo_external_path("${tgt}" "${path}" "${base}")
      endforeach()
    else()
      if(property STREQUAL "COMPILE_FLAGS")
        separate_arguments(values NATIVE_COMMAND "${values}")
      endif()
      _gufo_external_options("${tgt}" "${base}" ${values})
    endif()
  endif()
endfunction()

function(_gufo_validate_external_target tgt)
  set(prohibited_private_targets
      gufo_core gufo_cache gufo_serving gufo_http gufo_test_support
      gufo_qwen_config gufo_qwen_common gufo_qwen_vision gufo_llm_cli
      gufo_cli gufo_compare gufo_bench gufo_diagnostics
      gufo_runtime_storage gufo_prompt_cache gufo_audio_cache gufo_tool_calls
      gufo_kernel_bench_support)
  # Audited link contracts: their closure reaches private targets by design.
  set(public_link_targets gufo_ext_core gufo_ext_cache gufo_ext_hip)
  get_target_property(directory "${tgt}" SOURCE_DIR)
  set(base "${CMAKE_BINARY_DIR}")
  _gufo_external_property("${tgt}" "${tgt}" INCLUDE_DIRECTORIES paths)
  _gufo_external_property("${tgt}" "${tgt}" COMPILE_OPTIONS options)
  _gufo_external_property("${tgt}" "${tgt}" COMPILE_FLAGS options)
  get_target_property(sources "${tgt}" SOURCES)
  foreach(source IN LISTS sources)
    # Generated-expression sources cannot conceal per-source settings.
    _gufo_external_items(checked_sources "${tgt}" "${source}")
    foreach(checked_source IN LISTS checked_sources)
      foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS COMPILE_FLAGS)
        get_source_file_property(values "${checked_source}" DIRECTORY "${directory}" "${property}")
        if(values)
          if(property STREQUAL "INCLUDE_DIRECTORIES")
            _gufo_external_items(paths "${tgt}" "${values}")
            foreach(path IN LISTS paths)
              _gufo_external_path("${tgt}" "${path}" "${base}")
            endforeach()
          elseif(property STREQUAL "COMPILE_FLAGS")
            separate_arguments(options NATIVE_COMMAND "${values}")
            _gufo_external_options("${tgt}" "${base}" ${options})
          else()
            _gufo_external_options("${tgt}" "${base}" ${values})
          endif()
        endif()
      endforeach()
    endforeach()
  endforeach()
  # These flags are absent from target COMPILE_OPTIONS. Read the target's
  # directory scope, including toolchain and configuration-specific values.
  get_cmake_property(variables VARIABLES)
  get_directory_property(local_variables DIRECTORY "${directory}" VARIABLES)
  list(APPEND variables ${local_variables})
  list(REMOVE_DUPLICATES variables)
  foreach(variable IN LISTS variables)
    if(variable MATCHES "^CMAKE_(C|CXX|HIP)_FLAGS($|_)")
      get_directory_property(flags DIRECTORY "${directory}" DEFINITION "${variable}")
      separate_arguments(options NATIVE_COMMAND "${flags}")
      _gufo_external_options("${tgt}" "${base}" ${options})
    elseif(variable MATCHES "^CMAKE_(C|CXX|HIP)_STANDARD_INCLUDE_DIRECTORIES$")
      get_directory_property(paths DIRECTORY "${directory}" DEFINITION "${variable}")
      _gufo_external_items(paths "${tgt}" "${paths}")
      foreach(path IN LISTS paths)
        _gufo_external_path("${tgt}" "${path}" "${base}")
      endforeach()
    endif()
  endforeach()
  foreach(variable CPATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH INCLUDE)
    cmake_path(CONVERT "$ENV{${variable}}" TO_CMAKE_PATH_LIST paths NORMALIZE)
    foreach(path IN LISTS paths)
      _gufo_external_path("${tgt}" "${path}" "${base}")
    endforeach()
  endforeach()

  # Dependencies contribute usage requirements, not their private compilation
  # settings. Static PRIVATE dependencies still require link validation.
  get_target_property(libs "${tgt}" LINK_LIBRARIES)
  set(queue "${tgt}")
  if(libs)
    _gufo_external_items(direct "${tgt}" "${libs}")
    list(APPEND queue ${direct})
  endif()
  set(visited)
  while(queue)
    list(POP_FRONT queue current)
    set(link_only FALSE)
    if(current MATCHES "^LINK_ONLY:(.*)$")
      set(current "${CMAKE_MATCH_1}")
      set(link_only TRUE)
    endif()
    if(TARGET "${current}")
      get_target_property(alias "${current}" ALIASED_TARGET)
      if(alias)
        set(current "${alias}")
      endif()
    endif()
    if(current IN_LIST public_link_targets)
      continue()
    endif()
    if(current IN_LIST prohibited_private_targets)
      message(FATAL_ERROR "external extension target ${tgt} violates allowlist: links prohibited target '${current}'")
    endif()
    set(visit "${link_only}:${current}")
    if(TARGET "${current}" AND NOT visit IN_LIST visited)
      list(APPEND visited "${visit}")
      if(NOT link_only)
        _gufo_external_property("${tgt}" "${current}" INTERFACE_INCLUDE_DIRECTORIES paths)
        _gufo_external_property("${tgt}" "${current}" INTERFACE_SYSTEM_INCLUDE_DIRECTORIES paths)
        _gufo_external_property("${tgt}" "${current}" INTERFACE_COMPILE_OPTIONS options)
      endif()
      get_target_property(libs "${current}" INTERFACE_LINK_LIBRARIES)
      if(libs)
        foreach(item IN LISTS libs)
          set(only_link "${link_only}")
          if(item MATCHES "^\\$<LINK_ONLY:.*>$")
            set(only_link TRUE)
          endif()
          _gufo_external_items(dependencies "${tgt}" "${item}")
          foreach(dependency IN LISTS dependencies)
            # CMake directory-id markers carry no link item.
            if(NOT dependency MATCHES "^::@")
              if(only_link)
                list(APPEND queue "LINK_ONLY:${dependency}")
              else()
                list(APPEND queue "${dependency}")
              endif()
            endif()
          endforeach()
        endforeach()
      endif()
    endif()
  endwhile()
endfunction()

# Include helper targets and nested directories, even if the manifest target
# does not link them directly (OBJECT libraries may supply sources instead).
function(_gufo_validate_external_directory directory)
  get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  foreach(tgt IN LISTS targets)
    _gufo_validate_external_target("${tgt}")
  endforeach()
  get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(child IN LISTS children)
    _gufo_validate_external_directory("${child}")
  endforeach()
endfunction()

function(_gufo_validate_external_directories)
  get_property(wrappers GLOBAL PROPERTY GUFO_EXTERNAL_WRAPPERS)
  foreach(wrapper IN LISTS wrappers)
    _gufo_validate_external_directory("${wrapper}")
  endforeach()
endfunction()

function(gufo_build_discovered_extensions)
  get_property(selected GLOBAL PROPERTY GUFO_SELECTED_EXTENSIONS)
  # Only selected extensions require their `packages[].pkg_config` modules.
  # Each becomes the global imported target PkgConfig::<module>, with the
  # <module>_* variables pkg_check_modules sets, before any extension builds.
  # Its non-cached results (<module>_LINK_LIBRARIES) reach the extension
  # directories because they are added from this same function scope.
  foreach(name IN LISTS selected)
    get_property(json GLOBAL PROPERTY "GUFO_EXT_${name}_JSON")
    _gufo_optional(packages "${json}" packages "[]")
    string(JSON count LENGTH "${packages}")
    if(count EQUAL 0)
      continue()
    endif()
    math(EXPR last "${count}-1")
    foreach(i RANGE ${last})
      string(JSON module ERROR_VARIABLE absent GET "${packages}" ${i} pkg_config)
      if(absent)
        continue()
      endif()
      # A leading '-' would reach pkg-config as an option.
      _gufo_identifier("${module}" "^[A-Za-z0-9_][A-Za-z0-9_.+-]*$" "pkg-config module")
      set_property(GLOBAL APPEND PROPERTY "GUFO_EXT_${name}_PKG_CONFIG" "${module}")
      set_property(GLOBAL APPEND PROPERTY GUFO_EXT_PKG_CONFIG_MODULES "${module}")
      if(TARGET PkgConfig::${module})
        continue()
      endif()
      if(NOT PKG_CONFIG_FOUND)
        find_package(PkgConfig REQUIRED)
      endif()
      pkg_check_modules(${module} IMPORTED_TARGET GLOBAL ${module})
      if(NOT ${module}_FOUND)
        message(FATAL_ERROR "extension ${name} requires pkg-config module ${module}")
      endif()
    endforeach()
  endforeach()
  foreach(name IN LISTS selected)
    get_property(root GLOBAL PROPERTY "GUFO_EXT_${name}_ROOT")
    if(NOT EXISTS "${root}/extension.cmake")
      message(FATAL_ERROR "extension ${name}: missing ${root}/extension.cmake")
    endif()
    # An isolated directory gives each manifest its own current source/binary
    # root. Dependency-first add_subdirectory preserves normal CMake semantics.
    set(wrapper "${CMAKE_CURRENT_BINARY_DIR}/extensions/build/${name}")
    file(MAKE_DIRECTORY "${wrapper}")
    set(equals "=")
    string(FIND "${root}" "]${equals}]" closing)
    while(NOT closing EQUAL -1)
      string(APPEND equals "=")
      string(FIND "${root}" "]${equals}]" closing)
    endwhile()
    get_property(is_external GLOBAL PROPERTY "GUFO_EXT_${name}_IS_EXTERNAL")
    set(wrapper_content "set(GUFO_EXTENSION_BUILD_ROOT [${equals}[${root}]${equals}])\n")
    if(is_external)
      string(APPEND wrapper_content "set_property(DIRECTORY PROPERTY INCLUDE_DIRECTORIES [${equals}[${PROJECT_SOURCE_DIR}/include]${equals}])\n")
      string(APPEND wrapper_content "set(GUFO_EXTENSION_IS_EXTERNAL TRUE)\n")
    endif()
    string(APPEND wrapper_content "include([${equals}[${root}/extension.cmake]${equals}])\n")
    _gufo_write_if_different("${wrapper}/CMakeLists.txt" "${wrapper_content}")
    add_subdirectory("${wrapper}" "${wrapper}/build")
    if(is_external)
      set_property(GLOBAL APPEND PROPERTY GUFO_EXTERNAL_WRAPPERS "${wrapper}")
    endif()
  endforeach()
  # Validate after all manifests and host targets have finished mutating the
  # graph, so later declarations cannot change an already accepted target.
  cmake_language(DEFER CALL _gufo_validate_external_directories)
endfunction()
