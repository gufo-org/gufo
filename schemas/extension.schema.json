          "union",
          "unsigned",
          "using",
          "virtual",
          "void",
          "volatile",
          "wchar_t",
          "while",
          "xor",
          "xor_eq"
        ]
      }
    },
    "registration_target": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "depends": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "capability": {
            "enum": [
              "text_generation",
              "embeddings",
              "speech_recognition",
              "speech_synthesis",
              "image_generation",
              "video_generation"
            ]
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(gguf|safetensors|manifest|diffusers):.+$",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "model_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "speculative": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "entry": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "not": {
              "enum": [
                "alignas",
                "alignof",
                "and",
                "and_eq",
                "asm",
                "atomic_cancel",
                "atomic_commit",
                "atomic_noexcept",
                "auto",
