              ]
            }
          }
        },
        "required": [
          "id",
          "capability",
          "keys",
          "target",
          "entry"
        ],
        "additionalProperties": false
      }
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^--[a-z][a-z0-9-]*$"
          },
          "type": {
            "enum": [
              "boolean",
              "integer",
              "number",
              "string",
              "path"
            ]
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "help": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "type",
          "commands"
        ],
        "additionalProperties": false
      }
    },
    "targets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "requires": {
            "type": "array",
            "items": {
              "enum": [
                "hip",
                "linux",
                "windows",
                "testing"
              ]
            },
            "uniqueItems": true
          },
          "role": {
            "enum": [
              "library",
              "test"
            ]
          }
        },
        "required": [
          "requires"
        ],
        "additionalProperties": false
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "linux",
          "windows"
        ]
      },
      "uniqueItems": true
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pkg_config": {
            "type": "string",
            "minLength": 1
          },
          "nix": {
            "type": "string",
            "minLength": 1
          },
          "windows": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "compile_definitions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "runtime_libraries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "install_data": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "licenses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "production_paths": {
      "type": "object",
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "include",
        "exclude"
      ],
      "additionalProperties": false
    },
    "vendored_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "kernel_resources": {
      "type": "string",
      "minLength": 1
    },
    "docs": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "string",
          "minLength": 1
        },
        "guide": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title",
        "inputs",
        "guide"
      ],
      "additionalProperties": false
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "ctest": {
            "type": "string",
            "minLength": 1
          },
          "check_pr": {
            "type": "boolean"
          },
          "windows_build": {
            "type": "boolean"
          },
          "exclude_os": {
            "type": "array",
            "items": {
              "enum": [
                "linux",
                "windows"
              ]
            },
            "uniqueItems": true
          }
        },
        "required": [
          "target",
          "ctest"
        ],
        "additionalProperties": false
      }
    },
    "test_labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "fixtures": {
      "type": "string",
      "minLength": 1
    },
    "bundled_tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "functional": {
      "type": "string",
      "minLength": 1
    },
    "tools": {
      "type": "string",
      "minLength": 1
    },
    "python_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "tests": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "name",
          "tests",
          "sources"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "name",
    "api_version",
    "version",
    "depends",
    "targets",
    "platforms"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gufo.dev/schemas/extension.schema.json",
  "title": "Gufo extension metadata API 0.1.1",
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "library"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "entry"
              ]
            },
            {
              "required": [
                "registration_target"
              ]
            },
            {
              "properties": {
                "providers": {
                  "minItems": 1
                }
              },
              "required": [
                "providers"
              ]
            },
            {
              "required": [
                "options"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "entry",
          "registration_target",
          "providers"
        ],
        "properties": {
          "providers": {
            "minItems": 1
          }
        }
      }
    },
    {
      "$ref": "#/$defs/nul_free"
    }
  ],
  "$defs": {
    "nul_free": {
      "allOf": [
        {
          "if": {
            "type": "string"
          },
          "then": {
            "pattern": "^[^\u0000]*$"
          }
        },
        {
          "if": {
            "type": "object"
          },
          "then": {
            "propertyNames": {
              "pattern": "^[^\u0000]*$"
            },
            "additionalProperties": {
              "$ref": "#/$defs/nul_free"
            }
          }
        },
        {
          "if": {
            "type": "array"
          },
          "then": {
            "items": {
              "$ref": "#/$defs/nul_free"
            }
          }
        }
      ]
    }
  }
}
