# Reference templates and test fixtures are byte-compared; never let autocrlf
# re-mangle them.
*.jinja text eol=lf
tests/fixtures/** text eol=lf
tests/models/*/fixtures/continuation_identity/** text eol=lf
# Compressed fixtures are binary (zip CRLF bytes must survive).
*.npz binary
*.mp4 binary
*.webm binary
# cmd.exe parses batch files reliably only with CRLF line endings.
*.cmd text eol=crlf
