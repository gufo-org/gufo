+bool GufoProjection::check(int b,int off,const float*ref,int stride,int cols,int rows,Gemm&gm,void*stream,std::string&err){try{
+ std::vector<float>r(size_t(rows)*cols);ck(cudaMemcpy2DAsync(r.data(),cols*4,ref,stride*4,cols*4,rows,cudaMemcpyDeviceToHost,(cudaStream_t)stream));ck(cudaStreamSynchronize((cudaStream_t)stream));double e2=0,r2=0;auto&p=*p_;
