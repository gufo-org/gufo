+bool GufoProjection::wait(int bank,int layer,std::string&err){auto&p=*p_;auto j=p.banks[bank].job;if(!j||j->layer!=layer){err="Gufo ticket identity mismatch";return false;}double t=now();std::unique_lock<std::mutex>g(p.mutex);if(!p.cv.wait_for(g,std::chrono::seconds(30),[&]{return j->done;})){err="Gufo worker deadline";return false;}p.wait_ms+=now()-t;if(!j->error.empty()){err=j->error;return false;}return true;}
