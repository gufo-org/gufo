+ std::fprintf(stderr,"strata gufo NPU: jobs=%llu dispatches=%llu valid_rows=%llu checked_values=%llu max_abs=%.8g max_rel_rms=%.8g max_math_abs=%.8g xrt_ms=%.3f worker_ms=%.3f host_wait_ms=%.3f\n",p.jobs,p.dispatches,p.valid_rows,p.checked_values,p.max_abs,p.max_rel_rms,p.max_math_abs,p.xrt_ms,p.worker_ms,p.wait_ms);return ok;
