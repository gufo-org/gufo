+namespace strata::prefill {
+__global__ void pack_input(const uint16_t*x,uint16_t*y,int rows){int i=blockIdx.x*blockDim.x+threadIdx.x;if(i<1024*2560)y[i]=i<rows*2560?__bfloat16_as_ushort(__float2bfloat16_rn(__half2float(__ushort_as_half(x[i])))):0;}
+__global__ void pack_weight(const uint16_t*w,uint16_t*b){int i=blockIdx.x*blockDim.x+threadIdx.x;if(i<2560*1024)b[i]=__bfloat16_as_ushort(__float2bfloat16_rn(__half2float(__ushort_as_half(w[(i%1024)*2560+i/1024]))));}
+__global__ void unpack_weight(const uint16_t*b,uint16_t*w){int i=blockIdx.x*blockDim.x+threadIdx.x;if(i<2560*1024)w[i]=b[(i%2560)*1024+i/2560];}
+__global__ void scatter(const float*s,float*d,int stride,int src_col,int cols,int rows){int i=blockIdx.x*blockDim.x+threadIdx.x;if(i<cols*rows)d[(i/cols)*stride+i%cols]=s[(i/cols)*1024+src_col+i%cols];}
+void gufo_pack_input(const uint16_t*x,uint16_t*y,int rows,void*st){pack_input<<<(1024*2560+255)/256,256,0,(cudaStream_t)st>>>(x,y,rows);}
+void gufo_pack_weight(const uint16_t*w,uint16_t*b,void*st){pack_weight<<<(1024*2560+255)/256,256,0,(cudaStream_t)st>>>(w,b);}
