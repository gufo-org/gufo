+DraftCosts DraftCostsAt(std::uint32_t context, bool experts,
+                        float verify_scale) noexcept {
+  if (experts) {
+    return Interpolate(context, kExpertDraftStepMs, kExpertVerifyMs);
+  }
+  DraftCosts costs = Interpolate(context, kDraftStepMs, kVerifyMs);
+  if (verify_scale != 1.0F) {
+    // The projections' share grows with the weight bytes; attention at
+    // depth does not.
+    const DraftCosts flat = Interpolate(0, kDraftStepMs, kVerifyMs);
+    for (std::size_t r = 0; r < costs.verify.size(); ++r) {
+      costs.verify[r] += (verify_scale - 1.0F) * flat.verify[r];
+    }
+  }
+  return costs;
+}
+
+float VerifyScale(std::uint64_t forward_bytes, bool experts) noexcept {
+  if (experts || forward_bytes == 0) {
+    return 1.0F;
+  }
+  return static_cast<float>(static_cast<double>(forward_bytes) /
+                            static_cast<double>(kVerifyReferenceBytes));
 }
 
