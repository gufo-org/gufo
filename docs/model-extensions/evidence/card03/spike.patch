+  std::uint32_t max_context{0};
+  bool use_mtp{false};
+  std::uint32_t max_draft_tokens{0};
+  std::string artifact_fingerprint;
+  std::string mtp_fingerprint;
+};
+std::shared_ptr<TextModelRunner> CreateFlashNextTextProvider(
+    std::shared_ptr<models::qwen38_flash_next::Model> model,
+    const FlashNextTextProviderOptions& options);
+}  // namespace gufo::server
