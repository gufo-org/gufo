+enum class TextExecutionPlanKind : std::uint8_t {
+  kSerial,
+  kBatched,
+};
+
+struct TextExecutionPlan {
+  TextExecutionPlanKind kind{TextExecutionPlanKind::kSerial};
+  std::size_t physical_width{1};
