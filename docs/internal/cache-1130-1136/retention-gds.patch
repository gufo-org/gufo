+// EXPERIMENT ONLY: bookkeeping is deliberately outside the ledger, making this
+// an optimistic bound for GDS. This is never compiled into production Gufo.
+double gds_watermark{};
+std::map<std::uint64_t, double> gds_stamps;
+double GdsValue(CheckpointId id, Rows fallback, Rows boundary, std::size_t bytes) {
+  return gds_stamps[id.value] +
+         CostEstimate{0.000573457239, 0.000058015348, 96e9, 3.3e9}
+                 .PrefillSeconds(fallback, boundary) / std::max<std::size_t>(1, bytes);
+}
 bool Prefix(std::span<const Token> a, std::span<const Token> b) {
   return a.size() <= b.size() && std::equal(a.begin(), a.end(), b.begin());
 }
