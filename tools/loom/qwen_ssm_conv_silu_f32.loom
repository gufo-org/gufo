// Qwen3.8 four-tap causal SSM convolution with in-place rolling state.

kernel.def @qwen_ssm_conv_silu_f32(%elements: index) {
  %workgroup_size = index.constant 32 : index
  %capacity = index.constant 10240 : index
  %workgroups = index.div %capacity, %workgroup_size : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%workgroups, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%elements: index, %input: buffer, %weights: buffer, %state: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %count = index.assume %elements [range(%elements, 10240, 10240)] : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %workgroup_size = index.constant 32 : index
  %channel0 = index.madd %group, %workgroup_size, %lane : index
  %channel = index.assume %channel0 [lt(%channel0, %count)] : index
  %four = index.constant 4 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %three = index.constant 3 : index
  %state_base = index.mul %channel, %four : index
  %state1 = index.add %state_base, %one : index
  %state2 = index.add %state_base, %two : index
  %state3 = index.add %state_base, %three : index
  %input_view = buffer.view %input[%base] : buffer -> view<10240xf32>
  %weight_view = buffer.view %weights[%base] : buffer -> view<40960xf32>
  %state_view = buffer.view %state[%base] : buffer -> view<40960xf32>
  %output_view = buffer.view %output[%base] : buffer -> view<10240xf32>
  %old1 = view.load %state_view[%state1] : view<40960xf32> -> f32
  %old2 = view.load %state_view[%state2] : view<40960xf32> -> f32
  %old3 = view.load %state_view[%state3] : view<40960xf32> -> f32
  %x = view.load %input_view[%channel] : view<10240xf32> -> f32
  view.store %old1, %state_view[%state_base] : f32, view<40960xf32>
  view.store %old2, %state_view[%state1] : f32, view<40960xf32>
  view.store %old3, %state_view[%state2] : f32, view<40960xf32>
  view.store %x, %state_view[%state3] : f32, view<40960xf32>
  %w0 = view.load %weight_view[%state_base] : view<40960xf32> -> f32
  %w1 = view.load %weight_view[%state1] : view<40960xf32> -> f32
  %w2 = view.load %weight_view[%state2] : view<40960xf32> -> f32
  %w3 = view.load %weight_view[%state3] : view<40960xf32> -> f32
  %m0 = scalar.mulf<reassoc|nnan|ninf|nsz> %old1, %w0 : f32
  %m1 = scalar.mulf<reassoc|nnan|ninf|nsz> %old2, %w1 : f32
  %m2 = scalar.mulf<reassoc|nnan|ninf|nsz> %old3, %w2 : f32
  %m3 = scalar.mulf<reassoc|nnan|ninf|nsz> %x, %w3 : f32
  %a0 = scalar.addf<reassoc|nnan|ninf|nsz> %m0, %m1 : f32
  %a1 = scalar.addf<reassoc|nnan|ninf|nsz> %m2, %m3 : f32
  %dot = scalar.addf<reassoc|nnan|ninf|nsz> %a0, %a1 : f32
  %negative = scalar.negf %dot : f32
  %exponent = scalar.expf<afn> %negative : f32
  %fone = scalar.constant 1.0 : f32
  %denominator = scalar.addf<reassoc|nnan|ninf|nsz> %fone, %exponent : f32
  %sigmoid = scalar.divf<reassoc|nnan|ninf|nsz> %fone, %denominator : f32
  %result = scalar.mulf<reassoc|nnan|ninf|nsz> %dot, %sigmoid : f32
  view.store %result, %output_view[%channel] : f32, view<10240xf32>
  kernel.return
}
