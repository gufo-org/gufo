// Prefill GQA attention for Qwen3.8 over a whole token tile: 24 query
// heads over 4 KV heads, head width 256.
//
// One workgroup owns one (token tile, KV head) pair. Its eight waves each
// own one token and all six query heads sharing the KV head, and the prefix
// is walked in eight-position chunks staged cooperatively into LDS, so a
// cache row is read from memory once per eight tokens rather than once per
// token. Long prefixes are bound by cache bandwidth, not arithmetic.

amdgpu.target<gfx11-generic> @qwen_attention_tile_target {subgroup_size = 32}

config.decl @qwen_attention_tile_batch_f32.max_context : %value: index where [range(%value, 1, 131072)]
config.decl @qwen_attention_tile_batch_f32.token_capacity : %value: index where [range(%value, 1, 2048)]

kernel.def target(@qwen_attention_tile_target) @qwen_attention_tile_batch_f32(%start_position: index, %max_context: index, %tokens: index) {
  %kv_heads = index.constant 4 : index
  %tokens_capacity = config.get @qwen_attention_tile_batch_f32.token_capacity : index
  %tile_tokens = index.constant 8 : index
  %rounding = index.constant 7 : index
  %rounded = index.add %tokens_capacity, %rounding : index
  %tiles = index.div %rounded, %tile_tokens : index
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%kv_heads, %tiles, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%start_position: index, %max_context: index, %tokens: index, %query: buffer, %gate: buffer, %key_cache: buffer, %value_cache: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %capacity = config.get @qwen_attention_tile_batch_f32.max_context : index
  %context = index.assume %max_context [range(%max_context, 1, 131072), le(%max_context, %capacity)] : index
  %start = index.assume %start_position [range(%start_position, 0, 131071)] : index
  %kv_head = kernel.workgroup.id<x> : index
  %tile = kernel.workgroup.id<y> : index
  %tid = kernel.workitem.id<x> : index
  %wave_width = index.constant 32 : index
  %wave = index.div %tid, %wave_width : index
  %lane = index.rem %tid, %wave_width : index
  %token_count = index.assume %tokens [range(%tokens, 1, 2048)] : index
  %one = index.constant 1 : index
  %tile_tokens = index.constant 8 : index
  %tile_span = index.constant 7 : index
  %tile_base = index.mul %tile, %tile_tokens : index
  %token = index.add %tile_base, %wave : index
  %bounded_kv_head = index.assume %kv_head [range(%kv_head, 0, 3)] : index
  %group = index.constant 6 : index
  %vector_width = index.constant 8 : index
  %element = index.mul %lane, %vector_width : index
  %head_width = index.constant 256 : index
  %row_width = index.constant 6144 : index
  %four = index.constant 4 : offset
  %loop_begin = index.constant 0 : index
  %negative_large = scalar.constant -1000000000.0 : f32
  %zero = scalar.constant 0.0 : f32
  %fone = scalar.constant 1.0 : f32
  %zero_vector = vector.splat %zero : vector<8xf32>
  %scale = scalar.constant 0.0625 : f32
  %key_view = buffer.view %key_cache[%base] : buffer -> view<131072x4x256xf32>
  %value_view = buffer.view %value_cache[%base] : buffer -> view<131072x4x256xf32>

  // Eight positions of keys and values, shared by the eight token waves.
  %scratch_bytes = index.constant 16384 : offset
  %value_scratch_offset = index.constant 8192 : offset
  %scratch = buffer.alloca<workgroup> align(16) %scratch_bytes : buffer
  %key_stage = buffer.view %scratch[%base] : buffer -> view<8x256xf32>
  %value_stage = buffer.view %scratch[%value_scratch_offset] : buffer -> view<8x256xf32>

  // The chunk bound is uniform across the workgroup so every wave reaches
  // the same barriers; per-wave causality is a score guard instead.
  %tile_last = index.add %tile_base, %tile_span : index
  %tile_last_position = index.add %start, %tile_last : index
  %wg_sequence_raw = index.add %tile_last_position, %one : index
  %wg_sequence = index.min %wg_sequence_raw, %context : index
  %position = index.add %start, %token : index
  %sequence = index.add %position, %one : index
  %token_live = index.cmp ult, %token, %token_count : index
  %token_elements = index.mul %token, %row_width : index
  %token_bytes = index.scale %token_elements, %four : index, offset -> offset
  %query_view = buffer.view %query[%token_bytes] : buffer -> view<6144xf32>
  %gate_view = buffer.view %gate[%token_bytes] : buffer -> view<6144xf32>
  %output_view = buffer.view %output[%token_bytes] : buffer -> view<6144xf32>
  %first_head = index.mul %bounded_kv_head, %group : index
  %context_last = index.sub %context, %one : index
  %head_offset0 = index.constant 0 : index
  %head0 = index.add %first_head, %head_offset0 : index
  %query_base0 = index.mul %head0, %head_width : index
  %query_index0 = index.add %query_base0, %element : index
  %q0 = vector.load %query_view[%query_index0] : view<6144xf32> -> vector<8xf32>
  %head_offset1 = index.constant 1 : index
  %head1 = index.add %first_head, %head_offset1 : index
  %query_base1 = index.mul %head1, %head_width : index
  %query_index1 = index.add %query_base1, %element : index
  %q1 = vector.load %query_view[%query_index1] : view<6144xf32> -> vector<8xf32>
  %head_offset2 = index.constant 2 : index
  %head2 = index.add %first_head, %head_offset2 : index
  %query_base2 = index.mul %head2, %head_width : index
  %query_index2 = index.add %query_base2, %element : index
  %q2 = vector.load %query_view[%query_index2] : view<6144xf32> -> vector<8xf32>
  %head_offset3 = index.constant 3 : index
  %head3 = index.add %first_head, %head_offset3 : index
  %query_base3 = index.mul %head3, %head_width : index
  %query_index3 = index.add %query_base3, %element : index
  %q3 = vector.load %query_view[%query_index3] : view<6144xf32> -> vector<8xf32>
  %head_offset4 = index.constant 4 : index
  %head4 = index.add %first_head, %head_offset4 : index
  %query_base4 = index.mul %head4, %head_width : index
  %query_index4 = index.add %query_base4, %element : index
  %q4 = vector.load %query_view[%query_index4] : view<6144xf32> -> vector<8xf32>
  %head_offset5 = index.constant 5 : index
  %head5 = index.add %first_head, %head_offset5 : index
  %query_base5 = index.mul %head5, %head_width : index
  %query_index5 = index.add %query_base5, %element : index
  %q5 = vector.load %query_view[%query_index5] : view<6144xf32> -> vector<8xf32>

  %final_max0, %final_sum0, %final_acc0, %final_max1, %final_sum1, %final_acc1, %final_max2, %final_sum2, %final_acc2, %final_max3, %final_sum3, %final_acc3, %final_max4, %final_sum4, %final_acc4, %final_max5, %final_sum5, %final_acc5 = scf.for %chunk = [%loop_begin to %wg_sequence step %tile_tokens](%max0 = %negative_large : f32, %sum0 = %zero : f32, %acc0 = %zero_vector : vector<8xf32>, %max1 = %negative_large : f32, %sum1 = %zero : f32, %acc1 = %zero_vector : vector<8xf32>, %max2 = %negative_large : f32, %sum2 = %zero : f32, %acc2 = %zero_vector : vector<8xf32>, %max3 = %negative_large : f32, %sum3 = %zero : f32, %acc3 = %zero_vector : vector<8xf32>, %max4 = %negative_large : f32, %sum4 = %zero : f32, %acc4 = %zero_vector : vector<8xf32>, %max5 = %negative_large : f32, %sum5 = %zero : f32, %acc5 = %zero_vector : vector<8xf32>) -> (f32, f32, vector<8xf32>, f32, f32, vector<8xf32>, f32, f32, vector<8xf32>, f32, f32, vector<8xf32>, f32, f32, vector<8xf32>, f32, f32, vector<8xf32>) {
    // Each wave stages one position; all eight waves then read all eight.
    %stage_position_raw = index.add %chunk, %wave : index
    %stage_position = index.min %stage_position_raw, %context_last : index
    %staged_key = vector.load %key_view[%stage_position, %bounded_kv_head, %element] : view<131072x4x256xf32> -> vector<8xf32>
    %staged_value = vector.load %value_view[%stage_position, %bounded_kv_head, %element] : view<131072x4x256xf32> -> vector<8xf32>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    vector.store %staged_key, %key_stage[%wave, %element] : vector<8xf32>, view<8x256xf32>
    vector.store %staged_value, %value_stage[%wave, %element] : vector<8xf32>, view<8x256xf32>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %slot0 = index.constant 0 : index
    %p0 = index.add %chunk, %slot0 : index
    %k0 = vector.load %key_stage[%slot0, %element] : view<8x256xf32> -> vector<8xf32>
    %v0 = vector.load %value_stage[%slot0, %element] : view<8x256xf32> -> vector<8xf32>
    %live0 = index.cmp ult, %p0, %sequence : index
    // Positions past this wave's token score as -inf, so the online
    // softmax drops them without a branch and the barrier schedule
    // stays uniform across the workgroup.
    %local0_0 = vector.dotf %q0, %k0, %zero : vector<8xf32>, vector<8xf32>, f32
    %dot0_0 = kernel.subgroup.reduce<addf> %local0_0 : f32
    %raw0_0 = scalar.mulf<reassoc|nnan|ninf|nsz> %dot0_0, %scale : f32
    %score0_0 = scf.select %live0, %raw0_0, %negative_large : f32
    %new_max0_0 = scalar.maxnumf %max0, %score0_0 : f32
    %old_delta0_0 = scalar.subf %max0, %new_max0_0 : f32
    %score_delta0_0 = scalar.subf %score0_0, %new_max0_0 : f32
    %old_scale0_0 = scalar.expf<afn> %old_delta0_0 : f32
    %value_scale0_0 = scalar.expf<afn> %score_delta0_0 : f32
    %scaled_sum0_0 = scalar.mulf<reassoc|nnan|ninf|nsz> %sum0, %old_scale0_0 : f32
    %new_sum0_0 = scalar.addf<reassoc|nnan|ninf|nsz> %scaled_sum0_0, %value_scale0_0 : f32
    %old_scale_vec0_0 = vector.splat %old_scale0_0 : vector<8xf32>
    %value_scale_vec0_0 = vector.splat %value_scale0_0 : vector<8xf32>
    %old_acc0_0 = vector.mulf<reassoc|nnan|ninf|nsz> %acc0, %old_scale_vec0_0 : vector<8xf32>
    %weighted0_0 = vector.mulf<reassoc|nnan|ninf|nsz> %v0, %value_scale_vec0_0 : vector<8xf32>
    %new_acc0_0 = vector.addf<reassoc|nnan|ninf|nsz> %old_acc0_0, %weighted0_0 : vector<8xf32>
    %local0_1 = vector.dotf %q1, %k0, %zero : vector<8xf32>, vector<8xf32>, f32
    %dot0_1 = kernel.subgroup.reduce<addf> %local0_1 : f32
    %raw0_1 = scalar.mulf<reassoc|nnan|ninf|nsz> %dot0_1, %scale : f32
    %score0_1 = scf.select %live0, %raw0_1, %negative_large : f32
    %new_max0_1 = scalar.maxnumf %max1, %score0_1 : f32
    %old_delta0_1 = scalar.subf %max1, %new_max0_1 : f32
    %score_delta0_1 = scalar.subf %score0_1, %new_max0_1 : f32
    %old_scale0_1 = scalar.expf<afn> %old_delta0_1 : f32
    %value_scale0_1 = scalar.expf<afn> %score_delta0_1 : f32
    %scaled_sum0_1 = scalar.mulf<reassoc|nnan|ninf|nsz> %sum1, %old_scale0_1 : f32
    %new_sum0_1 = scalar.addf<reassoc|nnan|ninf|nsz> %scaled_sum0_1, %value_scale0_1 : f32
    %old_scale_vec0_1 = vector.splat %old_scale0_1 : vector<8xf32>
    %value_scale_vec0_1 = vector.splat %value_scale0_1 : vector<8xf32>
    %old_acc0_1 = vector.mulf<reassoc|nnan|ninf|nsz> %acc1, %old_scale_vec0_1 : vector<8xf32>
    %weighted0_1 = vector.mulf<reassoc|nnan|ninf|nsz> %v0, %value_scale_vec0_1 : vector<8xf32>
    %new_acc0_1 = vector.addf<reassoc|nnan|ninf|nsz> %old_acc0_1, %weighted0_1 : vector<8xf32>
    %local0_2 = vector.dotf %q2, %k0, %zero : vector<8xf32>, vector<8xf32>, f32
    %dot0_2 = kernel.subgroup.reduce<addf> %local0_2 : f32
    %raw0_2 = scalar.mulf<reassoc|nnan|ninf|nsz> %dot0_2, %scale : f32
    %score0_2 = scf.select %live0, %raw0_2, %negative_large : f32
    %new_max0_2 = scalar.maxnumf %max2, %score0_2 : f32
    %old_delta0_2 = scalar.subf %max2, %new_max0_2 : f32
    %score_delta0_2 = scalar.subf %score0_2, %new_max0_2 : f32
    %old_scale0_2 = scalar.expf<afn> %old_delta0_2 : f32
    %value_scale0_2 = scalar.expf<afn> %score_delta0_2 : f32
    %scaled_sum0_2 = scalar.mulf<reassoc|nnan|ninf|nsz> %sum2, %old_scale0_2 : f32
    %new_sum0_2 = scalar.addf<reassoc|nnan|ninf|nsz> %scaled_sum0_2, %value_scale0_2 : f32
    %old_scale_vec0_2 = vector.splat %old_scale0_2 : vector<8xf32>
    %value_scale_vec0_2 = vector.splat %value_scale0_2 : vector<8xf32>
    %old_acc0_2 = vector.mulf<reassoc|nnan|ninf|nsz> %acc2, %old_scale_vec0_2 : vector<8xf32>
    %weighted0_2 = vector.mulf<reassoc|nnan|ninf|nsz> %v0, %value_scale_vec0_2 : vector<8xf32>
    %new_acc0_2 = vector.addf<reassoc|nnan|ninf|nsz> %old_acc0_2, %weighted0_2 : vector<8xf32>
    %local0_3 = vector.dotf %q3, %k0, %zero : vector<8xf32>, vector<8xf32>, f32
    %dot0_3 = kernel.subgroup.reduce<addf> %local0_3 : f32
    %raw0_3 = scalar.mulf<reassoc|nnan|ninf|nsz> %dot0_3, %scale : f32
    %score0_3 = scf.select %live0, %raw0_3, %negative_large : f32
    %new_max0_3 = scalar.maxnumf %max3, %score0_3 : f32
    %old_delta0_3 = scalar.subf %max3, %new_max0_3 : f32
    %score_delta0_3 = scalar.subf %score0_3, %new_max0_3 : f32
    %old_scale0_3 = scalar.expf<afn> %old_delta0_3 : f32
    %value_scale0_3 = scalar.expf<afn> %score_delta0_3 : f32
    %scaled_sum0_3 = scalar.mulf<reassoc|nnan|ninf|nsz> %sum3, %old_scale0_3 : f32
    %new_sum0_3 = scalar.addf<reassoc|nnan|ninf|nsz> %scaled_sum0_3, %value_scale0_3 : f32
    %old_scale_vec0_3 = vector.splat %old_scale0_3 : vector<8xf32>
    %value_scale_vec0_3 = vector.splat %value_scale0_3 : vector<8xf32>
    %old_acc0_3 = vector.mulf<reassoc|nnan|ninf|nsz> %acc3, %old_scale_vec0_3 : vector<8xf32>
    %weighted0_3 = vector.mulf<reassoc|nnan|ninf|nsz> %v0, %value_scale_vec0_3 : vector<8xf32>
    %new_acc0_3 = vector.addf<reassoc|nnan|ninf|nsz> %old_acc0_3, %weighted0_3 : vector<8xf32>
    %local0_4 = vector.dotf %q4, %k0, %zero : vector<8xf32>, vector<8xf32>, f32
    %dot0_4 = kernel.subgroup.reduce<addf> %local0_4 : f32
    %raw0_4 = scalar.mulf<reassoc|nnan|ninf|nsz> %dot0_4, %scale : f32
    %score0_4 = scf.select %live0, %raw0_4, %negative_large : f32
    %new_max0_4 = scalar.maxnumf %max4, %score0_4 : f32
    %old_delta0_4 = scalar.subf %max4, %new_max0_4 : f32
    %score_delta0_4 = scalar.subf %score0_4, %new_max0_4 : f32
    %old_scale0_4 = scalar.expf<afn> %old_delta0_4 : f32
    %value_scale0_4 = scalar.expf<afn> %score_delta0_4 : f32
    %scaled_sum0_4 = scalar.mulf<reassoc|nnan|ninf|nsz> %sum4, %old_scale0_4 : f32
    %new_sum0_4 = scalar.addf<reassoc|nnan|ninf|nsz> %scaled_sum0_4, %value_scale0_4 : f32
    %old_scale_vec0_4 = vector.splat %old_scale0_4 : vector<8xf32>
    %value_scale_vec0_4 = vector.splat %value_scale0_4 : vector<8xf32>
    %old_acc0_4 = vector.mulf<reassoc|nnan|ninf|nsz> %acc4, %old_scale_vec0_4 : vector<8xf32>
    %weighted0_4 = vector.mulf<reassoc|nnan|ninf|nsz> %v0, %value_scale_vec0_4 : vector<8xf32>
    %new_acc0_4 = vector.addf<reassoc|nnan|ninf|nsz> %old_acc0_4, %weighted0_4 : vector<8xf32>
    %local0_5 = vector.dotf %q5, %k0, %zero : vector<8xf32>, vector<8xf32>, f32
    %dot0_5 = kernel.subgroup.reduce<addf> %local0_5 : f32
    %raw0_5 = scalar.mulf<reassoc|nnan|ninf|nsz> %dot0_5, %scale : f32
    %score0_5 = scf.select %live0, %raw0_5, %negative_large : f32
    %new_max0_5 = scalar.maxnumf %max5, %score0_5 : f32
    %old_delta0_5 = scalar.subf %max5, %new_max0_5 : f32
    %score_delta0_5 = scalar.subf %score0_5, %new_max0_5 : f32
    %old_scale0_5 = scalar.expf<afn> %old_delta0_5 : f32
    %value_scale0_5 = scalar.expf<afn> %score_delta0_5 : f32
    %scaled_sum0_5 = scalar.mulf<reassoc|nnan|ninf|nsz> %sum5, %old_scale0_5 : f32
    %new_sum0_5 = scalar.addf<reassoc|nnan|ninf|nsz> %scaled_sum0_5, %value_scale0_5 : f32
    %old_scale_vec0_5 = vector.splat %old_scale0_5 : vector<8xf32>
    %value_scale_vec0_5 = vector.splat %value_scale0_5 : vector<8xf32>
    %old_acc0_5 = vector.mulf<reassoc|nnan|ninf|nsz> %acc5, %old_scale_vec0_5 : vector<8xf32>
    %weighted0_5 = vector.mulf<reassoc|nnan|ninf|nsz> %v0, %value_scale_vec0_5 : vector<8xf32>
    %new_acc0_5 = vector.addf<reassoc|nnan|ninf|nsz> %old_acc0_5, %weighted0_5 : vector<8xf32>
    %slot1 = index.constant 1 : index
    %p1 = index.add %chunk, %slot1 : index
    %k1 = vector.load %key_stage[%slot1, %element] : view<8x256xf32> -> vector<8xf32>
    %v1 = vector.load %value_stage[%slot1, %element] : view<8x256xf32> -> vector<8xf32>
    %live1 = index.cmp ult, %p1, %sequence : index
    %local1_0 = vector.dotf %q0, %k1, %zero : vector<8xf32>, vector<8xf32>, f32
    %dot1_0 = kernel.subgroup.reduce<addf> %local1_0 : f32
    %raw1_0 = scalar.mulf<reassoc|nnan|ninf|nsz> %dot1_0, %scale : f32
    %score1_0 = scf.select %live1, %raw1_0, %negative_large : f32
    %new_max1_0 = scalar.maxnumf %new_max0_0, %score1_0 : f32
    %old_delta1_0 = scalar.subf %new_max0_0, %new_max1_0 : f32
    %score_delta1_0 = scalar.subf %score1_0, %new_max1_0 : f32
    %old_scale1_0 = scalar.expf<afn> %old_delta1_0 : f32
    %value_scale1_0 = scalar.expf<afn> %score_delta1_0 : f32
    %scaled_sum1_0 = scalar.mulf<reassoc|nnan|ninf|nsz> %new_sum0_0, %old_scale1_0 : f32
    %new_sum1_0 = scalar.addf<reassoc|nnan|ninf|nsz> %scaled_sum1_0, %value_scale1_0 : f32
    %old_scale_vec1_0 = vector.splat %old_scale1_0 : vector<8xf32>
    %value_scale_vec1_0 = vector.splat %value_scale1_0 : vector<8xf32>
    %old_acc1_0 = vector.mulf<reassoc|nnan|ninf|nsz> %new_acc0_0, %old_scale_vec1_0 : vector<8xf32>
    %weighted1_0 = vector.mulf<reassoc|nnan|ninf|nsz> %v1, %value_scale_vec1_0 : vector<8xf32>
    %new_acc1_0 = vector.addf<reassoc|nnan|ninf|nsz> %old_acc1_0, %weighted1_0 : vector<8xf32>
    %local1_1 = vector.dotf %q1, %k1, %zero : vector<8xf32>, vector<8xf32>, f32
    %dot1_1 = kernel.subgroup.reduce<addf> %local1_1 : f32
    %raw1_1 = scalar.mulf<reassoc|nnan|ninf|nsz> %dot1_1, %scale : f32
    %score1_1 = scf.select %live1, %raw1_1, %negative_large : f32
    %new_max1_1 = scalar.maxnumf %new_max0_1, %score1_1 : f32
    %old_delta1_1 = scalar.subf %new_max0_1, %new_max1_1 : f32
    %score_delta1_1 = scalar.subf %score1_1, %new_max1_1 : f32
    %old_scale1_1 = scalar.expf<afn> %old_delta1_1 : f32
    %value_scale1_1 = scalar.expf<afn> %score_delta1_1 : f32
    %scaled_sum1_1 = scalar.mulf<reassoc|nnan|ninf|nsz> %new_sum0_1, %old_scale1_1 : f32
    %new_sum1_1 = scalar.addf<reassoc|nnan|ninf|nsz> %scaled_sum1_1, %value_scale1_1 : f32
    %old_scale_vec1_1 = vector.splat %old_scale1_1 : vector<8xf32>
    %value_scale_vec1_1 = vector.splat %value_scale1_1 : vector<8xf32>
    %old_acc1_1 = vector.mulf<reassoc|nnan|ninf|nsz> %new_acc0_1, %old_scale_vec1_1 : vector<8xf32>
    %weighted1_1 = vector.mulf<reassoc|nnan|ninf|nsz> %v1, %value_scale_vec1_1 : vector<8xf32>
    %new_acc1_1 = vector.addf<reassoc|nnan|ninf|nsz> %old_acc1_1, %weighted1_1 : vector<8xf32>
    %local1_2 = vector.dotf %q2, %k1, %zero : vector<8xf32>, vector<8xf32>, f32
    %dot1_2 = kernel.subgroup.reduce<addf> %local1_2 : f32
    %raw1_2 = scalar.mulf<reassoc|nnan|ninf|nsz> %dot1_2, %scale : f32
    %score1_2 = scf.select %live1, %raw1_2, %negative_large : f32
