// ============================================================================
// Qwen3.8-27B Fused Final RMSNorm + LM-Head Logits GEMV in Loom IR
// Computes:
//   x_norm = (x / sqrt(mean(x^2) + eps)) * gamma
//   logits = lm_head @ x_norm
// Vocab Size = 248320, Hidden Size = 5120
// ============================================================================

func.def inline @bf16_dot32(%act: vector<32xf32>, %weight: vector<32xbf16>) -> (f32) {
  %sum_init = scalar.constant 0.0 : f32
  %w_f32 = vector.extf %weight : vector<32xbf16> to vector<32xf32>
  %prod = vector.mulf<reassoc|nnan|ninf|nsz> %act, %w_f32 : vector<32xf32>
  %sum = vector.reduce<addf, reassoc|nnan|ninf|nsz> %prod, %sum_init : vector<32xf32>, f32
  func.return %sum : f32
}

config.decl @qwen_fused_final_norm_head_bf16.vocab_capacity : %value: index where [range(%value, 2, 248320), mul(%value, 2)]

kernel.def @qwen_fused_final_norm_head_bf16(%rows: index) {
  %row_block = index.constant 2 : index
  %vocab_cap = config.get @qwen_fused_final_norm_head_bf16.vocab_capacity : index
  %row_tiles = index.div %vocab_cap, %row_block : index
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 160 : index
  kernel.launch.config workgroups(%row_tiles, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%rows: index, %input: buffer, %gamma: buffer, %head_weight: buffer, %logits: buffer) {
  %base = index.constant 0 : offset
  %vocab_cap = config.get @qwen_fused_final_norm_head_bf16.vocab_capacity : index
  %row_count = index.assume %rows [range(%rows, 2, 248320), mul(%rows, 2), le(%rows, %vocab_cap)] : index
  %row_tile = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %row_block = index.constant 2 : index
  %row_offset_1 = index.constant 1 : index
  %vector_width = index.constant 32 : index
  %leader = index.constant 0 : index

  %row_base0 = index.madd %row_tile, %row_block, %leader : index
  %row_base = index.assume %row_base0 [mul(%row_base0, 2)] : index
  %row1_0 = index.add %row_base, %row_offset_1 : index
  %row_end = index.add %row_base, %row_block : index
  %row_tile_in_bounds = index.cmp ule, %row_end, %row_count : index

  scf.if %row_tile_in_bounds {
    %bounded_row0 = index.assume %row_base [lt(%row_base, %row_count)] : index
    %bounded_row1 = index.assume %row1_0 [lt(%row1_0, %row_count)] : index
    %input_base0 = index.mul %lane, %vector_width : index
    %input_base = index.assume %input_base0 [mul(%input_base0, 32)] : index

    %in_noalias, %gamma_noalias, %head_noalias, %logits_noalias = buffer.assume.noalias %input, %gamma, %head_weight, %logits : buffer, buffer, buffer, buffer
    %in_view = buffer.view %in_noalias[%base] : buffer -> view<5120xf32>
    %gamma_view = buffer.view %gamma_noalias[%base] : buffer -> view<5120xf32>
    %head_view = buffer.view %head_noalias[%base] : buffer -> view<[%row_count]x5120xbf16>
    %logits_view = buffer.view %logits_noalias[%base] : buffer -> view<[%row_count]xf32>

    %x_raw = vector.load %in_view[%input_base] : view<5120xf32> -> vector<32xf32>
    %g = vector.load %gamma_view[%input_base] : view<5120xf32> -> vector<32xf32>
    %x_norm = vector.mulf<reassoc|nnan|ninf|nsz> %x_raw, %g : vector<32xf32>

    %w_vec0 = vector.load %head_view[%bounded_row0, %input_base] : view<[%row_count]x5120xbf16> -> vector<32xbf16>
    %w_vec1 = vector.load %head_view[%bounded_row1, %input_base] : view<[%row_count]x5120xbf16> -> vector<32xbf16>

    %sum0 = func.call @bf16_dot32(%x_norm, %w_vec0) : (vector<32xf32>, vector<32xbf16>) -> (f32)
    %dot0 = kernel.workgroup.reduce<addf> %sum0 : f32

    %sum1 = func.call @bf16_dot32(%x_norm, %w_vec1) : (vector<32xf32>, vector<32xbf16>) -> (f32)
    %dot1 = kernel.workgroup.reduce<addf> %sum1 : f32

    %is_leader = index.cmp eq, %lane, %leader : index
    scf.if %is_leader {
      view.store %dot0, %logits_view[%bounded_row0] : f32, view<[%row_count]xf32>
      view.store %dot1, %logits_view[%bounded_row1] : f32, view<[%row_count]xf32>
    }
  }
  kernel.return
}

check.case public @qwen_final_head_case {
  %rows = check.param.choice values([2, 248320]) name("rows") : index
  %input = check.generate.fill value(0.0) : tensor<5120xf32>
  %gamma = check.generate.fill value(1.0) : tensor<5120xf32>
  %head_weight = check.generate.fill value(0.0) : tensor<[%rows]x5120xbf16>
  %logits = check.generate.fill value(0.0) : tensor<[%rows]xf32>
  %expected = check.generate.fill value(0.0) : tensor<[%rows]xf32>

  kernel.launch @qwen_fused_final_norm_head_bf16[%rows](%rows, %input, %gamma, %head_weight, %logits) : [index](index, tensor<5120xf32>, tensor<5120xf32>, tensor<[%rows]x5120xbf16>, tensor<[%rows]xf32>)
  check.expect.close actual(%logits) expected(%expected) atol(0.0001) rtol(0.0001) nan(same) : tensor<[%rows]xf32>
  check.return
}

check.benchmark<@qwen_final_head_case> @qwen_final_head_decode {rows = 2}
