// Qwen3.8 native primitive: elementwise F32 residual add over a token-major
// chunk. The whole chunk is contiguous, so one dispatch covers every token.

config.decl @qwen_residual_add_batch_f32.element_capacity : %value: index where [range(%value, 32, 655360), mul(%value, 32)]

kernel.def @qwen_residual_add_batch_f32(%elements: index) {
  %vector_width = index.constant 32 : index
  %capacity = config.get @qwen_residual_add_batch_f32.element_capacity : index
  %workgroups = index.div %capacity, %vector_width : index
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%workgroups, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%elements: index, %left: buffer, %right: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %capacity = config.get @qwen_residual_add_batch_f32.element_capacity : index
  %count = index.assume %elements [range(%elements, 32, 655360), mul(%elements, 32), le(%elements, %capacity)] : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %leader = index.constant 0 : index
  %vector_width = index.constant 32 : index
  %element_base0 = index.mul %group, %vector_width : index
  %element_in_bounds = index.cmp ult, %element_base0, %count : index
  %is_leader = index.cmp eq, %lane, %leader : index
  scf.if %is_leader {
    scf.if %element_in_bounds {
      %element_base = index.assume %element_base0 [mul(%element_base0, 32), lt(%element_base0, %count)] : index
      %left_noalias, %right_noalias, %output_noalias = buffer.assume.noalias %left, %right, %output : buffer, buffer, buffer
      %left_view = buffer.view %left_noalias[%base] : buffer -> view<655360xf32>
      %right_view = buffer.view %right_noalias[%base] : buffer -> view<655360xf32>
      %output_view = buffer.view %output_noalias[%base] : buffer -> view<655360xf32>
      %a = vector.load %left_view[%element_base] : view<655360xf32> -> vector<32xf32>
      %b = vector.load %right_view[%element_base] : view<655360xf32> -> vector<32xf32>
      %sum = vector.addf<reassoc|nnan|ninf|nsz> %a, %b : vector<32xf32>
      vector.store %sum, %output_view[%element_base] : vector<32xf32>, view<655360xf32>
    }
  }
  kernel.return
}
