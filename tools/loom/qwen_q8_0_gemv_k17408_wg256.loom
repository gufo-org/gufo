// Native Q8_0 GEMV for K=17408 using eight wave32s per workgroup.
// Threads stride over the 544 Q8 blocks instead of placing 17 waves in one
// workgroup, allowing the GPU scheduler to keep more workgroups resident.

config.decl @qwen_q8_0_gemv_k17408_wg256.row_capacity : %value: index where [range(%value, 1, 5120)]

kernel.def @qwen_q8_0_gemv_k17408_wg256(%rows: index) {
  %capacity = config.get @qwen_q8_0_gemv_k17408_wg256.row_capacity : index
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%capacity, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%rows: index, %weight: buffer, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %capacity = config.get @qwen_q8_0_gemv_k17408_wg256.row_capacity : index
  %row_count = index.assume %rows [range(%rows, 1, 5120), le(%rows, %capacity)] : index
  %row = kernel.workgroup.id<x> : index
  %thread = kernel.workitem.id<x> : index
  %row_in_bounds = index.cmp ult, %row, %row_count : index

  scf.if %row_in_bounds {
    %bounded_row = index.assume %row [lt(%row, %row_count)] : index
    %blocks_per_row = index.constant 544 : index
    %workgroup_size = index.constant 256 : index
    %qk = index.constant 32 : index
    %block_bytes = index.constant 34 : offset
    %qs_offset = index.constant 2 : offset
    %packed_bytes = index.constant 4 : offset
    %packed_values = index.constant 4 : index
    %quarter_count = index.constant 8 : index
    %loop_begin = index.constant 0 : index
    %loop_step = index.constant 1 : index
    %packed_index = index.constant 0 : index
    %leader = index.constant 0 : index
    %zero = scalar.constant 0.0 : f32

    %weight_noalias, %input_noalias, %output_noalias = buffer.assume.noalias %weight, %input, %output : buffer, buffer, buffer
    %linear_row_base = index.mul %bounded_row, %blocks_per_row : index
    %input_view = buffer.view %input_noalias[%base] : buffer -> view<17408xf32>
    %sum = scf.for %block_index = [%thread to %blocks_per_row step %workgroup_size](%block_acc = %zero : f32) -> (f32) {
      %bounded_block = index.assume %block_index [lt(%block_index, 544)] : index
      %linear_block = index.add %linear_row_base, %bounded_block : index
      %block_byte_base = index.scale %linear_block, %block_bytes : index, offset -> offset
      %scale_view = buffer.view %weight_noalias[%block_byte_base] : buffer -> view<1xf16>
      %scale_f16 = view.load %scale_view[%packed_index] : view<1xf16> -> f16
      %scale = scalar.extf %scale_f16 : f16 to f32
      %scale_vec = vector.splat %scale : vector<4xf32>
      %input_block_base = index.mul %bounded_block, %qk : index
      %next_block_acc = scf.for %quarter = [%loop_begin to %quarter_count step %loop_step](%quarter_acc = %block_acc : f32) -> (f32) unroll {
        %quarter_byte = index.scale %quarter, %packed_bytes : index, offset -> offset
        %payload_base = index.add %block_byte_base, %qs_offset : offset
        %q_byte_offset = index.add %payload_base, %quarter_byte : offset
        %q_word_view = buffer.view %weight_noalias[%q_byte_offset] : buffer -> view<1xi32>
        %q_packed = vector.load %q_word_view[%packed_index] : view<1xi32> -> vector<1xi32>
        %q_i32 = vector.bitunpacks<8> %q_packed : vector<1xi32> -> vector<4xi32>
        %q_f32 = vector.sitofp %q_i32 : vector<4xi32> to vector<4xf32>
        %q_scaled = vector.mulf<reassoc|nnan|ninf|nsz|contract> %q_f32, %scale_vec : vector<4xf32>
        %quarter_values = index.mul %quarter, %packed_values : index
        %input_index = index.add %input_block_base, %quarter_values : index
        %x = vector.load %input_view[%input_index] : view<17408xf32> -> vector<4xf32>
        %next = vector.dotf %q_scaled, %x, %quarter_acc : vector<4xf32>, vector<4xf32>, f32
        scf.yield %next : f32
      }
      scf.yield %next_block_acc : f32
    }
    %dot = kernel.workgroup.reduce<addf> %sum : f32
    %is_leader = index.cmp eq, %thread, %leader : index
    scf.if %is_leader {
      %output_view = buffer.view %output_noalias[%base] : buffer -> view<[%row_count]xf32>
      view.store %dot, %output_view[%bounded_row] : f32, view<[%row_count]xf32>
    }
  }
  kernel.return
}

check.case public @qwen_q8_0_gemv_k17408_wg256_zero_case {
  %rows = check.param.choice values([1, 5120]) name("rows") : index
  %weight = check.generate.fill value(0) : tensor<[%rows]x18496xi8>
  %input = check.generate.fill value(0.0) : tensor<17408xf32>
  %output = check.generate.fill value(1.0) : tensor<[%rows]xf32>
  %expected = check.generate.fill value(0.0) : tensor<[%rows]xf32>
  kernel.launch @qwen_q8_0_gemv_k17408_wg256[%rows](%rows, %weight, %input, %output) : [index](index, tensor<[%rows]x18496xi8>, tensor<17408xf32>, tensor<[%rows]xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0001) rtol(0.0001) nan(same) : tensor<[%rows]xf32>
  check.return
}

check.benchmark<@qwen_q8_0_gemv_k17408_wg256_zero_case> @qwen_q8_0_gemv_k17408_wg256_full {rows = 5120}
