// Fused DeltaNet readout + blocked activation quantization.
//
// The unfused readout writes a 2048 x 6144 f32 tile (50 MiB per layer) whose
// only consumer on the blocked W8A8 route is the activation quantizer, which
// reads it straight back. This kernel keeps the readout result in a register
// and writes only the int8 payload and its per-block scales.
//
// The readout arithmetic is the unfused sequence op for op, in the same order
// and with the same fast-math flags, so the quantized payload is bit-identical.
//
// One workgroup still handles one (token, head) pair with 128 workitems, one
// per value dimension. A wave is 32 lanes and a Q8 block is 32 elements, so a
// wave is exactly one block and the amax is a subgroup reduction: head h owns
// blocks 4h..4h+3, and lane l of wave w writes byte l of block 4h+w.
//
// readout : token-major scratch from qwen_deltanet_recurrence_batch_f32
// norm    : 128 f32 per-value-dimension weights
// gate    : token-major gate projection, %tokens rows of 6144 f32
// output  : [token tile][K block][token in tile][32 int8]
// scales  : [token tile][K block][token in tile] f32

config.decl @qwen_deltanet_readout_quantize_batch_f32.token_capacity : %value: index where [range(%value, 1, 2048)]

kernel.def @qwen_deltanet_readout_quantize_batch_f32(%tokens: index) {
  %capacity = config.get @qwen_deltanet_readout_quantize_batch_f32.token_capacity : index
  %heads = index.constant 48 : index
  %groups = index.mul %capacity, %heads : index
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 128 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%tokens: index, %readout: buffer, %norm: buffer, %gate: buffer, %output: buffer, %scales: buffer) {
  %base = index.constant 0 : offset
  %capacity = config.get @qwen_deltanet_readout_quantize_batch_f32.token_capacity : index
  %token_count = index.assume %tokens [range(%tokens, 1, 2048), le(%tokens, %capacity)] : index
  %group = kernel.workgroup.id<x> : index
  %row = kernel.workitem.id<x> : index
  %heads = index.constant 48 : index
  %dim = index.constant 128 : index
  %width = index.constant 6144 : index
  %vector_width = index.constant 32 : index
  %token_tile_extent = index.constant 16 : index
  %blocks_per_head = index.constant 4 : index
  %zero_index = index.constant 0 : index
  %token = index.div %group, %heads : index
  %head = index.rem %group, %heads : index
  %wave = index.div %row, %vector_width : index
  %lane = index.rem %row, %vector_width : index
  %head_block_base = index.mul %head, %blocks_per_head : index
  %block = index.add %head_block_base, %wave : index
  %tile = index.div %token, %token_tile_extent : index
  %tile_lane = index.rem %token, %token_tile_extent : index
  %payload = buffer.view %output[%base] : buffer -> view<128x192x16x32xi8>
  %scale_view = buffer.view %scales[%base] : buffer -> view<128x192x16xf32>
  %is_scale_lane = index.cmp eq, %lane, %zero_index : index
  %token_in_bounds = index.cmp ult, %token, %token_count : index
  scf.if %token_in_bounds {
    %token_base = index.mul %token, %width : index
    %head_base = index.mul %head, %dim : index
    %element_base = index.add %token_base, %head_base : index
    %element = index.add %element_base, %row : index
    %readout_view = buffer.view %readout[%base] : buffer -> view<12582912xf32>
    %norm_view = buffer.view %norm[%base] : buffer -> view<128xf32>
    %gate_view = buffer.view %gate[%base] : buffer -> view<12582912xf32>
    %value = view.load %readout_view[%element] : view<12582912xf32> -> f32
    %value_sq = scalar.mulf<reassoc|nnan|ninf|nsz> %value, %value : f32
    %sum = kernel.workgroup.reduce<addf> %value_sq : f32
    %val_width = scalar.constant 128.0 : f32
    %epsilon = scalar.constant 0.000001 : f32
    %mean = scalar.divf<reassoc|nnan|ninf|nsz> %sum, %val_width : f32
    %variance = scalar.addf<reassoc|nnan|ninf|nsz> %mean, %epsilon : f32
    %inverse = scalar.rsqrtf<afn> %variance : f32
    %norm_weight = view.load %norm_view[%row] : view<128xf32> -> f32
    %gate_value = view.load %gate_view[%element] : view<12582912xf32> -> f32
    %negative_gate = scalar.negf %gate_value : f32
    %gate_exp = scalar.expf<afn> %negative_gate : f32
    %one = scalar.constant 1.0 : f32
    %denominator = scalar.addf<reassoc|nnan|ninf|nsz> %one, %gate_exp : f32
    %sigmoid = scalar.divf<reassoc|nnan|ninf|nsz> %one, %denominator : f32
    %silu_gate = scalar.mulf<reassoc|nnan|ninf|nsz> %gate_value, %sigmoid : f32
    %normed = scalar.mulf<reassoc|nnan|ninf|nsz> %value, %inverse : f32
    %weighted = scalar.mulf<reassoc|nnan|ninf|nsz> %normed, %norm_weight : f32
    %result = scalar.mulf<reassoc|nnan|ninf|nsz> %weighted, %silu_gate : f32

    // The block scale is the amax over the wave, which is exactly the 32
    // elements of one Q8 block.
    %magnitude = scalar.absf %result : f32
    %amax = kernel.subgroup.reduce<maxnumf> %magnitude : f32
    %levels = scalar.constant 127.0 : f32
    %scale = scalar.divf<reassoc|nnan|ninf|nsz> %amax, %levels : f32
    %tiny = scalar.constant 0.00000001 : f32
    %safe_scale = scalar.maxnumf %scale, %tiny : f32
    %reciprocal = scalar.divf<reassoc|nnan|ninf|nsz> %one, %safe_scale : f32
    %scaled = scalar.mulf<reassoc|nnan|ninf|nsz> %result, %reciprocal : f32
    %rounded_value = scalar.roundevenf %scaled : f32
    %quantized = scalar.fptosi %rounded_value : f32 to i8
    view.store %quantized, %payload[%tile, %block, %tile_lane, %lane] : i8, view<128x192x16x32xi8>
    scf.if %is_scale_lane {
      view.store %safe_scale, %scale_view[%tile, %block, %tile_lane] : f32, view<128x192x16xf32>
    }
  } else {
    // Physical tokens past the logical count contribute nothing to the matrix
    // product, exactly as the standalone quantizer's padding path does.
    %zero_payload = scalar.constant 0 : i8
    %zero_scale = scalar.constant 0.0 : f32
    view.store %zero_payload, %payload[%tile, %block, %tile_lane, %lane] : i8, view<128x192x16x32xi8>
    scf.if %is_scale_lane {
      view.store %zero_scale, %scale_view[%tile, %block, %tile_lane] : f32, view<128x192x16xf32>
    }
  }
  kernel.return
}
