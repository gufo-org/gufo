  %v_index2 = index.add %v_head_base, %row2 : index
  %lane_element2_0 = index.add %lane_base, %offset0 : index
  %state_initial2_0 = view.load %state_view[%head, %row2, %lane_element2_0] : view<48x128x128xf32> -> f32
  %lane_element2_1 = index.add %lane_base, %offset1 : index
  %state_initial2_1 = view.load %state_view[%head, %row2, %lane_element2_1] : view<48x128x128xf32> -> f32
  %lane_element2_2 = index.add %lane_base, %offset2 : index
  %state_initial2_2 = view.load %state_view[%head, %row2, %lane_element2_2] : view<48x128x128xf32> -> f32
  %lane_element2_3 = index.add %lane_base, %offset3 : index
  %state_initial2_3 = view.load %state_view[%head, %row2, %lane_element2_3] : view<48x128x128xf32> -> f32
  %row3 = index.add %row_base, %row_offset3 : index
