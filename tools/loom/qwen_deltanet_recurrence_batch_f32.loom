  %lane_element3_3 = index.add %lane_base, %offset3 : index
  %state_initial3_3 = view.load %state_view[%head, %row3, %lane_element3_3] : view<48x128x128xf32> -> f32
  %row4 = index.add %row_base, %row_offset4 : index
