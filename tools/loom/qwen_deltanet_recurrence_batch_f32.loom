  %lane_element4_1 = index.add %lane_base, %offset1 : index
  %state_initial4_1 = view.load %state_view[%head, %row4, %lane_element4_1] : view<48x128x128xf32> -> f32
  %lane_element4_2 = index.add %lane_base, %offset2 : index
  %state_initial4_2 = view.load %state_view[%head, %row4, %lane_element4_2] : view<48x128x128xf32> -> f32
  %lane_element4_3 = index.add %lane_base, %offset3 : index
  %state_initial4_3 = view.load %state_view[%head, %row4, %lane_element4_3] : view<48x128x128xf32> -> f32
  %row5 = index.add %row_base, %row_offset5 : index
  %v_index5 = index.add %v_head_base, %row5 : index
  %lane_element5_0 = index.add %lane_base, %offset0 : index
