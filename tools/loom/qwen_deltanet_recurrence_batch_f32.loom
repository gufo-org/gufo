  %lane_element3_0 = index.add %lane_base, %offset0 : index
  %state_initial3_0 = view.load %state_view[%head, %row3, %lane_element3_0] : view<48x128x128xf32> -> f32
  %lane_element3_1 = index.add %lane_base, %offset1 : index
  %state_initial3_1 = view.load %state_view[%head, %row3, %lane_element3_1] : view<48x128x128xf32> -> f32
