// Batch-native DeltaNet state mutation for one prefill chunk.
//
// One workgroup owns 8 value rows of one head and each workitem owns
// 4 key elements, so every recurrent state element stays in a register
// for the whole chunk: state is read once at entry and written once at
// exit. Sharing a workgroup across 8 rows also amortizes the query and
// key reads, which the one-row-per-workgroup shape repeated 128 times per
// head per token. The readout is left unnormalized in a scratch buffer
// because its RMS normalization spans a head's rows;
// qwen_deltanet_readout_batch_f32 finishes it.
//
// conv    : token-major convolution output, %tokens rows of 10240 f32
// prepared: token-major alpha decay and beta correction, %tokens rows of 96
// state   : 48 x 128 x 128 f32 recurrent state, updated in place
// readout : token-major scratch, %tokens rows of 6144 f32

amdgpu.target<gfx11-generic> @qwen_deltanet_recurrence_batch_target {subgroup_size = 32}

config.decl @qwen_deltanet_recurrence_batch_f32.token_capacity : %value: index where [range(%value, 1, 2048)]

kernel.def target(@qwen_deltanet_recurrence_batch_target) @qwen_deltanet_recurrence_batch_f32(%tokens: index) {
  %groups = index.constant 768 : index
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%tokens: index, %conv: buffer, %prepared: buffer, %state: buffer, %readout: buffer) {
  %base = index.constant 0 : offset
  %capacity = config.get @qwen_deltanet_recurrence_batch_f32.token_capacity : index
  %token_count = index.assume %tokens [range(%tokens, 1, 2048), le(%tokens, %capacity)] : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %keys_per_lane = index.constant 4 : index
  %lane_base = index.mul %lane, %keys_per_lane : index
  %offset0 = index.constant 0 : index
  %offset1 = index.constant 1 : index
  %offset2 = index.constant 2 : index
  %offset3 = index.constant 3 : index
  %row_offset0 = index.constant 0 : index
  %row_offset1 = index.constant 1 : index
  %row_offset2 = index.constant 2 : index
  %row_offset3 = index.constant 3 : index
  %row_offset4 = index.constant 4 : index
  %row_offset5 = index.constant 5 : index
  %row_offset6 = index.constant 6 : index
  %row_offset7 = index.constant 7 : index
  %dim = index.constant 128 : index
  %rows_per_group = index.constant 8 : index
  %groups_per_head = index.constant 16 : index
  %key_heads = index.constant 16 : index
  %k_offset = index.constant 2048 : index
  %v_offset = index.constant 4096 : index
  %conv_width = index.constant 10240 : index
  %prepared_width = index.constant 96 : index
  %readout_width = index.constant 6144 : index
