  %leader = index.constant 0 : index
  %is_leader = index.cmp eq, %lane, %leader : index
  %state_final0_0, %state_final0_1, %state_final0_2, %state_final0_3, %state_final1_0, %state_final1_1, %state_final1_2, %state_final1_3, %state_final2_0, %state_final2_1, %state_final2_2, %state_final2_3, %state_final3_0, %state_final3_1, %state_final3_2, %state_final3_3, %state_final4_0, %state_final4_1, %state_final4_2, %state_final4_3, %state_final5_0, %state_final5_1, %state_final5_2, %state_final5_3, %state_final6_0, %state_final6_1, %state_final6_2, %state_final6_3, %state_final7_0, %state_final7_1, %state_final7_2, %state_final7_3 = scf.for %token = [%loop_begin to %token_count step %loop_step](%state0_0 = %state_initial0_0 : f32, %state0_1 = %state_initial0_1 : f32, %state0_2 = %state_initial0_2 : f32, %state0_3 = %state_initial0_3 : f32, %state1_0 = %state_initial1_0 : f32, %state1_1 = %state_initial1_1 : f32, %state1_2 = %state_initial1_2 : f32, %state1_3 = %state_initial1_3 : f32, %state2_0 = %state_initial2_0 : f32, %state2_1 = %state_initial2_1 : f32, %state2_2 = %state_initial2_2 : f32, %state2_3 = %state_initial2_3 : f32, %state3_0 = %state_initial3_0 : f32, %state3_1 = %state_initial3_1 : f32, %state3_2 = %state_initial3_2 : f32, %state3_3 = %state_initial3_3 : f32, %state4_0 = %state_initial4_0 : f32, %state4_1 = %state_initial4_1 : f32, %state4_2 = %state_initial4_2 : f32, %state4_3 = %state_initial4_3 : f32, %state5_0 = %state_initial5_0 : f32, %state5_1 = %state_initial5_1 : f32, %state5_2 = %state_initial5_2 : f32, %state5_3 = %state_initial5_3 : f32, %state6_0 = %state_initial6_0 : f32, %state6_1 = %state_initial6_1 : f32, %state6_2 = %state_initial6_2 : f32, %state6_3 = %state_initial6_3 : f32, %state7_0 = %state_initial7_0 : f32, %state7_1 = %state_initial7_1 : f32, %state7_2 = %state_initial7_2 : f32, %state7_3 = %state_initial7_3 : f32) -> (f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32) {
