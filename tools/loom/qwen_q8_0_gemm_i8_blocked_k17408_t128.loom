    %ep_token_output_offset0 = index.scale %ep_token_output_base0, %four_bytes : index, offset -> offset
    %ep_output_view0 = buffer.view %output[%ep_token_output_offset0] : buffer -> view<[%row_count]xf32>
    %ep_acc_0_0 = vector.extract %accumulators[0] : vector<8x8xf32> -> vector<8xf32>
