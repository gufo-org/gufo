check.case public @qwen_q8_0_gemm_i8_blocked_k17408_t128_case {
  %rows = check.param.choice values([5120]) name("rows") : index
  %tokens = check.param.choice values([128]) name("tokens") : index
  // f16(2.0) is [0, 64] little-endian, so each Q8 block has scale 2.0 and
  // payload bytes alternating 0 and 64.
  %weight = check.generate.fill value(2.0) : tensor<[%rows]x9248xf16>
  %act = check.generate.fill value(2) : tensor<8x544x16x32xi8>
  %scales = check.generate.fill value(1.0) : tensor<8x544x16xf32>
  %output = check.generate.fill value(0.0) : tensor<128x[%rows]xf32>
  %expected = check.generate.fill value(2228224.0) : tensor<128x[%rows]xf32>
  kernel.launch @qwen_q8_0_gemm_i8_blocked_k17408_t128[%rows, %tokens](%rows, %tokens, %weight, %act, %scales, %output) : [index, index](index, index, tensor<[%rows]x9248xf16>, tensor<8x544x16x32xi8>, tensor<8x544x16xf32>, tensor<128x[%rows]xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<128x[%rows]xf32>
  check.return
}

