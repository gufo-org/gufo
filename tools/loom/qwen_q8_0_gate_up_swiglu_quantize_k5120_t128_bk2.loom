    // Four LHS fragments (gate/up for two adjacent 16-row spans) by two RHS
    // fragments keep the six LDS reads of the square tile while placing each
    // gate/up result pair in the same lane for the fused epilogue.
    %lhs_pair_bytes0 = vector.load %weight_stage_store[%wslot, %lhs_row0, %loop_begin] : view<5x128x32xi8> -> vector<32xi8>
    %lhs_pair0 = vector.bitcast %lhs_pair_bytes0 : vector<32xi8> to vector<8xi32>
    %lhs_low_raw0 = vector.slice %lhs_pair0[0] : vector<8xi32> -> vector<4xi32>
    %lhs_high_raw0 = vector.slice %lhs_pair0[4] : vector<8xi32> -> vector<4xi32>
    %lhs_low0 = vector.fragment<lhs> %lhs_low_raw0 shape [%token_tile_extent, %token_tile_extent] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
    %lhs_high0 = vector.fragment<lhs> %lhs_high_raw0 shape [%token_tile_extent, %token_tile_extent] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
    %weight_scales0 = vector.load %weight_scale_stage[%wslot, %row_frag0, %scale_vector_origin] : view<5x8x16xf32> -> vector<8xf32>
    %lhs_pair_bytes1 = vector.load %weight_stage_store[%wslot, %lhs_row1, %loop_begin] : view<5x128x32xi8> -> vector<32xi8>
    %lhs_pair1 = vector.bitcast %lhs_pair_bytes1 : vector<32xi8> to vector<8xi32>
    %lhs_low_raw1 = vector.slice %lhs_pair1[0] : vector<8xi32> -> vector<4xi32>
    %lhs_high_raw1 = vector.slice %lhs_pair1[4] : vector<8xi32> -> vector<4xi32>
    %lhs_low1 = vector.fragment<lhs> %lhs_low_raw1 shape [%token_tile_extent, %token_tile_extent] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
    %lhs_high1 = vector.fragment<lhs> %lhs_high_raw1 shape [%token_tile_extent, %token_tile_extent] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
    %weight_scales1 = vector.load %weight_scale_stage[%wslot, %row_frag1, %scale_vector_origin] : view<5x8x16xf32> -> vector<8xf32>
    %lhs_pair_bytes2 = vector.load %weight_stage_store[%wslot, %lhs_row2, %loop_begin] : view<5x128x32xi8> -> vector<32xi8>
    %lhs_pair2 = vector.bitcast %lhs_pair_bytes2 : vector<32xi8> to vector<8xi32>
    %lhs_low_raw2 = vector.slice %lhs_pair2[0] : vector<8xi32> -> vector<4xi32>
    %lhs_high_raw2 = vector.slice %lhs_pair2[4] : vector<8xi32> -> vector<4xi32>
    %lhs_low2 = vector.fragment<lhs> %lhs_low_raw2 shape [%token_tile_extent, %token_tile_extent] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
    %lhs_high2 = vector.fragment<lhs> %lhs_high_raw2 shape [%token_tile_extent, %token_tile_extent] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
    %weight_scales2 = vector.load %weight_scale_stage[%wslot, %row_frag2, %scale_vector_origin] : view<5x8x16xf32> -> vector<8xf32>
    %lhs_pair_bytes3 = vector.load %weight_stage_store[%wslot, %lhs_row3, %loop_begin] : view<5x128x32xi8> -> vector<32xi8>
    %lhs_pair3 = vector.bitcast %lhs_pair_bytes3 : vector<32xi8> to vector<8xi32>
    %lhs_low_raw3 = vector.slice %lhs_pair3[0] : vector<8xi32> -> vector<4xi32>
    %lhs_high_raw3 = vector.slice %lhs_pair3[4] : vector<8xi32> -> vector<4xi32>
    %lhs_low3 = vector.fragment<lhs> %lhs_low_raw3 shape [%token_tile_extent, %token_tile_extent] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
    %lhs_high3 = vector.fragment<lhs> %lhs_high_raw3 shape [%token_tile_extent, %token_tile_extent] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
    %weight_scales3 = vector.load %weight_scale_stage[%wslot, %row_frag3, %scale_vector_origin] : view<5x8x16xf32> -> vector<8xf32>

    %rhs_pair_bytes0 = vector.load %act_stage_store[%parity, %rhs_row0, %loop_begin] : view<2x128x32xi8> -> vector<32xi8>
    %rhs_pair0 = vector.bitcast %rhs_pair_bytes0 : vector<32xi8> to vector<8xi32>
    %rhs_low_raw0 = vector.slice %rhs_pair0[0] : vector<8xi32> -> vector<4xi32>
    %rhs_high_raw0 = vector.slice %rhs_pair0[4] : vector<8xi32> -> vector<4xi32>
    %rhs_low0 = vector.fragment<rhs> %rhs_low_raw0 shape [%token_tile_extent, %token_tile_extent] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
    %rhs_high0 = vector.fragment<rhs> %rhs_high_raw0 shape [%token_tile_extent, %token_tile_extent] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
    %act_scale0 = view.load %act_scale_stage[%parity, %tt0, %lane_token] : view<2x8x16xf32> -> f32
    %act_scales0 = vector.splat %act_scale0 : vector<8xf32>
    %zero_i32_0_0 = vector.fragment<init> %zero_i32_elements shape [%token_tile_extent, %token_tile_extent] : vector<8xi32>
    %partial_0_0 = vector.mma %lhs_low0, %rhs_low0, %zero_i32_0_0 : vector<4xi32>, vector<4xi32>, vector<8xi32>
    %product_0_0 = vector.mma %lhs_high0, %rhs_high0, %partial_0_0 : vector<4xi32>, vector<4xi32>, vector<8xi32>
    %raw_0_0 = vector.sitofp %product_0_0 : vector<8xi32> to vector<8xf32>
    %scaled_act_0_0 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %raw_0_0, %act_scales0 : vector<8xf32>
    %sum_0 = vector.fmaf<reassoc|nnan|ninf|nsz|contract> %scaled_act_0_0, %weight_scales0, %running0 : vector<8xf32>
    %zero_i32_0_1 = vector.fragment<init> %zero_i32_elements shape [%token_tile_extent, %token_tile_extent] : vector<8xi32>
    %partial_0_1 = vector.mma %lhs_low1, %rhs_low0, %zero_i32_0_1 : vector<4xi32>, vector<4xi32>, vector<8xi32>
    %product_0_1 = vector.mma %lhs_high1, %rhs_high0, %partial_0_1 : vector<4xi32>, vector<4xi32>, vector<8xi32>
    %raw_0_1 = vector.sitofp %product_0_1 : vector<8xi32> to vector<8xf32>
    %scaled_act_0_1 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %raw_0_1, %act_scales0 : vector<8xf32>
    %sum_4 = vector.fmaf<reassoc|nnan|ninf|nsz|contract> %scaled_act_0_1, %weight_scales1, %running4 : vector<8xf32>
    %zero_i32_0_2 = vector.fragment<init> %zero_i32_elements shape [%token_tile_extent, %token_tile_extent] : vector<8xi32>
    %partial_0_2 = vector.mma %lhs_low2, %rhs_low0, %zero_i32_0_2 : vector<4xi32>, vector<4xi32>, vector<8xi32>
    %product_0_2 = vector.mma %lhs_high2, %rhs_high0, %partial_0_2 : vector<4xi32>, vector<4xi32>, vector<8xi32>
    %raw_0_2 = vector.sitofp %product_0_2 : vector<8xi32> to vector<8xf32>
    %scaled_act_0_2 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %raw_0_2, %act_scales0 : vector<8xf32>
    %sum_1 = vector.fmaf<reassoc|nnan|ninf|nsz|contract> %scaled_act_0_2, %weight_scales2, %running1 : vector<8xf32>
    %zero_i32_0_3 = vector.fragment<init> %zero_i32_elements shape [%token_tile_extent, %token_tile_extent] : vector<8xi32>
    %partial_0_3 = vector.mma %lhs_low3, %rhs_low0, %zero_i32_0_3 : vector<4xi32>, vector<4xi32>, vector<8xi32>
    %product_0_3 = vector.mma %lhs_high3, %rhs_high0, %partial_0_3 : vector<4xi32>, vector<4xi32>, vector<8xi32>
    %raw_0_3 = vector.sitofp %product_0_3 : vector<8xi32> to vector<8xf32>
    %scaled_act_0_3 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %raw_0_3, %act_scales0 : vector<8xf32>
    %sum_5 = vector.fmaf<reassoc|nnan|ninf|nsz|contract> %scaled_act_0_3, %weight_scales3, %running5 : vector<8xf32>

    %rhs_pair_bytes1 = vector.load %act_stage_store[%parity, %rhs_row1, %loop_begin] : view<2x128x32xi8> -> vector<32xi8>
    %rhs_pair1 = vector.bitcast %rhs_pair_bytes1 : vector<32xi8> to vector<8xi32>
    %rhs_low_raw1 = vector.slice %rhs_pair1[0] : vector<8xi32> -> vector<4xi32>
    %rhs_high_raw1 = vector.slice %rhs_pair1[4] : vector<8xi32> -> vector<4xi32>
    %rhs_low1 = vector.fragment<rhs> %rhs_low_raw1 shape [%token_tile_extent, %token_tile_extent] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
    %rhs_high1 = vector.fragment<rhs> %rhs_high_raw1 shape [%token_tile_extent, %token_tile_extent] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
    %act_scale1 = view.load %act_scale_stage[%parity, %tt1, %lane_token] : view<2x8x16xf32> -> f32
    %act_scales1 = vector.splat %act_scale1 : vector<8xf32>
    %zero_i32_1_0 = vector.fragment<init> %zero_i32_elements shape [%token_tile_extent, %token_tile_extent] : vector<8xi32>
    %partial_1_0 = vector.mma %lhs_low0, %rhs_low1, %zero_i32_1_0 : vector<4xi32>, vector<4xi32>, vector<8xi32>
    %product_1_0 = vector.mma %lhs_high0, %rhs_high1, %partial_1_0 : vector<4xi32>, vector<4xi32>, vector<8xi32>
    %raw_1_0 = vector.sitofp %product_1_0 : vector<8xi32> to vector<8xf32>
    %scaled_act_1_0 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %raw_1_0, %act_scales1 : vector<8xf32>
    %sum_2 = vector.fmaf<reassoc|nnan|ninf|nsz|contract> %scaled_act_1_0, %weight_scales0, %running2 : vector<8xf32>
    %zero_i32_1_1 = vector.fragment<init> %zero_i32_elements shape [%token_tile_extent, %token_tile_extent] : vector<8xi32>
    %partial_1_1 = vector.mma %lhs_low1, %rhs_low1, %zero_i32_1_1 : vector<4xi32>, vector<4xi32>, vector<8xi32>
    %product_1_1 = vector.mma %lhs_high1, %rhs_high1, %partial_1_1 : vector<4xi32>, vector<4xi32>, vector<8xi32>
    %raw_1_1 = vector.sitofp %product_1_1 : vector<8xi32> to vector<8xf32>
    %scaled_act_1_1 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %raw_1_1, %act_scales1 : vector<8xf32>
    %sum_6 = vector.fmaf<reassoc|nnan|ninf|nsz|contract> %scaled_act_1_1, %weight_scales1, %running6 : vector<8xf32>
    %zero_i32_1_2 = vector.fragment<init> %zero_i32_elements shape [%token_tile_extent, %token_tile_extent] : vector<8xi32>
    %partial_1_2 = vector.mma %lhs_low2, %rhs_low1, %zero_i32_1_2 : vector<4xi32>, vector<4xi32>, vector<8xi32>
    %product_1_2 = vector.mma %lhs_high2, %rhs_high1, %partial_1_2 : vector<4xi32>, vector<4xi32>, vector<8xi32>
    %raw_1_2 = vector.sitofp %product_1_2 : vector<8xi32> to vector<8xf32>
    %scaled_act_1_2 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %raw_1_2, %act_scales1 : vector<8xf32>
    %sum_3 = vector.fmaf<reassoc|nnan|ninf|nsz|contract> %scaled_act_1_2, %weight_scales2, %running3 : vector<8xf32>
    %zero_i32_1_3 = vector.fragment<init> %zero_i32_elements shape [%token_tile_extent, %token_tile_extent] : vector<8xi32>
    %partial_1_3 = vector.mma %lhs_low3, %rhs_low1, %zero_i32_1_3 : vector<4xi32>, vector<4xi32>, vector<8xi32>
    %product_1_3 = vector.mma %lhs_high3, %rhs_high1, %partial_1_3 : vector<4xi32>, vector<4xi32>, vector<8xi32>
    %raw_1_3 = vector.sitofp %product_1_3 : vector<8xi32> to vector<8xf32>
    %scaled_act_1_3 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %raw_1_3, %act_scales1 : vector<8xf32>
    %sum_7 = vector.fmaf<reassoc|nnan|ninf|nsz|contract> %scaled_act_1_3, %weight_scales3, %running7 : vector<8xf32>

    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %sum_0, %sum_4, %sum_1, %sum_5, %sum_2, %sum_6, %sum_3, %sum_7 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }

  // The four row fragments are gate/up pairs for two adjacent 16-row spans.
  // Each lane therefore owns both operands for 16 values of one 32-value Q8
  // block. Lanes separated by 16 own opposite row parity; a clustered reduce
  // combines their local maxima without involving the other tokens in the wave.
  %output_blocks = index.div %row_count, %wave_width : index
  %output_block_base = index.mul %row_group, %two : index
  %output_block = index.add %output_block_base, %wave_row_group : index
  %bounded_output_block = index.assume %output_block [lt(%output_block, %output_blocks)] : index
  %output_tile0 = index.add %token_tile_group_base, %tt0 : index
  %output_tile1 = index.add %token_tile_group_base, %tt1 : index
  %output_tile_capacity = index.constant 128 : index
  %bounded_output_tile0 = index.assume %output_tile0 [lt(%output_tile0, %output_tile_capacity)] : index
  %bounded_output_tile1 = index.assume %output_tile1 [lt(%output_tile1, %output_tile_capacity)] : index
  %payload = buffer.view %output[%base] : buffer -> view<128x[%output_blocks]x16x32xi8>
  %output_scale_view = buffer.view %out_scales[%base] : buffer -> view<128x[%output_blocks]x16xf32>
  %scatter_base0 = index.constant 0 : index
  %scatter_base1_offset = index.constant 16 : index
  %scatter_base1 = index.add %scatter_base1_offset, %row_parity : index
  %scatter_offsets0 = vector.iota %row_parity step %two : vector<8xindex>
  %scatter_offsets1 = vector.iota %scatter_base1 step %two : vector<8xindex>
  %is_scale_lane = index.cmp eq, %row_parity, %scatter_base0 : index
  %zero = scalar.constant 0.0 : f32
  %levels = scalar.constant 127.0 : f32
  %tiny = scalar.constant 0.00000001 : f32
  %one = scalar.constant 1.0 : f32
  %ones = vector.constant 1.0 : vector<8xf32>
  %parity_lane_offset = scalar.constant 16 : i32
  %subgroup_width = scalar.constant 32 : i32

  %negative_0_0 = vector.negf %acc0 : vector<8xf32>
  %exponent_0_0 = vector.expf<afn> %negative_0_0 : vector<8xf32>
  %denominator_0_0 = vector.addf<reassoc|nnan|ninf|nsz> %ones, %exponent_0_0 : vector<8xf32>
  %silu_0_0 = vector.divf<reassoc|nnan|ninf|nsz> %acc0, %denominator_0_0 : vector<8xf32>
  %values_0_0 = vector.mulf<reassoc|nnan|ninf|nsz> %silu_0_0, %acc4 : vector<8xf32>
  %negative_0_1 = vector.negf %acc1 : vector<8xf32>
  %exponent_0_1 = vector.expf<afn> %negative_0_1 : vector<8xf32>
  %denominator_0_1 = vector.addf<reassoc|nnan|ninf|nsz> %ones, %exponent_0_1 : vector<8xf32>
  %silu_0_1 = vector.divf<reassoc|nnan|ninf|nsz> %acc1, %denominator_0_1 : vector<8xf32>
  %values_0_1 = vector.mulf<reassoc|nnan|ninf|nsz> %silu_0_1, %acc5 : vector<8xf32>
  %magnitudes_0_0 = vector.absf %values_0_0 : vector<8xf32>
  %magnitudes_0_1 = vector.absf %values_0_1 : vector<8xf32>
  %local_amax_0_0 = vector.reduce<maxnumf, reassoc|nnan|ninf|nsz> %magnitudes_0_0, %zero : vector<8xf32>, f32
  %local_amax_0 = vector.reduce<maxnumf, reassoc|nnan|ninf|nsz> %magnitudes_0_1, %local_amax_0_0 : vector<8xf32>, f32
  %other_amax_0, %other_amax_valid_0 = kernel.subgroup.shuffle<xor> %local_amax_0, %parity_lane_offset, %subgroup_width : f32, i32, i32
  %amax_0 = scalar.maxnumf %local_amax_0, %other_amax_0 : f32
  %scale_0 = scalar.divf<reassoc|nnan|ninf|nsz> %amax_0, %levels : f32
  %safe_scale_0 = scalar.maxnumf %scale_0, %tiny : f32
  %inverse_0 = scalar.divf<reassoc|nnan|ninf|nsz> %one, %safe_scale_0 : f32
  %inverse_vector_0 = vector.splat %inverse_0 : vector<8xf32>
  %scaled_0_0 = vector.mulf<reassoc|nnan|ninf|nsz> %values_0_0, %inverse_vector_0 : vector<8xf32>
  %scaled_0_1 = vector.mulf<reassoc|nnan|ninf|nsz> %values_0_1, %inverse_vector_0 : vector<8xf32>
  %rounded_0_0 = vector.roundevenf %scaled_0_0 : vector<8xf32>
  %rounded_0_1 = vector.roundevenf %scaled_0_1 : vector<8xf32>
  %quantized_0_0 = vector.fptosi %rounded_0_0 : vector<8xf32> to vector<8xi8>
  %quantized_0_1 = vector.fptosi %rounded_0_1 : vector<8xf32> to vector<8xi8>
  vector.scatter %quantized_0_0, %payload[%bounded_output_tile0, %bounded_output_block, %lane_token, %scatter_base0][%scatter_offsets0] : vector<8xi8>, view<128x[%output_blocks]x16x32xi8>, vector<8xindex>
  vector.scatter %quantized_0_1, %payload[%bounded_output_tile0, %bounded_output_block, %lane_token, %scatter_base0][%scatter_offsets1] : vector<8xi8>, view<128x[%output_blocks]x16x32xi8>, vector<8xindex>
  scf.if %is_scale_lane {
    view.store %safe_scale_0, %output_scale_view[%bounded_output_tile0, %bounded_output_block, %lane_token] : f32, view<128x[%output_blocks]x16xf32>
  }

  %negative_1_0 = vector.negf %acc2 : vector<8xf32>
  %exponent_1_0 = vector.expf<afn> %negative_1_0 : vector<8xf32>
  %denominator_1_0 = vector.addf<reassoc|nnan|ninf|nsz> %ones, %exponent_1_0 : vector<8xf32>
  %silu_1_0 = vector.divf<reassoc|nnan|ninf|nsz> %acc2, %denominator_1_0 : vector<8xf32>
  %values_1_0 = vector.mulf<reassoc|nnan|ninf|nsz> %silu_1_0, %acc6 : vector<8xf32>
  %negative_1_1 = vector.negf %acc3 : vector<8xf32>
  %exponent_1_1 = vector.expf<afn> %negative_1_1 : vector<8xf32>
  %denominator_1_1 = vector.addf<reassoc|nnan|ninf|nsz> %ones, %exponent_1_1 : vector<8xf32>
  %silu_1_1 = vector.divf<reassoc|nnan|ninf|nsz> %acc3, %denominator_1_1 : vector<8xf32>
  %values_1_1 = vector.mulf<reassoc|nnan|ninf|nsz> %silu_1_1, %acc7 : vector<8xf32>
  %magnitudes_1_0 = vector.absf %values_1_0 : vector<8xf32>
  %magnitudes_1_1 = vector.absf %values_1_1 : vector<8xf32>
  %local_amax_1_0 = vector.reduce<maxnumf, reassoc|nnan|ninf|nsz> %magnitudes_1_0, %zero : vector<8xf32>, f32
  %local_amax_1 = vector.reduce<maxnumf, reassoc|nnan|ninf|nsz> %magnitudes_1_1, %local_amax_1_0 : vector<8xf32>, f32
  %other_amax_1, %other_amax_valid_1 = kernel.subgroup.shuffle<xor> %local_amax_1, %parity_lane_offset, %subgroup_width : f32, i32, i32
  %amax_1 = scalar.maxnumf %local_amax_1, %other_amax_1 : f32
  %scale_1 = scalar.divf<reassoc|nnan|ninf|nsz> %amax_1, %levels : f32
  %safe_scale_1 = scalar.maxnumf %scale_1, %tiny : f32
  %inverse_1 = scalar.divf<reassoc|nnan|ninf|nsz> %one, %safe_scale_1 : f32
  %inverse_vector_1 = vector.splat %inverse_1 : vector<8xf32>
  %scaled_1_0 = vector.mulf<reassoc|nnan|ninf|nsz> %values_1_0, %inverse_vector_1 : vector<8xf32>
  %scaled_1_1 = vector.mulf<reassoc|nnan|ninf|nsz> %values_1_1, %inverse_vector_1 : vector<8xf32>
  %rounded_1_0 = vector.roundevenf %scaled_1_0 : vector<8xf32>
  %rounded_1_1 = vector.roundevenf %scaled_1_1 : vector<8xf32>
  %quantized_1_0 = vector.fptosi %rounded_1_0 : vector<8xf32> to vector<8xi8>
  %quantized_1_1 = vector.fptosi %rounded_1_1 : vector<8xf32> to vector<8xi8>
  vector.scatter %quantized_1_0, %payload[%bounded_output_tile1, %bounded_output_block, %lane_token, %scatter_base0][%scatter_offsets0] : vector<8xi8>, view<128x[%output_blocks]x16x32xi8>, vector<8xindex>
  vector.scatter %quantized_1_1, %payload[%bounded_output_tile1, %bounded_output_block, %lane_token, %scatter_base0][%scatter_offsets1] : vector<8xi8>, view<128x[%output_blocks]x16x32xi8>, vector<8xindex>
  scf.if %is_scale_lane {
    view.store %safe_scale_1, %output_scale_view[%bounded_output_tile1, %bounded_output_block, %lane_token] : f32, view<128x[%output_blocks]x16xf32>
  }
  kernel.return
}

check.case public @qwen_q8_0_gate_up_swiglu_quantize_k5120_t128_bk2_case {
  %rows = check.param.choice values([2560]) name("rows") : index
  %tokens = check.param.choice values([256]) name("tokens") : index
  %weight_rows = check.param.choice values([5120]) name("weight_rows") : index
  %output_blocks = check.param.choice values([80]) name("output_blocks") : index
  // f16(2.0) is [0, 64] little-endian, so each Q8 block has scale 2.0 and
  // payload bytes alternating 0 and 64.
  %weight = check.generate.fill value(2.0) : tensor<[%weight_rows]x2720xf16>
  %act = check.generate.fill value(2) : tensor<16x160x16x32xi8>
  %scales = check.generate.fill value(1.0) : tensor<16x160x16xf32>
  %output = check.generate.fill value(0) : tensor<16x[%output_blocks]x16x32xi8>
  %output_scales = check.generate.fill value(0.0) : tensor<16x[%output_blocks]x16xf32>
  %expected = check.generate.fill value(127) : tensor<16x[%output_blocks]x16x32xi8>
  %expected_scales = check.generate.fill value(3381863936.0) : tensor<16x[%output_blocks]x16xf32>
  kernel.launch @qwen_q8_0_gate_up_swiglu_quantize_k5120_t128_bk2[%rows, %tokens](%rows, %tokens, %weight, %act, %scales, %output, %output_scales) : [index, index](index, index, tensor<[%weight_rows]x2720xf16>, tensor<16x160x16x32xi8>, tensor<16x160x16xf32>, tensor<16x[%output_blocks]x16x32xi8>, tensor<16x[%output_blocks]x16xf32>)
  check.expect.equal actual(%output) expected(%expected) : tensor<16x[%output_blocks]x16x32xi8>
  check.expect.close actual(%output_scales) expected(%expected_scales) atol(0.0) rtol(0.0) nan(same) : tensor<16x[%output_blocks]x16xf32>
  check.return
}

check.benchmark<@qwen_q8_0_gate_up_swiglu_quantize_k5120_t128_bk2_case> @qwen_q8_0_gate_up_swiglu_quantize_k5120_t128_bk2_benchmark
