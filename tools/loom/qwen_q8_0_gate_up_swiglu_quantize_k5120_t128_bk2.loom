// Gate/up blocked W8A8 projection with SwiGLU and Q8 quantization folded into
// its epilogue for the Qwen3.8 FFN.
//
// One 256-thread workgroup computes 64 gate rows, their 64 matching up rows,
// and 128 tokens. A wave owns two 16-row gate/up pairs by two 16-token tiles,
// keeping each gate and up result in the same lane. The epilogue applies
// SiLU(gate)*up, computes one scale per contiguous 32-row Q8 block, and writes
// only the payload and scale consumed by the down projection.
//
// Weight staging is the only thing that differs from the two-deep kernel.
// There, threads 0-127 each moved one 32-byte Q8 payload per K block, so a
// thread revisited its own row 34 bytes at a time with 127 other rows and a
// whole macro tile of matrix work in between; a 128-byte line was consumed
// across four rounds and evicted between them, and the first token group --
// the one with no reuse to ride -- streamed weights at 79 GB/s against a
// 241 GB/s ceiling. Here a thread stages blocks b+1..b+4 on every 4th
// block, so its 136 bytes are contiguous and issue in one request window.
// The stage is 5 blocks deep so the slot being read is never a refill
// target, which costs LDS (32256 bytes against 18432) and no registers.
//
// Activation staging is unchanged: its stride is 512 bytes, so consecutive
// rounds already share lines.
//
// weight : row-major Q8_0, 34 bytes per block (f16 scale then 32 i8)
// act    : [token tile][K block][token in tile][32 i8]
// scales : [token tile][K block][token in tile] f32
// output : [token tile][output Q8 block][token in tile][32 i8]
// out_scales : [token tile][output Q8 block][token in tile] f32

amdgpu.target<gfx11-generic> @qwen_q8_gate_up_swiglu_k5120_target_bk2 {subgroup_size = 32}

config.decl @qwen_q8_0_gate_up_swiglu_quantize_k5120_t128_bk2.row_capacity : %value: index where [range(%value, 64, 17408), mul(%value, 64)]

kernel.def target(@qwen_q8_gate_up_swiglu_k5120_target_bk2) @qwen_q8_0_gate_up_swiglu_quantize_k5120_t128_bk2(%rows: index, %tokens: index) {
  %rows_per_group = index.constant 64 : index
  %row_groups = index.div %rows, %rows_per_group : index
  %token_group_rounding = index.constant 127 : index
  %rounded_tokens = index.add %tokens, %token_group_rounding : index
  %tokens_per_group_cfg = index.constant 128 : index
  %token_groups = index.div %rounded_tokens, %tokens_per_group_cfg : index
  %one = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%token_groups, %row_groups, %one) workgroup_size(%workgroup_size, %one, %one) : index
} launch(%rows: index, %tokens: index, %weight: buffer, %act: buffer, %scales: buffer, %output: buffer, %out_scales: buffer) {
  %capacity = config.get @qwen_q8_0_gate_up_swiglu_quantize_k5120_t128_bk2.row_capacity : index
  %row_count = index.assume %rows [range(%rows, 64, 17408), le(%rows, %capacity), mul(%rows, 64)] : index
  %row_step = index.constant 1 : index
  %last_output_row = index.sub %row_count, %row_step : index
  %token_count = index.assume %tokens [range(%tokens, 1, 2048)] : index
  %base = index.constant 0 : offset
  %tid = kernel.workitem.id<x> : index
  // The token-tile index is the fastest-varying grid dimension so the token
  // tiles that share one row group's staged weights are co-resident and hit
  // cache instead of each re-reading the panel from DRAM.
  %token_group = kernel.workgroup.id<x> : index
  %row_group = kernel.workgroup.id<y> : index
  %wave_width = index.constant 32 : index
  %wave = index.div %tid, %wave_width : index
  %lane = index.rem %tid, %wave_width : index
  %token_tile_extent = index.constant 16 : index
  %token_tile_count = index.constant 8 : index
  %tokens_per_group = index.constant 128 : index
  %token_tiles_per_group = index.constant 8 : index
  %token_group_base = index.mul %token_group, %tokens_per_group : index
  %token_tile_group_base = index.mul %token_group, %token_tiles_per_group : index
  %lane_token = index.rem %lane, %token_tile_extent : index
  %row_parity = index.div %lane, %token_tile_extent : index
  %staged_rows_per_group = index.constant 128 : index
  %output_rows_per_group = index.constant 64 : index
  %row_base = index.mul %row_group, %output_rows_per_group : index
  %block_count = index.constant 160 : index
  %last_block = index.constant 159 : index
  %row_bytes = index.constant 5440 : index
  %q8_block_bytes = index.constant 34 : index
  %payload_header_bytes = index.constant 2 : index
  %block_payload = index.constant 32 : index
  %stage_depth = index.constant 5 : index
  %stage_pair = index.constant 4 : index
  %loop_begin = index.constant 0 : index
  %loop_step = index.constant 1 : index
  %two = index.constant 2 : index
  %one_byte = index.constant 1 : offset
  %scratch_bytes = index.constant 32256 : offset
  %act_scratch_offset = index.constant 20480 : offset
  %weight_scale_scratch_offset = index.constant 28672 : offset
  %act_scale_scratch_offset = index.constant 31232 : offset

  %lhs_layout = encoding.layout.strided [32, 1] : encoding<layout>
  %rhs_layout = encoding.layout.strided [1, 32] : encoding<layout>
  %i8_schema = encoding.define #encoding.operand<element_format=i8, payload_elements=16, payload_registers=4> : encoding<schema>
  %lhs_storage = encoding.define #encoding.storage {layout = %lhs_layout : encoding<layout>, schema = %i8_schema : encoding<schema>} : encoding<storage>
  %rhs_storage = encoding.define #encoding.storage {layout = %rhs_layout : encoding<layout>, schema = %i8_schema : encoding<schema>} : encoding<storage>

  %scratch = buffer.alloca<workgroup> align(16) %scratch_bytes : buffer
  %weight_stage_store = buffer.view %scratch[%base] : buffer -> view<5x128x32xi8>
  %act_stage_store = buffer.view %scratch[%act_scratch_offset] : buffer -> view<2x128x32xi8>
  %weight_scale_stage = buffer.view %scratch[%weight_scale_scratch_offset] : buffer -> view<5x8x16xf32>
  %act_scale_stage = buffer.view %scratch[%act_scale_scratch_offset] : buffer -> view<2x8x16xf32>
  %act_payload = buffer.view %act[%base] : buffer -> view<128x160x16x32xi8>
  %act_scale_input = buffer.view %scales[%base] : buffer -> view<128x160x16xf32>

  // Staging identity: the low half of the workgroup owns weight rows and
  // the high half owns tokens.
  %stage_is_act = index.cmp uge, %tid, %staged_rows_per_group : index
  %stage_slot = index.rem %tid, %staged_rows_per_group : index
  %stage_fragment = index.div %stage_slot, %token_tile_extent : index
  %stage_fragment_pair = index.div %stage_fragment, %two : index
  %stage_fragment_parity = index.rem %stage_fragment, %two : index
  %stage_row_in_fragment = index.rem %stage_slot, %token_tile_extent : index
  %stage_pair_base = index.mul %stage_fragment_pair, %token_tile_extent : index
  %stage_output_offset = index.add %stage_pair_base, %stage_row_in_fragment : index
  %stage_output_row0 = index.add %row_base, %stage_output_offset : index
  %stage_output_row = index.min %stage_output_row0, %last_output_row : index
  %stage_up_row = index.add %stage_output_row, %row_count : index
  %stage_is_up = index.cmp eq, %stage_fragment_parity, %row_step : index
  %stage_row = scf.select %stage_is_up, %stage_up_row, %stage_output_row : index
  %stage_row_bytes = index.mul %stage_row, %row_bytes : index
  %stage_payload_base = index.add %stage_row_bytes, %payload_header_bytes : index
  %stage_act_tile_local = index.div %stage_slot, %token_tile_extent : index
  %stage_act_tile = index.add %token_tile_group_base, %stage_act_tile_local : index
  %stage_act_lane = index.rem %stage_slot, %token_tile_extent : index
  %scale_row_tile = index.div %tid, %token_tile_extent : index
  %scale_row_lane = index.rem %tid, %token_tile_extent : index
  %scale_parity = index.rem %scale_row_lane, %two : index
  %scale_pair = index.div %scale_row_lane, %two : index
  %scale_parity_base = index.mul %scale_parity, %token_tile_count : index
  %scale_physical = index.add %scale_parity_base, %scale_pair : index
  %scale_weight_row_bytes = index.mul %stage_row, %row_bytes : index

  %zero_accumulator = vector.constant 0.0 : vector<8xf32>
  %zero_i32_elements = vector.constant 0 : vector<8xi32>

  %preload = scf.if %stage_is_act -> (vector<32xi8>) {
    %values = vector.load %act_payload[%stage_act_tile, %loop_begin, %stage_act_lane, %loop_begin] : view<128x160x16x32xi8> -> vector<32xi8>
    scf.yield %values : vector<32xi8>
  } else {
    %offset = index.scale %stage_payload_base, %one_byte : index, offset -> offset
    %view = buffer.view %weight[%offset] : buffer -> view<32xi8>
    %values = vector.load %view[%loop_begin] : view<32xi8> -> vector<32xi8>
    scf.yield %values : vector<32xi8>
  }

  %scale_loader_preload = index.cmp ult, %tid, %staged_rows_per_group : index
  %half_zero = index.constant 0 : index
  %half_one = index.constant 1 : index
  scf.if %stage_is_act {
    vector.store %preload, %act_stage_store[%half_zero, %stage_slot, %loop_begin] : vector<32xi8>, view<2x128x32xi8>
  } else {
    vector.store %preload, %weight_stage_store[%half_zero, %stage_slot, %loop_begin] : vector<32xi8>, view<5x128x32xi8>
  }
  scf.if %scale_loader_preload {
    %sbb_preload = index.mul %loop_begin, %q8_block_bytes : index
    %sbi_preload = index.add %scale_weight_row_bytes, %sbb_preload : index
    %sbo_preload = index.scale %sbi_preload, %one_byte : index, offset -> offset
    %sv_preload = buffer.view %weight[%sbo_preload] : buffer -> view<1xf16>
    %sf_preload = view.load %sv_preload[%loop_begin] : view<1xf16> -> f16
    %ws_preload = scalar.extf %sf_preload : f16 to f32
    view.store %ws_preload, %weight_scale_stage[%half_zero, %scale_row_tile, %scale_physical] : f32, view<5x8x16xf32>
    %ast_preload = index.add %token_tile_group_base, %scale_row_tile : index
    %as_preload = view.load %act_scale_input[%ast_preload, %loop_begin, %scale_row_lane] : view<128x160x16xf32> -> f32
    view.store %as_preload, %act_scale_stage[%half_zero, %scale_row_tile, %scale_row_lane] : f32, view<2x8x16xf32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  // Hoisted out of the K loop. The wave's row and token tile origins and
  // its LDS row addresses do not depend on the block index, but recomputing
  // them per iteration cost 33 address VALU ops per K block against 238
  // total, and the compiler kept rematerializing them rather than keeping
  // them live. Hoisting is free: peak registers stay at 184.
  %scale_loader_next = index.cmp ult, %tid, %staged_rows_per_group : index
  %four = index.constant 4 : index
  %wave_row_group = index.div %wave, %four : index
  %wave_token_group = index.rem %wave, %four : index
  %row_frag0 = index.mul %wave_row_group, %four : index
  %row_frag1 = index.add %row_frag0, %loop_step : index
  %row_frag2 = index.add %row_frag1, %loop_step : index
  %row_frag3 = index.add %row_frag2, %loop_step : index
  %token_tiles_per_wave = index.constant 2 : index
  %wave_token_tile_base = index.mul %wave_token_group, %token_tiles_per_wave : index
  %scale_vector_origin = index.mul %row_parity, %token_tile_count : index
  %lhs_row_origin0 = index.mul %row_frag0, %token_tile_extent : index
  %lhs_row0 = index.add %lhs_row_origin0, %lane_token : index
  %lhs_row_origin1 = index.mul %row_frag1, %token_tile_extent : index
  %lhs_row1 = index.add %lhs_row_origin1, %lane_token : index
  %lhs_row_origin2 = index.mul %row_frag2, %token_tile_extent : index
  %lhs_row2 = index.add %lhs_row_origin2, %lane_token : index
  %lhs_row_origin3 = index.mul %row_frag3, %token_tile_extent : index
  %lhs_row3 = index.add %lhs_row_origin3, %lane_token : index
  %tile_const0 = index.constant 0 : index
  %tt0 = index.add %wave_token_tile_base, %tile_const0 : index
  %rhs_origin0 = index.mul %tt0, %token_tile_extent : index
  %rhs_row0 = index.add %rhs_origin0, %lane_token : index
  %tile_const1 = index.constant 1 : index
  %tt1 = index.add %wave_token_tile_base, %tile_const1 : index
  %rhs_origin1 = index.mul %tt1, %token_tile_extent : index
  %rhs_row1 = index.add %rhs_origin1, %lane_token : index
  %acc0, %acc4, %acc1, %acc5, %acc2, %acc6, %acc3, %acc7 = scf.for %block = [%loop_begin to %block_count step %loop_step](%running0 = %zero_accumulator : vector<8xf32>, %running4 = %zero_accumulator : vector<8xf32>, %running1 = %zero_accumulator : vector<8xf32>, %running5 = %zero_accumulator : vector<8xf32>, %running2 = %zero_accumulator : vector<8xf32>, %running6 = %zero_accumulator : vector<8xf32>, %running3 = %zero_accumulator : vector<8xf32>, %running7 = %zero_accumulator : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {

    %parity = index.rem %block, %two : index
    %parity_next = index.sub %loop_step, %parity : index

    // Which of the 5 stage slots this round reads.
    %wslot = index.rem %block, %stage_depth : index

    // The stage slot follows the unclamped block index so the round that reads
    // it agrees; only the address is clamped.
    %next_block0 = index.add %block, %loop_step : index
    %next_block = index.min %next_block0, %last_block : index
    %stage_slot_a = index.rem %next_block0, %stage_depth : index
    %stage_span_2 = index.constant 2 : index
    %stage_block_b0 = index.add %block, %stage_span_2 : index
    %stage_block_b = index.min %stage_block_b0, %last_block : index
    %stage_slot_b = index.rem %stage_block_b0, %stage_depth : index
    %stage_span_3 = index.constant 3 : index
    %stage_block_c0 = index.add %block, %stage_span_3 : index
    %stage_block_c = index.min %stage_block_c0, %last_block : index
    %stage_slot_c = index.rem %stage_block_c0, %stage_depth : index
    %stage_span_4 = index.constant 4 : index
    %stage_block_d0 = index.add %block, %stage_span_4 : index
    %stage_block_d = index.min %stage_block_d0, %last_block : index
    %stage_slot_d = index.rem %stage_block_d0, %stage_depth : index
    %stage_phase = index.rem %block, %stage_pair : index
    %is_stage_round = index.cmp eq, %stage_phase, %loop_begin : index

    // Activations keep the two-deep ping-pong and one block per round.
    scf.if %stage_is_act {
      %act_staged = vector.load %act_payload[%stage_act_tile, %next_block, %stage_act_lane, %loop_begin] : view<128x160x16x32xi8> -> vector<32xi8>
      vector.store %act_staged, %act_stage_store[%parity_next, %stage_slot, %loop_begin] : vector<32xi8>, view<2x128x32xi8>
      %act_scale_next = view.load %act_scale_input[%stage_act_tile, %next_block, %stage_act_lane] : view<128x160x16xf32> -> f32
      view.store %act_scale_next, %act_scale_stage[%parity_next, %stage_act_tile_local, %stage_act_lane] : f32, view<2x8x16xf32>
    }
    // Weight staging: every 4th block, one thread takes the scale and the
    // payload of blocks b+1..b+4 of its own row back to back.
    scf.if %is_stage_round {
      scf.if %scale_loader_next {
        %ws_byte_a = index.mul %next_block, %q8_block_bytes : index
        %ws_index_a = index.add %scale_weight_row_bytes, %ws_byte_a : index
        %ws_offset_a = index.scale %ws_index_a, %one_byte : index, offset -> offset
        %ws_view_a = buffer.view %weight[%ws_offset_a] : buffer -> view<1xf16>
        %ws_half_a = view.load %ws_view_a[%loop_begin] : view<1xf16> -> f16
        %wp_index_a = index.add %stage_payload_base, %ws_byte_a : index
        %wp_offset_a = index.scale %wp_index_a, %one_byte : index, offset -> offset
        %wp_view_a = buffer.view %weight[%wp_offset_a] : buffer -> view<32xi8>
        %wp_a = vector.load %wp_view_a[%loop_begin] : view<32xi8> -> vector<32xi8>
        %ws_byte_b = index.mul %stage_block_b, %q8_block_bytes : index
        %ws_index_b = index.add %scale_weight_row_bytes, %ws_byte_b : index
        %ws_offset_b = index.scale %ws_index_b, %one_byte : index, offset -> offset
        %ws_view_b = buffer.view %weight[%ws_offset_b] : buffer -> view<1xf16>
        %ws_half_b = view.load %ws_view_b[%loop_begin] : view<1xf16> -> f16
        %wp_index_b = index.add %stage_payload_base, %ws_byte_b : index
        %wp_offset_b = index.scale %wp_index_b, %one_byte : index, offset -> offset
        %wp_view_b = buffer.view %weight[%wp_offset_b] : buffer -> view<32xi8>
        %wp_b = vector.load %wp_view_b[%loop_begin] : view<32xi8> -> vector<32xi8>
        %ws_byte_c = index.mul %stage_block_c, %q8_block_bytes : index
        %ws_index_c = index.add %scale_weight_row_bytes, %ws_byte_c : index
        %ws_offset_c = index.scale %ws_index_c, %one_byte : index, offset -> offset
        %ws_view_c = buffer.view %weight[%ws_offset_c] : buffer -> view<1xf16>
        %ws_half_c = view.load %ws_view_c[%loop_begin] : view<1xf16> -> f16
        %wp_index_c = index.add %stage_payload_base, %ws_byte_c : index
        %wp_offset_c = index.scale %wp_index_c, %one_byte : index, offset -> offset
        %wp_view_c = buffer.view %weight[%wp_offset_c] : buffer -> view<32xi8>
        %wp_c = vector.load %wp_view_c[%loop_begin] : view<32xi8> -> vector<32xi8>
        %ws_byte_d = index.mul %stage_block_d, %q8_block_bytes : index
        %ws_index_d = index.add %scale_weight_row_bytes, %ws_byte_d : index
        %ws_offset_d = index.scale %ws_index_d, %one_byte : index, offset -> offset
        %ws_view_d = buffer.view %weight[%ws_offset_d] : buffer -> view<1xf16>
        %ws_half_d = view.load %ws_view_d[%loop_begin] : view<1xf16> -> f16
        %wp_index_d = index.add %stage_payload_base, %ws_byte_d : index
        %wp_offset_d = index.scale %wp_index_d, %one_byte : index, offset -> offset
        %wp_view_d = buffer.view %weight[%wp_offset_d] : buffer -> view<32xi8>
        %wp_d = vector.load %wp_view_d[%loop_begin] : view<32xi8> -> vector<32xi8>
        %ws_f32_a = scalar.extf %ws_half_a : f16 to f32
        vector.store %wp_a, %weight_stage_store[%stage_slot_a, %stage_slot, %loop_begin] : vector<32xi8>, view<5x128x32xi8>
        view.store %ws_f32_a, %weight_scale_stage[%stage_slot_a, %scale_row_tile, %scale_physical] : f32, view<5x8x16xf32>
        %ws_f32_b = scalar.extf %ws_half_b : f16 to f32
        vector.store %wp_b, %weight_stage_store[%stage_slot_b, %stage_slot, %loop_begin] : vector<32xi8>, view<5x128x32xi8>
        view.store %ws_f32_b, %weight_scale_stage[%stage_slot_b, %scale_row_tile, %scale_physical] : f32, view<5x8x16xf32>
        %ws_f32_c = scalar.extf %ws_half_c : f16 to f32
        vector.store %wp_c, %weight_stage_store[%stage_slot_c, %stage_slot, %loop_begin] : vector<32xi8>, view<5x128x32xi8>
        view.store %ws_f32_c, %weight_scale_stage[%stage_slot_c, %scale_row_tile, %scale_physical] : f32, view<5x8x16xf32>
        %ws_f32_d = scalar.extf %ws_half_d : f16 to f32
