// ============================================================================
// Qwen3.8-27B Fused Down GEMV + Residual Add in Loom IR
// Computes:
//   out = residual + (down_w @ ffn_act)
// Intermediate Size N = 17408, Hidden Size K = 5120
// ============================================================================

func.def inline @bf16_dot32(%act: vector<32xf32>, %weight: vector<32xbf16>) -> (f32) {
  %sum_init = scalar.constant 0.0 : f32
  %w_f32 = vector.extf %weight : vector<32xbf16> to vector<32xf32>
  %prod = vector.mulf<reassoc|nnan|ninf|nsz> %act, %w_f32 : vector<32xf32>
  %sum = vector.reduce<addf, reassoc|nnan|ninf|nsz> %prod, %sum_init : vector<32xf32>, f32
  func.return %sum : f32
}

config.decl @qwen_fused_down_residual_bf16.hidden_dim : %value: index where [range(%value, 2, 5120), mul(%value, 2)]

kernel.def @qwen_fused_down_residual_bf16(%rows: index) {
  %row_block = index.constant 2 : index
  %hidden_dim = config.get @qwen_fused_down_residual_bf16.hidden_dim : index
  %row_tiles = index.div %hidden_dim, %row_block : index
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 544 : index
  kernel.launch.config workgroups(%row_tiles, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%rows: index, %ffn_act: buffer, %down_weight: buffer, %residual: buffer, %out: buffer) {
  %base = index.constant 0 : offset
  %hidden_dim = config.get @qwen_fused_down_residual_bf16.hidden_dim : index
  %row_count = index.assume %rows [range(%rows, 2, 5120), mul(%rows, 2), le(%rows, %hidden_dim)] : index
  %row_tile = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %row_block = index.constant 2 : index
  %row_offset_1 = index.constant 1 : index
  %vector_width = index.constant 32 : index
  %leader = index.constant 0 : index

  %row_base0 = index.madd %row_tile, %row_block, %leader : index
  %row_base = index.assume %row_base0 [mul(%row_base0, 2)] : index
  %row1_0 = index.add %row_base, %row_offset_1 : index
  %row_end = index.add %row_base, %row_block : index
  %row_tile_in_bounds = index.cmp ule, %row_end, %row_count : index

  scf.if %row_tile_in_bounds {
    %bounded_row0 = index.assume %row_base [lt(%row_base, %row_count)] : index
    %bounded_row1 = index.assume %row1_0 [lt(%row1_0, %row_count)] : index
    %act_base0 = index.mul %lane, %vector_width : index
    %act_base = index.assume %act_base0 [mul(%act_base0, 32)] : index

    %act_noalias, %weight_noalias, %res_noalias, %out_noalias = buffer.assume.noalias %ffn_act, %down_weight, %residual, %out : buffer, buffer, buffer, buffer
    %act_view = buffer.view %act_noalias[%base] : buffer -> view<17408xf32>
    %weight_view = buffer.view %weight_noalias[%base] : buffer -> view<[%row_count]x17408xbf16>
    %res_view = buffer.view %res_noalias[%base] : buffer -> view<[%row_count]xf32>
    %out_view = buffer.view %out_noalias[%base] : buffer -> view<[%row_count]xf32>

    %act_vec = vector.load %act_view[%act_base] : view<17408xf32> -> vector<32xf32>
    %w_vec0 = vector.load %weight_view[%bounded_row0, %act_base] : view<[%row_count]x17408xbf16> -> vector<32xbf16>
    %w_vec1 = vector.load %weight_view[%bounded_row1, %act_base] : view<[%row_count]x17408xbf16> -> vector<32xbf16>

    %sum0 = func.call @bf16_dot32(%act_vec, %w_vec0) : (vector<32xf32>, vector<32xbf16>) -> (f32)
    %dot0 = kernel.workgroup.reduce<addf> %sum0 : f32

    %sum1 = func.call @bf16_dot32(%act_vec, %w_vec1) : (vector<32xf32>, vector<32xbf16>) -> (f32)
    %dot1 = kernel.workgroup.reduce<addf> %sum1 : f32

    %is_leader = index.cmp eq, %lane, %leader : index
    scf.if %is_leader {
      %r0 = view.load %res_view[%bounded_row0] : view<[%row_count]xf32> -> f32
      %r1 = view.load %res_view[%bounded_row1] : view<[%row_count]xf32> -> f32
      %y0 = scalar.addf<reassoc|nnan|ninf|nsz> %dot0, %r0 : f32
      %y1 = scalar.addf<reassoc|nnan|ninf|nsz> %dot1, %r1 : f32
      view.store %y0, %out_view[%bounded_row0] : f32, view<[%row_count]xf32>
      view.store %y1, %out_view[%bounded_row1] : f32, view<[%row_count]xf32>
    }
  }
  kernel.return
}

check.case public @qwen_down_residual_case {
  %rows = check.param.choice values([2, 5120]) name("rows") : index
  %ffn_act = check.generate.fill value(0.0) : tensor<17408xf32>
  %down_weight = check.generate.fill value(0.0) : tensor<[%rows]x17408xbf16>
  %residual = check.generate.fill value(1.0) : tensor<[%rows]xf32>
  %out = check.generate.fill value(0.0) : tensor<[%rows]xf32>
  %expected = check.generate.fill value(1.0) : tensor<[%rows]xf32>

  kernel.launch @qwen_fused_down_residual_bf16[%rows](%rows, %ffn_act, %down_weight, %residual, %out) : [index](index, tensor<17408xf32>, tensor<[%rows]x17408xbf16>, tensor<[%rows]xf32>, tensor<[%rows]xf32>)
  check.expect.close actual(%out) expected(%expected) atol(0.0001) rtol(0.0001) nan(same) : tensor<[%rows]xf32>
  check.return
}

check.benchmark<@qwen_down_residual_case> @qwen_down_residual_decode {rows = 2}
check.benchmark<@qwen_down_residual_case> @qwen_down_residual_full {rows = 5120}
