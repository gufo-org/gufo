{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "STRIX_ENABLE_WARNINGS": "ON"
      }
    },
    {
      "name": "development",
      "displayName": "Development",
      "description": "CPU-only development build with debug information and warnings enabled",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "ENGINE_ENABLE_HIP": "OFF",
        "ENGINE_ENABLE_XRT": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "CPU-only optimized release build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "ENGINE_ENABLE_HIP": "OFF",
        "ENGINE_ENABLE_XRT": "OFF"
      }
    },
    {
      "name": "cpu-sanitizer",
      "displayName": "CPU Sanitizer",
      "description": "CPU-only build with AddressSanitizer and UndefinedBehaviorSanitizer enabled",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "STRIX_ENABLE_SANITIZERS": "ON",
        "ENGINE_ENABLE_HIP": "OFF",
        "ENGINE_ENABLE_XRT": "OFF"
      }
    },
    {
      "name": "cpu-test",
      "displayName": "CPU Tests",
      "description": "CPU-only build for running unit and smoke tests with CTest",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "ENGINE_ENABLE_HIP": "OFF",
        "ENGINE_ENABLE_XRT": "OFF"
      }
    },
    {
      "name": "gpu-test",
      "displayName": "gfx1151 GPU Tests",
      "description": "Build enabling ROCm/HIP for gfx1151 GPU without XRT",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "ENGINE_ENABLE_HIP": "ON",
        "ENGINE_ENABLE_XRT": "OFF",
        "GPU_TARGETS": "gfx1151"
      }
    },
    {
      "name": "hardware-test",
      "displayName": "gfx1151 and XDNA2 Hardware Tests",
      "description": "Build enabling the pinned HIP and XRT stacks for gfx1151 and XDNA2",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "ENGINE_ENABLE_HIP": "ON",
        "ENGINE_ENABLE_XRT": "ON",
        "GPU_TARGETS": "gfx1151"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "development",
      "displayName": "Development",
      "configurePreset": "development"
    },
    {
      "name": "release",
      "displayName": "Release",
      "configurePreset": "release"
    },
    {
      "name": "cpu-sanitizer",
      "displayName": "CPU Sanitizer",
      "configurePreset": "cpu-sanitizer"
    },
    {
      "name": "cpu-test",
      "displayName": "CPU Tests",
      "configurePreset": "cpu-test"
    },
    {
      "name": "gpu-test",
      "displayName": "gfx1151 GPU Tests",
      "configurePreset": "gpu-test"
    },
    {
      "name": "hardware-test",
      "displayName": "gfx1151 and XDNA2 Hardware Tests",
      "configurePreset": "hardware-test"
    }
  ],
  "testPresets": [
    {
      "name": "development",
      "displayName": "Development Tests",
      "configurePreset": "development",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cpu-sanitizer",
      "displayName": "CPU ASan and UBSan Tests",
      "configurePreset": "cpu-sanitizer",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cpu-test",
      "displayName": "CPU Tests",
      "configurePreset": "cpu-test",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "cpu"
        }
      }
    },
    {
      "name": "gpu-full",
      "displayName": "All gfx1151 GPU Tests",
      "configurePreset": "gpu-test",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "hardware-full",
      "displayName": "Complete gfx1151 and XDNA2 Test Suite",
      "configurePreset": "hardware-test",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "hardware-fast",
      "displayName": "Fast gfx1151 and XDNA2 Tests",
      "configurePreset": "hardware-test",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "slow|external-model"
        }
      }
    },
    {
      "name": "deepseek-gpu",
      "displayName": "DeepSeek V4 Flash GPU Model Tests",
      "configurePreset": "hardware-test",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "deepseek-v4-flash"
        }
      }
    },
    {
      "name": "qwen-gpu-kernel-oracle",
      "displayName": "Qwen Comprehensive GPU Kernel Oracle",
      "configurePreset": "gpu-test",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "qwen-kernel-oracle"
        }
      }
    },
    {
      "name": "xdna2-programs",
      "displayName": "XDNA2 Program Tests",
      "configurePreset": "hardware-test",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "xrt-hardware"
        }
      }
    }
  ]
}
