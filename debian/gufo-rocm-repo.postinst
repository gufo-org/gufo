#!/bin/sh
set -e

# Register the AMD ROCm apt repository used by Gufo.
#
# The ROCm libraries required by Gufo (hipblaslt, rocwmma and the HIP
# runtime) are not available in the Debian or Ubuntu repositories, so
# this package configures the upstream AMD repository. AMD publishes
# Ubuntu suites; Debian releases use the suite of the Ubuntu release
# they are compatible with (bookworm -> jammy, trixie -> noble).

. /etc/os-release

case "$ID" in
  debian)
    case "$VERSION_CODENAME" in
      bookworm) SUITE=jammy ;;
      *) SUITE=noble ;;
    esac
    ;;
  ubuntu)
    case "$VERSION_CODENAME" in
      jammy) SUITE=jammy ;;
      *) SUITE=noble ;;
    esac
    ;;
  *)
    SUITE=noble
    ;;
esac

mkdir -p /etc/apt/sources.list.d /etc/apt/preferences.d

cat > /etc/apt/sources.list.d/gufo-rocm.list <<EOF
deb [arch=amd64 signed-by=/usr/share/keyrings/rocm.gpg] https://repo.radeon.com/rocm/apt/7.2.4 ${SUITE} main
EOF

# Scope the pin to the ROCm package families, NOT `Package: *`. A wildcard at priority 600
# outranks the distribution's own 500 for EVERY package this repository happens to carry, and
# the suite here is Ubuntu noble on a Debian host -- so any future overlap (libssl, libcurl,
# libnuma, whatever AMD decides to mirror) would silently win over the distro package. The
# suite mapping itself is deliberate and documented above: ROCm publishes Ubuntu suites only.
#
# A pattern family per line, NOT one `Package:` line per glob. apt reads one `Package:` field per
# stanza, so a stanza carrying six of them is not six pins: the file installs, nothing complains,
# and the priority it asks for is simply never applied -- a guard that looks configured and is inert.
# Reproduce without writing to /etc:
#
#   d=$(mktemp -d); mkdir -p "$d/good/parts" "$d/bad/parts"
#   printf 'Package: hip* roc*\nPin: release o=repo.radeon.com\nPin-Priority: 600\n' >"$d/good/parts/p"
#   printf 'Package: hip*\nPackage: roc*\nPin: release o=repo.radeon.com\nPin-Priority: 600\n' >"$d/bad/parts/p"
#   for k in good bad; do apt-cache policy hipblaslt -o Dir::Etc::preferences=/dev/null \
#     -o Dir::Etc::preferencesparts="$d/$k/parts" | sed -n 5p; done
#
# good -> 600, bad -> 500 (the distro default, i.e. no pin). Note the option name is
# `Dir::Etc::preferencesparts` (`apt-config dump`); the hyphenated spelling loads nothing and makes
# both arms print 500, which reads as a result and is not one.
cat > /etc/apt/preferences.d/gufo-rocm-pin <<EOF
Package: hip* roc* rocm* rdc* *roctracer* *hsa*
Pin: release o=repo.radeon.com
Pin-Priority: 600
EOF

echo "gufo-rocm-repo: AMD ROCm repository registered (suite ${SUITE})."
echo "gufo-rocm-repo: run 'apt update' before installing gufo."

exit 0