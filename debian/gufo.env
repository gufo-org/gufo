# Gufo LLM server configuration.
#
# This file is the whole tuning surface. The service runs
# /usr/lib/gufo/gufo-launch.sh, which turns the variables below into command
# line flags; a variable left unset keeps the server's own default. Edit this
# file and run `systemctl restart gufo`. The unit file is never edited.
#
# Model weights live in a shared Hugging Face cache so that other
# LLM servers on this machine can reuse the same downloads. The cache
# is owned by the llm-servers group; add other service users to it,
# e.g. 'sudo usermod -a -G llm-servers <other-service-user>'. Download weights as
# the gufo user:
#
#   sudo -u gufo hf download <org>/<repo> <file>.gguf \
#     --revision <revision> --repo-type model
#
# then set GUFO_MODEL to the snapshot path inside the cache, e.g.
# /var/lib/huggingface/hub/models--<org>--<repo>/snapshots/<revision>/<file>.gguf
HF_HUB_CACHE=/var/lib/huggingface/hub

# --- required ---------------------------------------------------------------
GUFO_MODEL=/var/lib/huggingface/hub/models--<org>--<repo>/snapshots/<revision>/<model>.gguf

# --- listener ---------------------------------------------------------------
GUFO_BIND=0.0.0.0
GUFO_PORT=8080

# --- capacity ---------------------------------------------------------------
# Context tokens per session (-c). Long agent sessions are the usual workload
# for the models this package serves, so this is the memory knob that matters
# most: KV scales linearly with it, and every token of headroom here is taken
# from the RAM left for cache retention.
GUFO_CONTEXT=131072
# Preallocated GPU request sessions (-j). Each session holds its own KV.
GUFO_SESSIONS=2

# --- speculative decoding ---------------------------------------------------
# GUFO_SPECULATIVE: off | dflash2 | mtp
#
#   dflash2  needs GUFO_DFLASH_MODEL (a separate draft GGUF). Fastest for
#            long prompts: prefill is untouched and decode gains ~45%.
#   mtp      needs GUFO_MTP_MODEL (the same GGUF as the target, it carries
#            the nextn block). Best acceptance and the fastest on short
#            prompts, but the draft is primed with one forward per prompt
#            token, which roughly quadruples time-to-first-token on long
#            prompts. Do not enable the disk cache with it.
#
# On Qwen3.6-35B-A3B at 131072 context with a 68811-token prompt:
#   off       prefill 1786 t/s  TTFT  39 s  decode 30.9 t/s
#   dflash2   prefill 1727 t/s  TTFT  39 s  decode 44.7 t/s  accept 71.9%
#   mtp       prefill  433 t/s  TTFT 159 s  decode 37.4 t/s  accept 92.1%
GUFO_SPECULATIVE=dflash2
GUFO_DFLASH_MODEL=
GUFO_MTP_MODEL=
# Draft tokens evaluated per step (-d). 3 suits prose, 7 suits code.
GUFO_DRAFT_TOKENS=3
# fixed keeps the block length constant; adaptive lets the draft shrink when
# acceptance falls. fixed is faster for prose.
GUFO_DRAFT_POLICY=fixed
GUFO_MIN_DRAFT_TOKENS=1

# --- caching --------------------------------------------------------------
# Continuation cache; leave the directory unset to keep caching off.
GUFO_CACHE_DISK_DIR=
GUFO_CACHE_DISK_BYTES=
GUFO_CACHE_DISK_STAGING_BYTES=
GUFO_CACHE_RAM_BYTES=
# N-gram row cache for models that use a PLE/gather path. Beyond a few MiB it
# has no measurable effect on long-context decode - larger budgets up to 4 GiB,
# and even a deliberately crippled one, stay within noise - so this is a knob to
# leave at the server default unless the gather path itself changes.
GUFO_NGRAM_CACHE_BYTES=

# --- scheduling / logging -------------------------------------------------
# Prompt tokens between active decode rounds. Larger batches prefill faster
# and make waiting decode requests wait longer.
GUFO_PREFILL_CHUNK=
GUFO_MAX_TOKENS=
GUFO_LOG_LEVEL=info

# Escape hatch for flags this launcher does not know yet. Word-split, so
# values must not contain spaces.
GUFO_EXTRA_ARGS=
