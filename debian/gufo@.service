[Unit]
# Instantiated gufo text server. One unit file, many configurations:
# every tunable lives in an EnvironmentFile, so switching model, speculative
# backend, draft length, context, sessions or cache never edits a unit file.
#
#   systemctl enable --now gufo@<name>          # /etc/gufo/instance.d/<name>.env
#   systemctl enable --now gufo@<another-name>  # a second server, on another port
#
# Load ceiling: a large model stays resident for the life of the instance, so
# capacity is a per-host budget, not a per-unit one - read the device usage the
# service reports before starting a second one. Two large instances on one
# machine starve each other, and an orphaned instance that crash-loops reloads a
# model of its size on every retry until the box swaps, so run at most one large
# instance per host and give every instance its own port and its own private
# cache directory. The disk cache guard rejects a cache directory not owned by
# the service user, hence instance dirs are created by the launcher, which runs
# as that user.
Description=Gufo Strix Halo inference server (instance %i)
Documentation=https://github.com/gufo-org/gufo
After=network-online.target
Wants=network-online.target
# A crash loop must not become an infinite reload of a ~100 GiB model. These
# are [Unit] keys: in [Service] systemd ignores them (systemd-analyze verify).
StartLimitIntervalSec=600
StartLimitBurst=5
# Shares port 8080 with the classic unit (same launcher, same env file, same default port),
# so the two must never be active together.
Conflicts=gufo.service

[Service]
Type=simple
User=gufo
Group=llm-servers
WorkingDirectory=/var/lib/gufo
# Shared defaults first, then the instance file so the instance wins.
Environment=GUFO_INSTANCE=%i
EnvironmentFile=-/etc/gufo/gufo.env
EnvironmentFile=-/etc/gufo/instance.d/%i.env
ExecStart=/usr/lib/gufo/gufo-launch.sh
LimitMEMLOCK=infinity
# systemd's default start timeout (90 s) is inside the measured cold-load range of this
# model on this hardware (25 s warm to 74 s); pin it above the worst case so a slow load is
# not killed mid-way. See DEPLOYMENT.md for the load_completed figures.
TimeoutStartSec=900
Restart=on-failure
RestartSec=5

# Filesystem hardening, derived from what this service actually touches (measured 2026-10-20, not
# copied from a template): the process holds fds only under /var/lib/huggingface (read-only mmaps of
# the weights) and /var/lib/gufo/cache/instances/<instance> (the disk cache the launcher mkdirs). No
# /home path appears in any shipped env file, no /tmp use in the launcher, nothing writes under /usr.
# So: /usr and /boot read-only, home invisible, a private /tmp, and one explicit write path.
# Deliberately NOT set here: ProtectSystem=strict, ProtectKernelTunables and NoNewPrivileges. Three
# source files read /sys for device information and the ROCm device path (kfd/dri) has not been proven
# under a read-only /sys or a no-new-privileges domain; a hardened unit that fails at start costs a
# full model reload, which is a larger outage than the exposure those knobs remove. Widen them only
# with a cold start and a real completion measured under each one.
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/gufo


[Install]
WantedBy=multi-user.target
