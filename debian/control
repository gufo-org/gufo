Build-Depends: debhelper-compat (= 13), cmake (>= 3.21), ninja-build,
 pkg-config, libicu-dev, libcurl4-openssl-dev, libssl-dev, libpng-dev,
 libjpeg-dev, libwebp-dev, hipblas-dev, hipblaslt-dev, rocblas-dev,
 hipcub-dev, rocprim-dev, rocwmma-dev
Standards-Version: 4.7.0
Homepage: https://github.com/gufo-org/gufo
Rules-Requires-Root: no

Package: gufo
Architecture: amd64
Depends: gufo-rocm-repo (>= 0.3.0),
 hipblas (>= 3.2.0.70204), hipblaslt (>= 1.2.2.70204),
 rocblas (>= 5.2.0.70204), hip-runtime-amd (>= 7.2.53211.70203),
 adduser, ffmpeg, ${shlibs:Depends}, ${misc:Depends}
Description: Strix Halo inference engine
 Gufo is a vertical local inference engine built specifically for AMD
 Strix Halo hardware (Ryzen AI MAX+ 395, gfx1151), serving text, audio,
 image and video models through an OpenAI-compatible API.
 .
 The ROCm runtime libraries are provided by the gufo-rocm-repo package,
 which registers the AMD ROCm apt repository.

Package: gufo-rocm-repo
Architecture: all
Depends: ca-certificates, ${misc:Depends}
Description: AMD ROCm apt repository for Gufo
 Registers the AMD ROCm 7.2.x apt repository and its signing key so that
 the ROCm runtime libraries required by Gufo can be installed with apt.
 .
 The ROCm libraries are not available in the Debian and Ubuntu
 repositories, so this package configures the upstream AMD repository.