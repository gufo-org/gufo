{
  "schema": 1,
  "name": "qwen",
  "version": "0.1.0",
  "api_version": ">= 0.3.0",
  "entry": "qwen_register",
  "registration_target": "gufo_qwen",
  "depends": [],
  "platforms": [
    "linux",
    "windows"
  ],
  "providers": [
    {
      "id": "qwen27-q4",
      "capability": "text_generation",
      "keys": [
        "gguf:qwen27"
      ],
      "model_ids": [
        "qwen27"
      ],
      "speculative": [
        "dflash2"
      ],
      "target": "gufo_qwen_hip",
      "entry": "qwen_provider_register",
      "serving": {
        "draft_options": {
          "dflash2": "--dflash-model"
        }
      }
    }
  ],
  "models": [
    {
      "id": "qwen27-q4",
      "provider": "qwen27-q4",
      "license": "apache-2.0",
      "description": "Qwen3.8 27B, UD-Q4_K_XL GGUF",
      "components": [
        {
          "role": "weights",
          "option": "--model",
          "install": "required",
          "source": {
            "hf": "unsloth/Qwen3.8-27B-GGUF",
            "revision": "ce331efc48d5722b4b8041f72793e530eae18d9b"
          },
          "include": [
            "Qwen3.8-27B-UD-Q4_K_XL.gguf"
          ]
        },
        {
          "role": "dflash",
          "option": "--dflash-model",
          "install": "default",
          "source": {
            "hf": "z-lab/Qwen3.8-27B-DFlash2-GGUF",
            "revision": "2d9571f8ce46e151f61c6499c99dee6079e1d610"
          },
          "include": [
            "Qwen3.8-27B-DFlash2-Q4_K_M.gguf"
          ]
        },
        {
          "role": "mmproj",
          "option": "--mmproj",
          "install": "default",
          "source": {
            "hf": "unsloth/Qwen3.8-27B-GGUF",
            "revision": "ce331efc48d5722b4b8041f72793e530eae18d9b"
          },
          "include": [
            "mmproj-BF16.gguf"
          ]
        }
      ]
    },
    {
      "id": "qwen27-q8",
      "provider": "qwen27-q4",
      "license": "apache-2.0",
      "description": "Qwen3.8 27B, UD-Q8_K_XL GGUF",
      "components": [
        {
          "role": "weights",
          "option": "--model",
          "install": "required",
          "source": {
            "hf": "unsloth/Qwen3.8-27B-GGUF",
            "revision": "ce331efc48d5722b4b8041f72793e530eae18d9b"
          },
          "include": [
            "Qwen3.8-27B-UD-Q8_K_XL.gguf"
          ]
        },
        {
          "role": "dflash",
          "option": "--dflash-model",
          "install": "default",
          "source": {
            "hf": "z-lab/Qwen3.8-27B-DFlash2-GGUF",
            "revision": "2d9571f8ce46e151f61c6499c99dee6079e1d610"
          },
          "include": [
            "Qwen3.8-27B-DFlash2-Q4_K_M.gguf"
          ]
        },
        {
          "role": "mmproj",
          "option": "--mmproj",
          "install": "default",
          "source": {
            "hf": "unsloth/Qwen3.8-27B-GGUF",
            "revision": "ce331efc48d5722b4b8041f72793e530eae18d9b"
          },
          "include": [
            "mmproj-BF16.gguf"
          ]
        }
      ]
    }
  ],
  "options": [
    {
      "name": "--dflash-model",
      "type": "path",
      "commands": [
        "serve",
        "bench",
        "prompt"
      ],
      "providers": [
        "qwen27-q4"
      ],
      "help": "DFlash2 draft model path for speculative decoding"
    }
  ],
  "targets": {
    "gufo_qwen": {
      "requires": []
    },
    "gufo_qwen_hip": {
      "requires": [
        "hip"
      ]
    }
  },
  "production_paths": {
    "include": [
      "**/*.cpp",
      "**/*.h",
      "**/*.hpp",
      "**/*.hip",
      "extension.*",
      "models.lock.json"
    ],
    "exclude": [
      "tests/",
      "functional/",
      "tools/",
      "fixtures/"
    ]
  },
  "docs": {
    "title": "Qwen3.8 27B",
    "inputs": "Q4/Q8 GGUF; text/images",
    "guide": "docs/models/qwen3.8-27b.md"
  },
  "tests": [
    {
      "target": "qwen_tokenizer_test",
      "ctest": "qwen_tokenizer_test",
      "check_pr": true,
      "windows_build": true
    },
    {
      "target": "qwen_chat_template_test",
      "ctest": "qwen_chat_template_test",
      "check_pr": true,
      "windows_build": true
    },
    {
      "target": "qwen27b_continuation_identity_test",
      "ctest": "qwen27b_continuation_identity_test",
      "check_pr": true,
      "windows_build": true
    },
    {
      "target": "qwen27b_continuation_layout_test",
      "ctest": "qwen27b_continuation_layout_test",
      "check_pr": true,
      "windows_build": true
    },
    {
      "target": "qwen27b_prefill_groups_test",
      "ctest": "qwen27b_prefill_groups_test",
      "check_pr": true,
      "windows_build": true
    }
  ],
  "test_labels": [
    "qwen27b"
  ],
  "fixtures": "tests/models/qwen27b/fixtures/",
  "functional": "functional/"
}
